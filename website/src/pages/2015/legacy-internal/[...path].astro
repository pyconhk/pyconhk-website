---
import BareMicrositePage2015 from '@/years/2015/components/BareMicrositePage2015.astro';
import { legacy2015Pages } from '@/years/2015/data/pages';
import routeContract from '@/years/2015/data/routes.json';
import type { Legacy2015Page } from '@/years/2015/data/types';

interface Props {
  page: Legacy2015Page;
}

export function getStaticPaths() {
  const pageByRoute = new Map(legacy2015Pages.map((page) => [page.route, page]));

  return routeContract.internalRouteRewrites.map(({ from, to }) => {
    const page = pageByRoute.get(from);

    if (!page) {
      throw new Error(`Missing 2015 page for internal rewrite ${from}`);
    }

    return {
      params: {
        path: to.replace(/^\/2015\/legacy-internal\//u, '').replace(/\/$/u, ''),
      },
      props: { page },
    };
  });
}

const { page } = Astro.props;
---

<BareMicrositePage2015 page={page} />
