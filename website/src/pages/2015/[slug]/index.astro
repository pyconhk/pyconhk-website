---
import LegacyHighlightPage from '@/legacy/LegacyHighlightPage.astro';
import { getHighlightsForEdition } from '@/legacy/year-highlights';

export function getStaticPaths() {
  const highlights = getHighlightsForEdition('2015');

  return highlights.map((highlight) => ({
    params: { slug: highlight.slug },
    props: { page: highlight.page },
  }));
}

const { page } = Astro.props;
---

<LegacyHighlightPage page={page} />
