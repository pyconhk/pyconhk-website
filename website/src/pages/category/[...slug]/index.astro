---
import LegacyArchivePage from '@/legacy/LegacyArchivePage.astro';
import { legacyArchives } from '@/legacy/legacy-indexes';

export function getStaticPaths() {
  return legacyArchives
    .filter((page) => page.type === 'category')
    .map((page) => ({
      params: {
        slug: page.path.replace(/^\/category\//u, '').replace(/\/$/u, ''),
      },
      props: { page },
    }));
}

const { page } = Astro.props;
---

<LegacyArchivePage page={page} />
