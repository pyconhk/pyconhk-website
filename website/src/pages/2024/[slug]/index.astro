---
import { archiveMonthsForYear } from '@/legacy/archive-months';
import LegacyHighlightPage from '@/legacy/LegacyHighlightPage.astro';
import LegacyVoyagoYearArchivePage from '@/legacy/LegacyVoyagoYearArchivePage.astro';
import { getLegacyArchiveMonth } from '@/legacy/legacy-year-archives';
import { getHighlightsForEdition } from '@/legacy/year-highlights';
import Legacy2024Page from '@/years/2024/components/Legacy2024Page.astro';
import { legacy2024Pages } from '@/years/2024/data/pages';

export function getStaticPaths() {
  const highlights = getHighlightsForEdition('2024');

  return [
    ...legacy2024Pages.map((page) => ({
      params: { slug: page.slug },
      props: { archivePage: page },
    })),
    ...highlights.map((highlight) => ({
      params: { slug: highlight.slug },
      props: { highlightPage: highlight.page },
    })),
    ...archiveMonthsForYear('2024').map((archiveMonth) => ({
      params: { slug: archiveMonth.month },
      props: {
        monthArchiveLabel: archiveMonth.label,
        monthArchivePage: getLegacyArchiveMonth(archiveMonth.year, archiveMonth.month),
      },
    })),
  ];
}

const { archivePage, highlightPage, monthArchiveLabel, monthArchivePage } = Astro.props;
---

{
  monthArchivePage ? (
    <LegacyVoyagoYearArchivePage
      page={monthArchivePage}
      year="2024"
      label={monthArchiveLabel}
    />
  ) : highlightPage ? (
    <LegacyHighlightPage page={highlightPage} />
  ) : (
    <Legacy2024Page page={archivePage} />
  )
}
