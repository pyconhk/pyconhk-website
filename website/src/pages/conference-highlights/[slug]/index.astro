---
import LegacyHighlightPage from '@/legacy/LegacyHighlightPage.astro';
import { legacyHighlights } from '@/legacy/legacy-indexes';
import { isMigratedTopLevelRoute } from '@/legacy/migrated-routes';

export function getStaticPaths() {
  return legacyHighlights
    .filter((page) => !isMigratedTopLevelRoute(page.path))
    .map((page) => ({
      params: { slug: page.slug },
      props: { page },
    }));
}

const { page } = Astro.props;
---

<LegacyHighlightPage page={page} />
