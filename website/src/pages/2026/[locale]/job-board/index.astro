---
import CommunityActivityPage from '@/years/2026/components/pages/CommunityActivityPage.astro';
import { resolveCfpLocale, supportedLocales } from '@/years/2026/locales';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const locale = resolveCfpLocale(Astro.params.locale);
---

<CommunityActivityPage locale={locale} activity="job-board" />
