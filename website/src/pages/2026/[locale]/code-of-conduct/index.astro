---
import CodeOfConductPage from '@/years/2026/components/pages/CodeOfConductPage.astro';
import { resolveCfpLocale, supportedLocales } from '@/years/2026/data/cfp';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({
    params: { locale },
  }));
}

const locale = resolveCfpLocale(Astro.params.locale);
---

<CodeOfConductPage locale={locale} />
