---
import { resolveCfpLocale, supportedLocales } from '@/years/2026/data/cfp';
import CfpPrivacyPolicyPage from '@/years/2026/routes/CfpPrivacyPolicyPage.astro';

export function getStaticPaths() {
  return [...supportedLocales, 'zh-cn'].map((locale) => ({
    params: { locale },
  }));
}

const locale =
  Astro.params.locale === 'zh-cn' ? 'zh-hans' : resolveCfpLocale(Astro.params.locale);
---

<CfpPrivacyPolicyPage locale={locale} />
