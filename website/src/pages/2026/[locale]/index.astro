---
import {
  resolveCfpLocale,
  supportedLocales,
} from '@/years/2026/data/cfp';
import HomePage from '@/years/2026/routes/HomePage.astro';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({
    params: { locale },
  }));
}

const locale = resolveCfpLocale(Astro.params.locale);
---

<HomePage locale={locale} />
