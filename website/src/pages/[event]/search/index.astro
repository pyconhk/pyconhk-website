---
import LegacySearchPage from '@/legacy/LegacySearchPage.astro';
import Legacy2024Page from '@/years/2024/components/Legacy2024Page.astro';
import { legacy2024SearchPage } from '@/years/2024/data/snapshots';

export function getStaticPaths() {
  const events = [
    '2015',
    '2016',
    '2017',
    '2018',
    '2020',
    '2020-spring',
    '2020-fall',
    '2021',
    '2022',
    '2023',
    '2024',
    '2025',
    '2026',
  ];

  return events.map((event) => ({
    params: { event },
    props: { event },
  }));
}

const { event } = Astro.props;
---

{
  event === '2024' ? (
    <Legacy2024Page page={legacy2024SearchPage} search />
  ) : (
    <LegacySearchPage event={event} />
  )
}
