---
import LegacyHighlightPage from '@/legacy/LegacyHighlightPage.astro';
import { getHighlightsForEdition } from '@/legacy/year-highlights';
import LegacyArchiveLayout from '@/years/2018/components/LegacyArchiveLayout.astro';
import { legacyArchivePages } from '@/years/2020-spring/data/pages';

export function getStaticPaths() {
  const highlights = getHighlightsForEdition('2020-spring');

  return [
    ...legacyArchivePages.map((page) => ({
      params: { slug: page.slug },
      props: { archivePage: page },
    })),
    ...highlights.map((highlight) => ({
      params: { slug: highlight.slug },
      props: { highlightPage: highlight.page },
    })),
  ];
}

const { archivePage, highlightPage } = Astro.props;
---

{
  highlightPage ? (
    <LegacyHighlightPage page={highlightPage} />
  ) : (
    <LegacyArchiveLayout
      editionLabel="PyCon HK 2020 Spring"
      pages={legacyArchivePages}
      page={archivePage}
    />
  )
}
