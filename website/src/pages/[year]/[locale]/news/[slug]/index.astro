---
import { locales, type SiteYear } from '@/config/site';
import { getAvailablePostYears, getPublishedPostSlugs } from '@/lib/news';
import { resolveLocaleParam } from '@/lib/routing';
import NewsArticlePage from '@/years/2025/routes/NewsArticlePage.astro';
import { conferenceYear } from '@/years/2025/site';

export async function getStaticPaths() {
  const years = (await getAvailablePostYears()).filter((year) => year !== conferenceYear);
  const pathsByYear = await Promise.all(
    years.map(async (year) => {
      const slugs = await getPublishedPostSlugs(year);

      return locales.flatMap((locale) =>
        slugs.map((slug) => ({
          params: {
            year: String(year),
            locale: locale.code,
            slug,
          },
        }))
      );
    })
  );

  return pathsByYear.flat();
}

const parsedYear = Number.parseInt(Astro.params.year ?? '', 10);
const year = parsedYear as SiteYear;
const locale = resolveLocaleParam(Astro.params.locale);
const slug = Astro.params.slug || '';
---

<NewsArticlePage year={year} locale={locale} slug={slug} />
