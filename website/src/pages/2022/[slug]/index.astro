---
import { archiveMonthsForYear } from '@/legacy/archive-months';
import LegacyHighlightPage from '@/legacy/LegacyHighlightPage.astro';
import LegacyYearArchivePage from '@/legacy/LegacyYearArchivePage.astro';
import { getLegacyArchiveMonth } from '@/legacy/legacy-year-archives';
import { getHighlightsForEdition } from '@/legacy/year-highlights';
import Legacy2022Page from '@/years/2022/components/Legacy2022Page.astro';
import { legacy2022Pages } from '@/years/2022/data/pages';

export function getStaticPaths() {
  const editionPrefix = '/2022/';
  const archivePaths = legacy2022Pages
    .filter(
      (page) =>
        page.route.startsWith(editionPrefix) &&
        page.route !== editionPrefix &&
        !page.route.startsWith(`${editionPrefix}page/`)
    )
    .map((page) => ({
      params: {
        slug: decodeURI(page.route.replace(editionPrefix, '').replace(/\/$/u, '')),
      },
      props: { page },
    }));
  const archiveSlugs = new Set(archivePaths.map((path) => path.params.slug));
  const highlights = getHighlightsForEdition('2022');

  return [
    ...archivePaths,
    ...highlights
      .filter((highlight) => !archiveSlugs.has(highlight.slug))
      .map((highlight) => ({
        params: { slug: highlight.slug },
        props: { highlightPage: highlight.page },
      })),
    ...archiveMonthsForYear('2022').map((archiveMonth) => ({
      params: { slug: archiveMonth.month },
      props: {
        monthArchiveLabel: archiveMonth.label,
        monthArchivePage: getLegacyArchiveMonth(archiveMonth.year, archiveMonth.month),
      },
    })),
  ];
}

const { page, highlightPage, monthArchiveLabel, monthArchivePage } = Astro.props;
---

{
  monthArchivePage ? (
    <LegacyYearArchivePage
      headingKind="Month"
      label={monthArchiveLabel}
      page={monthArchivePage}
      year="2022"
    />
  ) : highlightPage ? (
    <LegacyHighlightPage page={highlightPage} />
  ) : (
    <Legacy2022Page page={page} />
  )
}
