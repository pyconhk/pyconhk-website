---
import LegacyHighlightPage from '@/legacy/LegacyHighlightPage.astro';
import { cleanLegacyHtml, cleanLegacyText } from '@/legacy/legacy-html';
import { getHighlightsForEdition } from '@/legacy/year-highlights';
import LegacyArchiveShell from '@/years/2022/components/LegacyArchiveShell.astro';
import archive from '@/years/2022/data/archive.json';

export function getStaticPaths() {
  const highlights = getHighlightsForEdition('2022');

  return [
    ...archive.pages.map((page) => ({
      params: { slug: page.slug },
      props: { archivePage: page },
    })),
    ...highlights.map((highlight) => ({
      params: { slug: highlight.slug },
      props: { highlightPage: highlight.page },
    })),
  ];
}

const { archivePage, highlightPage } = Astro.props;
const displayArchivePage = archivePage
  ? {
      ...archivePage,
      contentHtml: cleanLegacyHtml(archivePage.contentHtml),
      description: cleanLegacyText(archivePage.description),
    }
  : undefined;
---

{
  highlightPage ? (
    <LegacyHighlightPage page={highlightPage} />
  ) : displayArchivePage ? (
    <LegacyArchiveShell
      title={displayArchivePage.title}
      description={displayArchivePage.description}
      year={archive.year}
      currentPath={displayArchivePage.url}
    >
      <article class="legacy-container">
        <p class="legacy-kicker">PyCon Hong Kong {archive.year}</p>
        <h1 class="legacy-title">{displayArchivePage.title}</h1>
        {displayArchivePage.date?.label && <p class="legacy-date">{displayArchivePage.date.label}</p>}
        {displayArchivePage.featuredImage?.src && (
          <figure class="legacy-hero">
            <img src={displayArchivePage.featuredImage.src} alt={displayArchivePage.featuredImage.alt || ''} />
          </figure>
        )}
        <div class="legacy-panel">
          <div class="legacy-content" set:html={displayArchivePage.contentHtml} />
        </div>
      </article>
    </LegacyArchiveShell>
  ) : (
    <p>Archive page not found.</p>
  )
}
