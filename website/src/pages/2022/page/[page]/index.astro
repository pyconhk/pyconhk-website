---
import LegacyYearArchivePage from '@/legacy/LegacyYearArchivePage.astro';
import {
  getLegacyYearArchive,
  getLegacyYearArchivePageNumbers,
} from '@/legacy/legacy-year-archives';

const year = '2022';

export function getStaticPaths() {
  return getLegacyYearArchivePageNumbers('2022').map((pageNumber) => ({
    params: { page: String(pageNumber) },
    props: { page: getLegacyYearArchive('2022', pageNumber) },
  }));
}

const { page } = Astro.props;
---

<LegacyYearArchivePage year={year} page={page} />
