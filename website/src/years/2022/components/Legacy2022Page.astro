---
import {
  decodeCloudflareProtectedEmails,
  stripCloudflareChallengeScripts,
} from '@/legacy/cloudflare-email';
import { repairLegacyWordPressHistoryLinks } from '@/legacy/conference-archive-links';
import { prepareLegacySearchableHtml } from '@/legacy/legacy-html';
import { resolveLegacy2020HtmlAssets } from '@/years/2020/data/assets';
import type { Legacy2022Page } from '@/years/2022/data/types';

interface Props {
  page: Legacy2022Page;
}

const { page } = Astro.props;

const legacy2022LayoutFixes = `<style id="legacy-2022-layout-fixes">
body.wp-theme-marketingly .entry-content a {
  overflow-wrap: anywhere;
  word-break: break-word;
}
</style>`;

function injectLegacy2022LayoutFixes(html: string): string {
  return html.replace('</head>', `${legacy2022LayoutFixes}</head>`);
}

function repairLegacy2022Routes(html: string): string {
  return html
    .replace(/(["'])\/2022\/page\/1\/\1/gu, '$1/2022/$1')
    .replace(
      /(["'])\/conference-highlights\/pycon-hk-2022-photos\/\1/gu,
      '$1/2022/photos/$1'
    );
}

const html = injectLegacy2022LayoutFixes(
  prepareLegacySearchableHtml(
    resolveLegacy2020HtmlAssets(
      stripCloudflareChallengeScripts(
        repairLegacy2022Routes(
          decodeCloudflareProtectedEmails(repairLegacyWordPressHistoryLinks(page.fullHtml))
        )
      ),
      '2022'
    ),
    {
      route: page.route,
      title: page.title,
    }
  )
);
---

<Fragment set:html={html} />
