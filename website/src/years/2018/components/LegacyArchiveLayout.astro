---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { cleanLegacyHtml, cleanLegacyText } from '@/legacy/legacy-html';
import type { LegacyArchivePage } from '@/years/2018/data/pages';

interface Props {
  editionLabel: string;
  pages: LegacyArchivePage[];
  page?: LegacyArchivePage;
}

const { editionLabel, pages, page } = Astro.props;
const displayPages = pages.map((archivePage) => ({
  ...archivePage,
  description: cleanLegacyText(archivePage.description),
  excerpt: cleanLegacyText(archivePage.excerpt),
  html: cleanLegacyHtml(archivePage.html),
}));
const currentPage = page
  ? {
      ...page,
      description: cleanLegacyText(page.description),
      excerpt: cleanLegacyText(page.excerpt),
      html: cleanLegacyHtml(page.html),
    }
  : undefined;
const pageTitle = currentPage ? `${currentPage.title} - ${editionLabel}` : `${editionLabel} Archive`;
const description = currentPage?.description || `Archived pages from ${editionLabel}.`;
const activeYear = currentPage?.year ?? displayPages[0]?.year;
const primaryLinks = [
  { href: '/2018/', label: '2018' },
  { href: '/2020-spring/', label: '2020 Spring' },
  { href: '/2020-fall/', label: '2020 Fall' },
  { href: '/2021/', label: '2021' },
];
const pageDate = page?.date
  ? new Intl.DateTimeFormat('en-HK', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'Asia/Hong_Kong',
    }).format(new Date(page.date))
  : '';
---

<BaseLayout title={pageTitle} description={description}>
  <main class="min-h-screen bg-slate-50 text-slate-800">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-8 md:px-8">
        <a class="font-display text-lg font-bold text-brand-blue-dark" href="/">PyCon HK</a>
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-sm font-semibold uppercase text-brand-blue-dark">Archive</p>
            <h1 class="mt-2 max-w-4xl font-display text-3xl font-bold text-ink md:text-5xl">
              {currentPage?.title ?? editionLabel}
            </h1>
            {pageDate && <p class="mt-3 text-sm text-muted">{pageDate}</p>}
          </div>
          <nav class="flex flex-wrap gap-2" aria-label="Archive years">
            {
              primaryLinks.map((link) => (
                <a
                  class:list={[
                    'rounded-md border px-3 py-2 text-sm font-semibold transition',
                    link.href === `/${activeYear}/`
                      ? 'border-brand-blue bg-brand-blue-soft text-brand-blue-dark'
                      : 'border-slate-200 bg-white text-slate-600 hover:border-brand-blue hover:text-brand-blue-dark',
                  ]}
                  href={link.href}
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </header>

    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-8 md:grid-cols-[minmax(0,1fr)_18rem] md:px-8 md:py-12">
      <section class="min-w-0">
        {
          currentPage ? (
            <article class="legacy-content rounded-lg border border-slate-200 bg-white p-5 shadow-sm md:p-8">
              {currentPage.featuredImage && (
                <img
                  class="mb-8 aspect-[2/1] w-full rounded-md object-cover"
                  src={currentPage.featuredImage}
                  alt=""
                  loading="eager"
                />
              )}
              <div class="prose prose-slate max-w-none prose-a:text-brand-blue-dark prose-table:text-sm" set:html={currentPage.html} />
            </article>
          ) : (
            <div class="space-y-4">
              {displayPages.map((archivePage) => (
                <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
                  <div class="flex flex-col gap-4 sm:flex-row">
                    {archivePage.featuredImage && (
                      <a class="block shrink-0" href={archivePage.path}>
                        <img
                          class="h-28 w-full rounded-md object-cover sm:w-40"
                          src={archivePage.featuredImage}
                          alt={archivePage.title}
                          loading="lazy"
                        />
                      </a>
                    )}
                    <div class="min-w-0">
                      <h2 class="font-display text-xl font-bold text-ink">
                        <a class="hover:text-brand-blue-dark" href={archivePage.path}>
                          {archivePage.title}
                        </a>
                      </h2>
                      {archivePage.date && (
                        <p class="mt-1 text-xs font-semibold uppercase text-muted">
                          {new Intl.DateTimeFormat('en-HK', {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric',
                            timeZone: 'Asia/Hong_Kong',
                          }).format(new Date(archivePage.date))}
                        </p>
                      )}
                      <p class="mt-3 text-sm leading-6 text-slate-600">{archivePage.excerpt}</p>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          )
        }
      </section>

      <aside class="md:sticky md:top-6 md:self-start">
        <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
          <h2 class="font-display text-base font-bold text-ink">{editionLabel}</h2>
          <p class="mt-1 text-sm text-muted">{displayPages.length} migrated pages</p>
          <div class="mt-4 flex flex-col gap-2">
            {
              displayPages.slice(0, 12).map((archivePage) => (
                <a
                  class:list={[
                    'rounded-md px-3 py-2 text-sm leading-5 transition',
                    currentPage?.slug === archivePage.slug
                      ? 'bg-brand-blue-soft text-brand-blue-dark'
                      : 'text-slate-600 hover:bg-slate-100 hover:text-ink',
                  ]}
                  href={archivePage.path}
                >
                  {archivePage.title}
                </a>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .legacy-content :global(img) {
    height: auto;
    max-width: 100%;
    border-radius: 0.375rem;
  }

  .legacy-content :global(figure) {
    overflow-x: auto;
  }

  .legacy-content :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    white-space: normal;
  }

  .legacy-content :global(td),
  .legacy-content :global(th) {
    min-width: 10rem;
    vertical-align: top;
  }
</style>
