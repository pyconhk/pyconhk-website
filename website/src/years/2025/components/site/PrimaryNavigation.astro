---
import { resolveRequiredLocalizedValue, type SiteLocale, type SiteYear } from '@/config/site';
import { buildLocalizedPath, getLocalizedSuffixFromPathname } from '@/lib/routing';
import Icon from '@/years/2025/components/ui/Icon.astro';
import { navigationItems } from '@/years/2025/data/navigation';
import type { SiteSectionSlug } from '@/years/2025/data/sections';

interface Props {
  year: SiteYear;
  locale: SiteLocale;
  currentSection?: SiteSectionSlug;
  currentPathname?: string;
  mobile?: boolean;
}

const { year, locale, currentSection, currentPathname = Astro.url.pathname, mobile = false } = Astro.props;

type ResolvedNavigationLink = {
  kind: 'link';
  label: string;
  href: string;
  active: boolean;
};

type ResolvedNavigationGroup = {
  kind: 'group';
  label: string;
  active: boolean;
  children: ResolvedNavigationLink[];
};

type ResolvedNavigationItem = ResolvedNavigationLink | ResolvedNavigationGroup;

const currentNavigationSuffix = getLocalizedSuffixFromPathname(currentPathname);

function resolveNavigationSuffix(href: string): string | undefined {
  if (!href.startsWith('/')) {
    return undefined;
  }

  return getLocalizedSuffixFromPathname(href);
}

function isCurrentNavigationHref(href: string): boolean {
  return resolveNavigationSuffix(href) === currentNavigationSuffix;
}

const resolvedNavigationItems: ResolvedNavigationItem[] = navigationItems.map((item) => {
  if (item.kind === 'group') {
    const children = item.children.map((child) => {
      const href = child.href ?? buildLocalizedPath(year, locale, child.path ?? '');

      return {
        kind: 'link' as const,
        label: resolveRequiredLocalizedValue(child.label, locale),
        href,
        active: isCurrentNavigationHref(href),
      };
    });

    return {
      kind: 'group' as const,
      label: resolveRequiredLocalizedValue(item.label, locale),
      active:
        children.some((child) => child.active) ||
        item.children.some((child) => child.activeSection === currentSection),
      children,
    };
  }

  const href = item.href ?? buildLocalizedPath(year, locale, item.path ?? '');

  return {
    kind: 'link' as const,
    label: resolveRequiredLocalizedValue(item.label, locale),
    href,
    active:
      isCurrentNavigationHref(href) ||
      Boolean(item.activeSection && item.activeSection === currentSection),
  };
});

const desktopLinkClass =
  "relative inline-flex items-center px-1 py-2.5 text-sm font-semibold text-slate-600 transition-colors duration-200 hover:text-slate-800 2xl:text-base after:absolute after:left-1/2 after:-bottom-1 after:h-0.5 after:w-0 after:-translate-x-1/2 after:bg-current after:transition-all after:duration-300 hover:after:w-full";

const desktopActiveClass = 'text-slate-800 after:w-full';
const dropdownPanelClass =
  'absolute left-0 top-full z-20 hidden min-w-[15rem] rounded-xl border border-slate-200 bg-white p-2 shadow-lg group-hover:block group-focus-within:block';
const mobileLinkClass =
  'relative block py-1.5 text-base font-normal leading-snug text-white transition-colors hover:text-white/80';
---

<ul class:list={[mobile ? 'flex flex-col gap-3' : 'flex items-center space-x-5 2xl:space-x-7', 'm-0 list-none p-0']}>
  {resolvedNavigationItems.map((item) =>
    item.kind === 'group' ? (
      <li class:list={mobile ? 'mt-2' : 'group relative'}>
        {mobile ? (
          <>
            <div class="flex items-center justify-start gap-2 text-white">
              <span class:list={['text-base font-semibold leading-snug', item.active ? 'text-white' : 'text-white/80']}>
                {item.label}
              </span>
              <Icon name="chevron-down" className="h-3.5 w-3.5 text-current" />
            </div>

            <div class="mt-3 ml-2 border-l border-slate-600 pl-6">
              <ul class="m-0 list-none space-y-3 p-0">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class:list={[mobileLinkClass, child.active ? 'text-white' : 'text-white/80']}
                      data-mobile-nav-link="true"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </>
        ) : (
          <>
            <button
              type="button"
              class:list={[desktopLinkClass, item.active && desktopActiveClass]}
              aria-haspopup="true"
            >
              <span class="inline-flex items-center gap-1.5">
                <span>{item.label}</span>
                <Icon
                  name="chevron-down"
                  className="h-3.5 w-3.5 text-current transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180"
                />
              </span>
            </button>

            <div class="absolute left-0 top-full hidden h-3 w-full bg-transparent group-hover:block group-focus-within:block"></div>

            <div class={dropdownPanelClass}>
              <ul class="m-0 list-none space-y-1 p-0">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={child.active ? 'page' : undefined}
                      data-dropdown-link
                      class:list={[
                        'block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-600 transition-colors focus-visible:outline-none 2xl:text-base',
                        child.active && 'text-slate-800',
                      ]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </>
        )}
      </li>
    ) : (
      <li class:list={mobile ? 'mt-2' : ''}>
        <a
          href={item.href}
          class:list={
            mobile
              ? [mobileLinkClass, item.active ? 'text-white' : 'text-white/80']
              : [desktopLinkClass, item.active && desktopActiveClass]
          }
          data-mobile-nav-link={mobile ? 'true' : undefined}
        >
          {item.label}
        </a>
      </li>
    )
  )}
</ul>

<style>
  [data-dropdown-link][data-highlighted='true'] {
    background-color: rgb(243 244 246);
    color: rgb(30 41 59);
  }
</style>

<script is:inline data-astro-rerun>
  for (const dropdownLink of document.querySelectorAll('[data-dropdown-link]')) {
    if (!(dropdownLink instanceof HTMLElement) || dropdownLink.dataset.highlightReady === 'true') {
      continue;
    }

    dropdownLink.dataset.highlightReady = 'true';

    const clearSiblingHighlights = () => {
      const list = dropdownLink.closest('ul');

      for (const link of list?.querySelectorAll('[data-dropdown-link]') ?? []) {
        if (link instanceof HTMLElement) {
          link.removeAttribute('data-highlighted');
        }
      }
    };

    const setHighlighted = () => {
      clearSiblingHighlights();
      dropdownLink.dataset.highlighted = 'true';
    };

    dropdownLink.addEventListener('mouseenter', setHighlighted);
    dropdownLink.addEventListener('focus', setHighlighted);
    dropdownLink.addEventListener('mouseleave', () => dropdownLink.removeAttribute('data-highlighted'));
    dropdownLink.addEventListener('blur', () => dropdownLink.removeAttribute('data-highlighted'));
  }
</script>
