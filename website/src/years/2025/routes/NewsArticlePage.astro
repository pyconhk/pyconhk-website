---
import { type SiteLocale, type SiteYear } from '@/config/site';
import { getPostBySlug } from '@/lib/news';
import NewsArticle from '@/years/2025/components/NewsArticle.astro';
import ConferenceLayout from '@/years/2025/layouts/ConferenceLayout.astro';

interface Props {
  year: SiteYear;
  locale: SiteLocale;
  slug: string;
}

const { year, locale, slug } = Astro.props;
const post = await getPostBySlug(year, slug, locale);

if (!post) {
  throw new Error(`Missing post for slug: ${slug}`);
}
---

<ConferenceLayout
  title={post.title}
  description={post.excerpt}
  year={year}
  locale={locale}
  currentSection="news"
  imagePath={post.coverImage}
>
  <NewsArticle article={post} locale={locale} year={year} />
</ConferenceLayout>
