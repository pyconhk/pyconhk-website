---
import { getConferenceContent } from '@/lib/conference-content';
import DoodleButton from '@/years/2026/components/DoodleButton.astro';
import ScrollIndicator from '@/years/2026/components/ScrollIndicator.astro';
import {
  type CfpLocale,
  contentByLocale,
  editProposalUrl,
  sponsorshipUrl,
  submitProposalUrl,
} from '@/years/2026/data/cfp';
import ConferenceLayout from '@/years/2026/layouts/ConferenceLayout.astro';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const original = contentByLocale[locale];
const content = getConferenceContent(locale);
const stageCopy = {
  en: {
    title: 'Poster & Sprint proposals remain open',
    body: 'Only Poster and Sprint proposals are still open. Talk (30 min), Short Talk (15 min) and Lightning Talk (5 min) submissions have closed. Existing submitters can still view their proposals.',
    submit: 'Submit a Poster or Sprint proposal',
    view: 'View your proposals',
    formats: 'Open proposal formats',
    posterDeadline: 'Poster proposal deadline',
    sprintDeadline: 'Sprint proposal deadline',
    sprintDay: 'Development Sprint',
  },
  'zh-hk': {
    title: 'Poster 同 Sprint 提案仍然開放',
    body: '目前只接受 Poster 同 Sprint 提案。Talk（30 分鐘）、Short Talk（15 分鐘）同 Lightning Talk（5 分鐘）已經截止。之前提交咗嘅提案仲可以登入睇返。',
    submit: '提交 Poster 或 Sprint 提案',
    view: '睇返已提交嘅提案',
    formats: '仍然開放嘅提案形式',
    posterDeadline: 'Poster 提案截止',
    sprintDeadline: 'Sprint 提案截止',
    sprintDay: '衝刺開發日',
  },
  'zh-hant': {
    title: 'Poster 與 Sprint 提案仍開放',
    body: '目前只接受 Poster 與 Sprint 提案。Talk（30 分鐘）、Short Talk（15 分鐘）與 Lightning Talk（5 分鐘）的徵集已截止；已提交的提案仍可登入查看。',
    submit: '提交 Poster 或 Sprint 提案',
    view: '查看已提交提案',
    formats: '仍開放的提案形式',
    posterDeadline: 'Poster 提案截止',
    sprintDeadline: 'Sprint 提案截止',
    sprintDay: '衝刺開發日',
  },
  'zh-hans': {
    title: 'Poster 与 Sprint 提案仍开放',
    body: '目前仅接受 Poster 与 Sprint 提案。Talk（30 分钟）、Short Talk（15 分钟）与 Lightning Talk（5 分钟）的征集已截止；已提交的提案仍可登录查看。',
    submit: '提交 Poster 或 Sprint 提案',
    view: '查看已提交提案',
    formats: '仍开放的提案形式',
    posterDeadline: 'Poster 提案截止',
    sprintDeadline: 'Sprint 提案截止',
    sprintDay: '冲刺开发日',
  },
  ja: {
    title: 'ポスター・スプリントの提案を募集中',
    body: 'ポスターとスプリントのプロポーザルのみ引き続き募集しています。トーク（30分）、ショートトーク（15分）、ライトニングトーク（5分）の募集は終了しました。提出済みのプロポーザルは引き続き確認できます。',
    submit: 'ポスター・スプリントの提案を提出',
    view: '提出済みのプロポーザルを見る',
    formats: '募集中のプロポーザル形式',
    posterDeadline: 'ポスター提案の締切',
    sprintDeadline: 'スプリント提案の締切',
    sprintDay: '開発スプリント',
  },
  ko: {
    title: '포스터·스프린트 제안 모집 중',
    body: '포스터와 스프린트 제안만 계속 모집합니다. 토크(30분), 쇼트 토크(15분), 라이트닝 토크(5분) 모집은 마감되었습니다. 이미 제출한 제안은 계속 확인할 수 있습니다.',
    submit: '포스터 또는 스프린트 제안 제출',
    view: '제출한 제안 보기',
    formats: '모집 중인 제안 형식',
    posterDeadline: '포스터 제안 마감',
    sprintDeadline: '스프린트 제안 마감',
    sprintDay: '개발 스프린트',
  },
}[locale];
const copy = {
  ...original,
  metadata: { title: `${content.event.title} CFP | ${content.event.theme}`, description: stageCopy.body },
  hero: { ...original.hero, badge: stageCopy.title, headline: content.event.theme, body: stageCopy.body },
  cta: { ...original.cta, submit: stageCopy.submit, edit: stageCopy.view },
  proposals: { ...original.proposals, title: stageCopy.formats, types: original.proposals.types.slice(3) },
  keyDates: { ...original.keyDates, timezone: 'Asia/Hong_Kong (HKT, UTC+8)', items: [
    { label: stageCopy.posterDeadline, value: '2026-11-01\n23:59 HKT', status: '', note: '' },
    { label: stageCopy.sprintDeadline, value: '2026-11-14\n23:59 HKT', status: '', note: '' },
    { label: stageCopy.sprintDay, value: '2026-11-15', status: '', note: '' },
  ] },
  finalCta: { fragments: content.event.theme, title: stageCopy.title, body: stageCopy.body },
};

const pagePadding = 'px-5 sm:px-8 lg:px-14 xl:px-16';
const contentWidth = 'mx-auto max-w-7xl';
const toneClasses = {
  yellow: 'bg-conference-yellow',
  white: 'bg-conference-surface',
  lilac: 'bg-conference-lilac',
  sky: 'bg-conference-sky',
};

const programNoteClasses = [
  'bg-conference-yellow',
  'bg-conference-lilac',
  'bg-conference-surface',
  'bg-conference-rose',
];

const dateCardClasses = [
  'bg-conference-surface -rotate-1',
  'bg-conference-sky rotate-1',
  'bg-conference-sand -rotate-[0.5deg]',
];
---

<ConferenceLayout
  title={copy.metadata.title}
  description={copy.metadata.description}
  locale={locale}
>
  <div
    lang={copy.localeMeta.htmlLang}
    class="min-h-screen overflow-x-clip bg-conference-paper text-conference-ink"
    data-pagefind-body
    data-pagefind-filter="year:2026"
    data-pagefind-meta="year:2026"
    data-cfp-stage="poster-sprint"
  >


    <section
      class:list={[
        'relative pt-4 pb-10 md:pt-6 md:pb-14 min-[1292px]:min-h-[calc(100svh-8rem)] min-[1292px]:pb-20',
        pagePadding,
      ]}
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 260 56"
        class="absolute top-40 left-8 hidden h-16 w-56 md:block"
        fill="none"
      >
        <path
          d="M4 31C43 8 68 47 108 24C151 -1 182 45 256 18"
          stroke="#2b5b8433"
          stroke-width="5"
          stroke-linecap="round"></path>
      </svg>
      <svg
        aria-hidden="true"
        viewBox="0 0 260 56"
        class="absolute top-[35rem] right-12 hidden h-14 w-52 md:block"
        fill="none"
      >
        <path
          d="M4 31C43 8 68 47 108 24C151 -1 182 45 256 18"
          stroke="#d8223630"
          stroke-width="5"
          stroke-linecap="round"></path>
      </svg>
      <span class="absolute top-32 right-[12%] hidden h-3 w-3 rounded-full bg-[#d8223640] lg:block"></span>

      <div
        class:list={[
          contentWidth,
          'grid gap-10 pt-9 md:gap-12 md:pt-12 xl:grid-cols-[minmax(0,1.05fr)_minmax(20rem,0.95fr)] xl:items-center xl:gap-14 xl:pt-16',
        ]}
      >
        <div class="relative mx-auto w-full max-w-[46rem] min-w-0 xl:max-w-none">
          <div data-cfp-status class="absolute -top-1 -left-2 z-10 inline-flex max-w-[calc(100%-3rem)] items-center gap-2 rounded-full border-2 border-conference-outline bg-conference-surface px-4 py-2 font-mono text-sm leading-snug font-black text-center whitespace-normal sm:-left-3 lg:-left-4">
            <span class="h-3 w-3 rounded-full border border-conference-outline bg-[#00a887]"></span>
            {copy.hero.badge}
          </div>

          <div class="relative mx-auto flex min-h-[clamp(12rem,31vw,19rem)] w-full max-w-[46rem] min-w-0 items-center justify-center rounded-[38%_45%_34%_42%/24%_30%_36%_32%] border-[3px] border-conference-outline bg-conference-yellow/90 px-4 py-8 sm:px-8 md:px-10 xl:max-w-none">
            <h1 class="flex w-full max-w-5xl min-w-0 flex-col items-center justify-center gap-1 text-center font-sans text-[clamp(2rem,7vw,4.6rem)] leading-[0.95] font-black tracking-normal text-conference-ink sm:gap-2 md:text-[4rem] xl:text-[3.2rem] xl:leading-[1.08]">
              {
                [copy.hero.headline].map((line) => (
                  <span class="block max-w-full">{line}</span>
                ))
              }
            </h1>
          </div>

          <div class="mx-auto mt-8 max-w-3xl space-y-5 text-center xl:mx-0 xl:text-left">
            <p class="break-words text-2xl leading-tight font-black text-conference-blue lg:text-3xl">
              {copy.hero.subheadline}
            </p>
            <p class="mx-auto max-w-2xl break-words text-base leading-8 text-conference-muted md:text-lg xl:mx-0">
              {copy.hero.body}
            </p>
            <div class="flex flex-col items-center gap-4 pt-4 sm:flex-row sm:flex-wrap sm:justify-center xl:justify-start">
              <DoodleButton href={submitProposalUrl} label={copy.cta.submit}>{copy.cta.submit}</DoodleButton>
              <DoodleButton href={editProposalUrl} label={copy.cta.edit} variant="secondary">{copy.cta.edit}</DoodleButton>
              <DoodleButton href={sponsorshipUrl} label={copy.cta.sponsorship} variant="secondary">{copy.cta.sponsorship}</DoodleButton>
            </div>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-3xl rounded-[1.75rem] border-[3px] border-conference-outline bg-conference-surface p-6 shadow-conference-panel md:p-8 xl:max-w-none xl:p-10">
          <div class="flex items-center justify-between">
            <span class="h-5 w-5 rounded-full border-2 border-conference-outline bg-[#d82236]"></span>
            <span class="h-5 w-5 rounded-full border-2 border-conference-outline bg-conference-yellow"></span>
          </div>

          <h2 class="mt-8 max-w-3xl break-words text-[clamp(2rem,5.5vw,3.25rem)] leading-[1.05] font-black text-conference-blue xl:mt-10 xl:text-4xl">
            {copy.programWall.title}
          </h2>

          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {
              copy.decorativeFragments.map((fragment, index) => (
                <div
                  class:list={[
                    'min-h-24 rounded-2xl border-2 border-conference-outline px-5 py-4 shadow-conference-card',
                    programNoteClasses[index],
                    index % 2 === 0 ? '-rotate-1' : 'rotate-1',
                  ]}
                >
                  <p class="font-mono text-xs font-black text-conference-blue">0{index + 1}</p>
                  <p class="mt-3 break-words text-lg leading-snug font-black">{fragment}</p>
                </div>
              ))
            }
          </div>

          <div class="mt-8 rounded-2xl border-2 border-conference-outline bg-conference-sand px-5 py-5 text-base leading-7 font-semibold text-conference-ink sm:px-6">
            {copy.programWall.caption}
          </div>
        </div>
      </div>

      <ScrollIndicator label={copy.keyDates.title} targetId="key-dates" />
    </section>

    <section
      id="key-dates"
      class:list={[
        'scroll-mt-12 pt-16 pb-12 md:pt-20 md:pb-16 xl:pt-28 xl:pb-20',
        pagePadding,
      ]}
    >
      <div class={contentWidth}>
        <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
          <h2 class="break-words font-mono text-[clamp(2rem,6vw,3.5rem)] leading-tight font-black md:text-5xl">
            {copy.keyDates.title}
          </h2>
          <p class="text-base font-semibold text-conference-muted md:text-lg">
            <code class="rounded-md border border-[#17203333] bg-conference-surface px-2 py-1 font-mono text-sm font-black text-conference-blue md:text-base">
              {copy.keyDates.timezone}
            </code>
          </p>
        </div>

        <div class="mt-8 grid gap-6 lg:grid-cols-3 lg:gap-7">
          {
            copy.keyDates.items.map((item, index) => (
              <article
                data-cfp-date={['poster-deadline', 'sprint-deadline', 'sprint-day'][index]}
                class:list={[
                  'min-h-48 rounded-2xl border-[3px] border-conference-outline p-6 shadow-sm lg:min-h-64 xl:p-7',
                  dateCardClasses[index],
                ]}
              >
                <p
                  class:list={[
                    'font-mono text-sm font-black uppercase',
                    index === 0
                      ? 'text-conference-red'
                      : index === 1
                        ? 'text-conference-blue'
                        : 'text-[#00a887]',
                  ]}
                >
                  {item.label}
                </p>
                <p class="mt-5 whitespace-pre-line break-words font-mono text-[clamp(1.6rem,4.4vw,2rem)] leading-tight font-black lg:text-[clamp(1.8rem,2.45vw,2.25rem)] xl:mt-6 xl:text-[2.35rem]">
                  {item.value}
                </p>
                {
                  item.status && (
                    <p class="mt-3 break-words font-mono text-base leading-tight font-black text-conference-muted xl:text-lg">
                      {item.status}
                    </p>
                  )
                }
                <p
                  class:list={[
                    'text-base leading-7 font-semibold text-conference-muted xl:text-lg',
                    item.status ? 'mt-4' : 'mt-6 xl:mt-7',
                  ]}
                >
                  {item.note}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class:list={['relative py-16 sm:py-20', pagePadding]}>
      <div class="absolute inset-x-5 top-36 bottom-8 hidden rounded-[44%_48%_39%_42%/18%_19%_18%_20%] border-[3px] border-conference-outline md:block lg:inset-x-14"></div>
      <div class:list={[contentWidth, 'relative']}>
        <div class="flex flex-col justify-between gap-4 md:flex-row md:items-start">
          <h2 class="break-words font-mono text-[clamp(2.5rem,8vw,4.75rem)] leading-tight font-black md:text-5xl">
            {copy.proposals.title}
          </h2>
          <p class="max-w-md break-words text-base leading-7 text-conference-muted md:text-lg">
            {copy.proposals.intro}
          </p>
        </div>

        <div class="mt-12 grid gap-7 md:mx-auto md:mt-16 md:max-w-4xl md:grid-cols-2">
          {
            copy.proposals.types.map((proposal, index) => {
              const indexColor =
                proposal.tone === 'white' || proposal.tone === 'sky'
                  ? 'text-conference-blue'
                  : 'text-conference-red';

              return (
                <article
                  data-cfp-format={proposal.index === '04' ? 'poster' : 'sprint'}
                  class:list={[
                    'min-h-48 rounded-2xl border-[3px] border-conference-outline p-6 md:p-7',
                    toneClasses[proposal.tone],
                    index % 2 === 0 ? '-rotate-1' : 'rotate-1',
                  ]}
                >
                  <p class:list={['font-mono text-3xl font-black', indexColor]}>
                    {proposal.index}
                  </p>
                  <h3 class="mt-5 break-words font-mono text-2xl leading-tight font-black">
                    {proposal.title}
                  </h3>
                  <p class="mt-4 break-words text-sm leading-6 text-conference-ink md:text-base">
                    {proposal.description}
                  </p>
                </article>
              );
            })
          }
        </div>

      </div>
    </section>

    <section class:list={['py-16 sm:py-20', pagePadding]}>
      <div
        class:list={[
          contentWidth,
          'grid gap-10 rounded-[1.75rem] border-[3px] border-conference-outline bg-conference-sand p-7 md:grid-cols-[0.75fr_1fr] md:p-12 lg:p-14',
        ]}
      >
        <div>
          <p class="font-mono text-base font-black text-conference-blue uppercase">
            {copy.guidance.kicker}
          </p>
          <h2 class="mt-7 break-words font-mono text-[clamp(2.25rem,7vw,4rem)] leading-tight font-black md:text-5xl">
            {copy.guidance.title}
          </h2>
          <p class="mt-8 max-w-md break-words text-base leading-8 text-conference-muted md:text-lg">
            {copy.guidance.body}
          </p>
        </div>

        <div class="grid gap-5 self-center">
          {
            copy.guidance.items.map((item, index) => (
              <div
                class:list={[
                  'flex gap-5 rounded-2xl border-2 border-conference-outline bg-conference-surface px-6 py-5',
                  index === 0 ? '-rotate-1' : index === 1 ? 'rotate-1' : '',
                ]}
              >
                <span
                  class:list={[
                    'font-mono text-3xl font-black',
                    index === 0
                      ? 'text-[#00a887]'
                      : index === 1
                        ? 'text-conference-blue'
                        : 'text-conference-red',
                  ]}
                >
                  {item.mark}
                </span>
                <p class="break-words text-base leading-7 md:text-lg">{item.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class:list={['pt-12 pb-24', pagePadding]}>
      <div
        class:list={[
          contentWidth,
          'grid gap-10 rounded-[1.75rem] border-[4px] border-conference-outline bg-[#2b5b84] p-7 text-white md:grid-cols-[1fr_auto] md:items-center md:p-12',
        ]}
      >
        <div>
          <p class="break-words font-mono text-sm font-black text-[#ffd343] md:text-base">
            {copy.finalCta.fragments}
          </p>
          <h2 class="mt-6 max-w-3xl break-words font-mono text-[clamp(2rem,6vw,3.75rem)] leading-tight font-black md:text-5xl">
            {copy.finalCta.title}
          </h2>
          <p class="mt-5 max-w-3xl break-words text-base leading-8 text-[#dcebff] md:text-lg">
            {copy.finalCta.body}
          </p>
        </div>
        <div class="flex flex-col gap-4 sm:flex-row md:flex-col">
          <DoodleButton href={submitProposalUrl} label={copy.cta.submit}>{copy.cta.submit}</DoodleButton>
          <DoodleButton href={editProposalUrl} label={copy.cta.edit} variant="secondary">{copy.cta.edit}</DoodleButton>
          <DoodleButton href={sponsorshipUrl} label={copy.cta.sponsorship} variant="secondary">{copy.cta.sponsorship}</DoodleButton>
        </div>
      </div>
    </section>
  </div>
</ConferenceLayout>
