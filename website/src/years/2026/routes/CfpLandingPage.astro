---
import { getConferenceContent } from '@/lib/conference-content';
import DoodleButton from '@/years/2026/components/DoodleButton.astro';
import ScrollIndicator from '@/years/2026/components/ScrollIndicator.astro';
import {
  type CfpLocale,
  contentByLocale,
  editProposalUrl,
  sponsorshipUrl,
} from '@/years/2026/data/cfp';
import { contentUi } from '@/years/2026/data/content-ui';
import ConferenceLayout from '@/years/2026/layouts/ConferenceLayout.astro';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const original = contentByLocale[locale];
const content = getConferenceContent(locale);
const closedCopy = {
  en: { title: 'Call for proposals closed', body: 'The call for proposals has closed. Existing submitters can still view their proposals.', view: 'View your proposals', formats: 'Proposal formats' },
  'zh-hk': { title: '提案徵集已截止', body: '提案徵集已經截止。已提交提案嘅講者仍然可以查看提案。', view: '查看已提交提案', formats: '提案形式' },
  'zh-hant': { title: '提案徵集已截止', body: '提案徵集已截止。已提交提案的講者仍可查看提案。', view: '查看已提交提案', formats: '提案形式' },
  'zh-hans': { title: '提案征集已截止', body: '提案征集已截止。已提交提案的讲者仍可查看提案。', view: '查看已提交提案', formats: '提案形式' },
  ja: { title: 'プロポーザル募集は終了しました', body: 'プロポーザルの募集は終了しました。提出済みのプロポーザルは引き続き確認できます。', view: '提出済みのプロポーザルを見る', formats: 'プロポーザルの形式' },
  ko: { title: '발표 제안 모집 마감', body: '발표 제안 모집이 마감되었습니다. 이미 제출한 제안은 계속 확인할 수 있습니다.', view: '제출한 제안 보기', formats: '제안 형식' },
}[locale];
const copy = {
  ...original,
  metadata: { title: `${content.event.title} CFP | ${content.event.theme}`, description: closedCopy.body },
  hero: { ...original.hero, badge: closedCopy.title, headline: content.event.theme, body: closedCopy.body },
  cta: { ...original.cta, edit: closedCopy.view },
  proposals: { ...original.proposals, title: closedCopy.formats },
  keyDates: { ...original.keyDates, items: [
    { ...original.keyDates.items[0], status: closedCopy.title, note: '' },
    { ...original.keyDates.items[1], value: content.event.datesLabel, status: '', note: '' },
    { ...original.keyDates.items[2], value: content.sprint.status === 'published' ? content.sprint.date : contentUi[locale].comingSoon, status: '', note: '' },
  ] },
  finalCta: { fragments: content.event.theme, title: closedCopy.title, body: closedCopy.body },
};

const pagePadding = 'px-5 sm:px-8 lg:px-14 xl:px-16';
const contentWidth = 'mx-auto max-w-7xl';
const toneClasses = {
  yellow: 'bg-[#ffd343]',
  white: 'bg-white',
  lilac: 'bg-[#c7b8ff]',
  sky: 'bg-[#bfe8ff]',
};

const programNoteClasses = [
  'bg-[#ffd343]',
  'bg-[#c7b8ff]',
  'bg-white',
  'bg-[#ffced5]',
];

const dateCardClasses = [
  'bg-white -rotate-1',
  'bg-[#bfe8ff] rotate-1',
  'bg-[#f7e9c5] -rotate-[0.5deg]',
];
---

<ConferenceLayout
  title={copy.metadata.title}
  description={copy.metadata.description}
  locale={locale}
>
  <div
    lang={copy.localeMeta.htmlLang}
    class="min-h-screen overflow-x-clip bg-[#fff8e8] text-[#172033]"
    data-pagefind-body
    data-pagefind-filter="year:2026"
    data-pagefind-meta="year:2026"
  >


    <section
      class:list={[
        'relative pt-4 pb-10 md:pt-6 md:pb-14 min-[1292px]:min-h-[calc(100svh-8rem)] min-[1292px]:pb-20',
        pagePadding,
      ]}
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 260 56"
        class="absolute top-40 left-8 hidden h-16 w-56 md:block"
        fill="none"
      >
        <path
          d="M4 31C43 8 68 47 108 24C151 -1 182 45 256 18"
          stroke="#2b5b8433"
          stroke-width="5"
          stroke-linecap="round"></path>
      </svg>
      <svg
        aria-hidden="true"
        viewBox="0 0 260 56"
        class="absolute top-[35rem] right-12 hidden h-14 w-52 md:block"
        fill="none"
      >
        <path
          d="M4 31C43 8 68 47 108 24C151 -1 182 45 256 18"
          stroke="#d8223630"
          stroke-width="5"
          stroke-linecap="round"></path>
      </svg>
      <span class="absolute top-32 right-[12%] hidden h-3 w-3 rounded-full bg-[#d8223640] lg:block"></span>

      <div
        class:list={[
          contentWidth,
          'grid gap-10 pt-9 md:gap-12 md:pt-12 xl:grid-cols-[minmax(0,1.05fr)_minmax(20rem,0.95fr)] xl:items-center xl:gap-14 xl:pt-16',
        ]}
      >
        <div class="relative mx-auto w-full max-w-[46rem] min-w-0 xl:max-w-none">
          <div class="absolute -top-1 -left-2 z-10 inline-flex max-w-[calc(100%-3rem)] items-center gap-2 rounded-full border-2 border-[#172033] bg-white px-4 py-2 font-mono text-sm leading-snug font-black text-center whitespace-normal sm:-left-3 lg:-left-4">
            <span class="h-3 w-3 rounded-full border border-[#172033] bg-[#00a887]"></span>
            {copy.hero.badge}
          </div>

          <div class="relative mx-auto flex min-h-[clamp(12rem,31vw,19rem)] w-full max-w-[46rem] min-w-0 items-center justify-center rounded-[38%_45%_34%_42%/24%_30%_36%_32%] border-[3px] border-[#172033] bg-[#ffd343e6] px-4 py-8 sm:px-8 md:px-10 xl:max-w-none">
            <h1 class="flex w-full max-w-5xl min-w-0 flex-col items-center justify-center gap-1 text-center font-sans text-[clamp(2rem,7vw,4.6rem)] leading-[0.95] font-black tracking-normal text-[#172033] sm:gap-2 md:text-[4rem] xl:text-[3.2rem] xl:leading-[1.08]">
              {
                [copy.hero.headline].map((line) => (
                  <span class="block max-w-full">{line}</span>
                ))
              }
            </h1>
          </div>

          <div class="mx-auto mt-8 max-w-3xl space-y-5 text-center xl:mx-0 xl:text-left">
            <p class="break-words text-2xl leading-tight font-black text-[#2b5b84] lg:text-3xl">
              {copy.hero.subheadline}
            </p>
            <p class="mx-auto max-w-2xl break-words text-base leading-8 text-[#586174] md:text-lg xl:mx-0">
              {copy.hero.body}
            </p>
            <div class="flex flex-col items-center gap-4 pt-4 sm:flex-row sm:flex-wrap sm:justify-center xl:justify-start">
              <span data-cfp-closed class="inline-flex rounded-xl border-2 border-[#172033] bg-[#ffd343] px-5 py-3 font-bold">{closedCopy.title}</span>
              <DoodleButton href={editProposalUrl} label={copy.cta.edit} variant="secondary">{copy.cta.edit}</DoodleButton>
              <DoodleButton href={sponsorshipUrl} label={copy.cta.sponsorship} variant="secondary">{copy.cta.sponsorship}</DoodleButton>
            </div>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-3xl rounded-[1.75rem] border-[3px] border-[#172033] bg-white p-6 shadow-[10px_12px_0_#17203322] md:p-8 xl:max-w-none xl:p-10">
          <div class="flex items-center justify-between">
            <span class="h-5 w-5 rounded-full border-2 border-[#172033] bg-[#d82236]"></span>
            <span class="h-5 w-5 rounded-full border-2 border-[#172033] bg-[#ffd343]"></span>
          </div>

          <h2 class="mt-8 max-w-3xl break-words text-[clamp(2rem,5.5vw,3.25rem)] leading-[1.05] font-black text-[#2b5b84] xl:mt-10 xl:text-4xl">
            {copy.programWall.title}
          </h2>

          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {
              copy.decorativeFragments.map((fragment, index) => (
                <div
                  class:list={[
                    'min-h-24 rounded-2xl border-2 border-[#172033] px-5 py-4 shadow-[4px_5px_0_#17203318]',
                    programNoteClasses[index],
                    index % 2 === 0 ? '-rotate-1' : 'rotate-1',
                  ]}
                >
                  <p class="font-mono text-xs font-black text-[#2b5b84]">0{index + 1}</p>
                  <p class="mt-3 break-words text-lg leading-snug font-black">{fragment}</p>
                </div>
              ))
            }
          </div>

          <div class="mt-8 rounded-2xl border-2 border-[#172033] bg-[#f7e9c5] px-5 py-5 text-base leading-7 font-semibold text-[#172033] sm:px-6">
            {copy.programWall.caption}
          </div>
        </div>
      </div>

      <ScrollIndicator label={copy.keyDates.title} targetId="key-dates" />
    </section>

    <section
      id="key-dates"
      class:list={[
        'scroll-mt-12 pt-16 pb-12 md:pt-20 md:pb-16 xl:pt-28 xl:pb-20',
        pagePadding,
      ]}
    >
      <div class={contentWidth}>
        <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
          <h2 class="break-words font-mono text-[clamp(2rem,6vw,3.5rem)] leading-tight font-black md:text-5xl">
            {copy.keyDates.title}
          </h2>
          <p class="text-base font-semibold text-[#586174] md:text-lg">
            <code class="rounded-md border border-[#17203333] bg-white px-2 py-1 font-mono text-sm font-black text-[#2b5b84] md:text-base">
              {copy.keyDates.timezone}
            </code>
          </p>
        </div>

        <div class="mt-8 grid gap-6 lg:grid-cols-3 lg:gap-7">
          {
            copy.keyDates.items.map((item, index) => (
              <article
                class:list={[
                  'min-h-48 rounded-2xl border-[3px] border-[#172033] p-6 shadow-sm lg:min-h-64 xl:p-7',
                  dateCardClasses[index],
                ]}
              >
                <p
                  class:list={[
                    'font-mono text-sm font-black uppercase',
                    index === 0
                      ? 'text-[#d82236]'
                      : index === 1
                        ? 'text-[#2b5b84]'
                        : 'text-[#00a887]',
                  ]}
                >
                  {item.label}
                </p>
                <p class="mt-5 whitespace-pre-line break-words font-mono text-[clamp(1.6rem,4.4vw,2rem)] leading-tight font-black lg:text-[clamp(1.8rem,2.45vw,2.25rem)] xl:mt-6 xl:text-[2.35rem]">
                  {item.value}
                </p>
                {
                  item.status && (
                    <p class="mt-3 break-words font-mono text-base leading-tight font-black text-[#586174] xl:text-lg">
                      {item.status}
                    </p>
                  )
                }
                <p
                  class:list={[
                    'text-base leading-7 font-semibold text-[#586174] xl:text-lg',
                    item.status ? 'mt-4' : 'mt-6 xl:mt-7',
                  ]}
                >
                  {item.note}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class:list={['relative py-16 sm:py-20', pagePadding]}>
      <div class="absolute inset-x-5 top-36 bottom-8 hidden rounded-[44%_48%_39%_42%/18%_19%_18%_20%] border-[3px] border-[#172033] md:block lg:inset-x-14"></div>
      <div class:list={[contentWidth, 'relative']}>
        <div class="flex flex-col justify-between gap-4 md:flex-row md:items-start">
          <h2 class="break-words font-mono text-[clamp(2.5rem,8vw,4.75rem)] leading-tight font-black md:text-5xl">
            {copy.proposals.title}
          </h2>
          <p class="max-w-md break-words text-base leading-7 text-[#586174] md:text-lg">
            {copy.proposals.intro}
          </p>
        </div>

        <div class="mt-12 grid gap-7 md:mt-16 md:grid-cols-3">
          {
            copy.proposals.types.slice(0, 3).map((proposal, index) => {
              const indexColor =
                proposal.tone === 'white' || proposal.tone === 'sky'
                  ? 'text-[#2b5b84]'
                  : 'text-[#d82236]';

              return (
                <article
                  class:list={[
                    'min-h-48 rounded-2xl border-[3px] border-[#172033] p-6 md:p-7',
                    toneClasses[proposal.tone],
                    index % 2 === 0 ? '-rotate-1' : 'rotate-1',
                  ]}
                >
                  <p class:list={['font-mono text-3xl font-black', indexColor]}>
                    {proposal.index}
                  </p>
                  <h3 class="mt-5 break-words font-mono text-2xl leading-tight font-black">
                    {proposal.title}
                  </h3>
                  <p class="mt-4 break-words text-sm leading-6 text-[#172033] md:text-base">
                    {proposal.description}
                  </p>
                </article>
              );
            })
          }
        </div>

        <div class="mt-10 grid gap-7 md:mx-auto md:max-w-4xl md:grid-cols-2">
          {
            copy.proposals.types.slice(3).map((proposal, index) => {
              const indexColor =
                proposal.tone === 'white' || proposal.tone === 'sky'
                  ? 'text-[#2b5b84]'
                  : 'text-[#d82236]';

              return (
                <article
                  class:list={[
                    'min-h-48 rounded-2xl border-[3px] border-[#172033] p-6 md:p-7',
                    toneClasses[proposal.tone],
                    index === 0 ? 'rotate-1' : '-rotate-1',
                  ]}
                >
                  <p class:list={['font-mono text-3xl font-black', indexColor]}>
                    {proposal.index}
                  </p>
                  <h3 class="mt-5 break-words font-mono text-2xl leading-tight font-black">
                    {proposal.title}
                  </h3>
                  <p class="mt-4 break-words text-sm leading-6 text-[#172033] md:text-base">
                    {proposal.description}
                  </p>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <section class:list={['py-16 sm:py-20', pagePadding]}>
      <div
        class:list={[
          contentWidth,
          'grid gap-10 rounded-[1.75rem] border-[3px] border-[#172033] bg-[#f7e9c5] p-7 md:grid-cols-[0.75fr_1fr] md:p-12 lg:p-14',
        ]}
      >
        <div>
          <p class="font-mono text-base font-black text-[#2b5b84] uppercase">
            {copy.guidance.kicker}
          </p>
          <h2 class="mt-7 break-words font-mono text-[clamp(2.25rem,7vw,4rem)] leading-tight font-black md:text-5xl">
            {copy.guidance.title}
          </h2>
          <p class="mt-8 max-w-md break-words text-base leading-8 text-[#586174] md:text-lg">
            {copy.guidance.body}
          </p>
        </div>

        <div class="grid gap-5 self-center">
          {
            copy.guidance.items.map((item, index) => (
              <div
                class:list={[
                  'flex gap-5 rounded-2xl border-2 border-[#172033] bg-white px-6 py-5',
                  index === 0 ? '-rotate-1' : index === 1 ? 'rotate-1' : '',
                ]}
              >
                <span
                  class:list={[
                    'font-mono text-3xl font-black',
                    index === 0
                      ? 'text-[#00a887]'
                      : index === 1
                        ? 'text-[#2b5b84]'
                        : 'text-[#d82236]',
                  ]}
                >
                  {item.mark}
                </span>
                <p class="break-words text-base leading-7 md:text-lg">{item.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class:list={['pt-12 pb-24', pagePadding]}>
      <div
        class:list={[
          contentWidth,
          'grid gap-10 rounded-[1.75rem] border-[4px] border-[#172033] bg-[#2b5b84] p-7 text-white md:grid-cols-[1fr_auto] md:items-center md:p-12',
        ]}
      >
        <div>
          <p class="break-words font-mono text-sm font-black text-[#ffd343] md:text-base">
            {copy.finalCta.fragments}
          </p>
          <h2 class="mt-6 max-w-3xl break-words font-mono text-[clamp(2rem,6vw,3.75rem)] leading-tight font-black md:text-5xl">
            {copy.finalCta.title}
          </h2>
          <p class="mt-5 max-w-3xl break-words text-base leading-8 text-[#dcebff] md:text-lg">
            {copy.finalCta.body}
          </p>
        </div>
        <div class="flex flex-col gap-4 sm:flex-row md:flex-col">
          <span data-cfp-closed class="inline-flex rounded-xl border-2 border-[#172033] bg-[#ffd343] px-5 py-3 font-bold">{closedCopy.title}</span>
          <DoodleButton href={editProposalUrl} label={copy.cta.edit} variant="secondary">{copy.cta.edit}</DoodleButton>
          <DoodleButton href={sponsorshipUrl} label={copy.cta.sponsorship} variant="secondary">{copy.cta.sponsorship}</DoodleButton>
        </div>
      </div>
    </section>
  </div>
</ConferenceLayout>
