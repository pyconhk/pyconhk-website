---
import type { SprintContent as SprintData } from '@/lib/sprint-content';
import { contentUi } from '@/years/2026/data/content-ui';
import type { CfpLocale } from '@/years/2026/locales';

interface Props { locale: CfpLocale; content: SprintData; mode?: 'sprint' | 'qa' | 'preview'; }
const { locale, content, mode = 'sprint' } = Astro.props;
const copy = contentUi[locale];
const labels = {
  en: { ends: 'Ends at', projects: 'Sprint projects', lead: 'Sprint lead', repository: 'Project repository', setup: 'Setup instructions', skills: 'Useful skills', contributions: 'Ways to contribute', deadline: 'Project submission deadline', time: 'Hong Kong time (UTC+8)', untitled: 'Untitled project', draft: 'Draft project' },
  'zh-hk': { ends: '完結時間', projects: 'Sprint 項目', lead: 'Sprint Lead', repository: '項目程式碼', setup: '環境設定指引', skills: '適用技能', contributions: '可以參與嘅工作', deadline: '項目提交截止時間', time: '香港時間（UTC+8）', untitled: '未命名項目', draft: '項目草稿' },
  'zh-hant': { ends: '結束時間', projects: 'Sprint 項目', lead: 'Sprint Lead', repository: '項目程式碼', setup: '環境設定指引', skills: '適用技能', contributions: '可參與的工作', deadline: '項目提交截止時間', time: '香港時間（UTC+8）', untitled: '未命名項目', draft: '項目草稿' },
  'zh-hans': { ends: '结束时间', projects: 'Sprint 项目', lead: 'Sprint Lead', repository: '项目代码', setup: '环境配置指南', skills: '适用技能', contributions: '可参与的工作', deadline: '项目提交截止时间', time: '香港时间（UTC+8）', untitled: '未命名项目', draft: '项目草稿' },
  ja: { ends: '終了時間', projects: 'Sprint プロジェクト', lead: 'Sprint リード', repository: 'リポジトリ', setup: '環境構築ガイド', skills: '役立つスキル', contributions: '貢献できること', deadline: 'プロジェクト提出締切', time: '香港時間（UTC+8）', untitled: '名称未設定のプロジェクト', draft: '下書きのプロジェクト' },
  ko: { ends: '종료 시간', projects: 'Sprint 프로젝트', lead: 'Sprint 리드', repository: '프로젝트 저장소', setup: '환경 설정 안내', skills: '도움이 되는 기술', contributions: '기여할 수 있는 작업', deadline: '프로젝트 제출 마감', time: '홍콩 시간(UTC+8)', untitled: '제목 없는 프로젝트', draft: '프로젝트 초안' },
}[locale];
const projects = content.projects.filter(project => mode === 'preview' || project.status === 'published');
const dateLabel = content.date ? new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeZone: 'Asia/Hong_Kong' }).format(new Date(`${content.date}T12:00:00+08:00`)) : '';
const deadlineLabel = content.proposalDeadline ? new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeStyle: 'short', timeZone: 'Asia/Hong_Kong' }).format(new Date(content.proposalDeadline)) : '';
---

<div data-sprint-content class="space-y-6">
  {(mode === 'sprint' || mode === 'preview') && <>
    <p class="whitespace-pre-line">{content.intro}</p>
    {dateLabel && <p class="font-bold"><time datetime={content.date}>{dateLabel}</time></p>}
    {(content.startTime || content.endTime) && <p>{content.startTime ? `${content.startTime}${content.endTime ? `–${content.endTime}` : ''}` : `${labels.ends} ${content.endTime}`} · {labels.time}</p>}
    {content.location && <p>{content.location}</p>}
    {content.items.length > 0 && <ul class="list-disc space-y-3 pl-6">{content.items.map(item => <li class="whitespace-pre-line">{item}</li>)}</ul>}
    {projects.length > 0 && <section aria-labelledby="sprint-projects-heading" class="space-y-5">
      <h2 id="sprint-projects-heading" class="text-xl font-bold text-conference-ink">{labels.projects}</h2>
      {projects.map((project, index) => <article id={`sprint-project-${project.id || index}`} data-sprint-project={project.id} class="space-y-4 rounded-xl border-2 border-conference-outline p-5">
        <h3 class="text-lg font-bold text-conference-blue">{project.title || labels.untitled}</h3>
        {mode === 'preview' && project.status === 'draft' && <p class="text-sm text-conference-muted">{labels.draft}</p>}
        {project.lead && <p><span class="font-bold">{labels.lead}: </span>{project.lead}</p>}
        {project.description && <p class="whitespace-pre-line">{project.description}</p>}
        {project.skills.length > 0 && <div><h4 class="font-bold">{labels.skills}</h4><ul class="mt-2 list-disc space-y-1 pl-6">{project.skills.map(skill => <li>{skill}</li>)}</ul></div>}
        {project.contributions.length > 0 && <div><h4 class="font-bold">{labels.contributions}</h4><ul class="mt-2 list-disc space-y-1 pl-6">{project.contributions.map(contribution => <li>{contribution}</li>)}</ul></div>}
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          {project.repositoryUrl && <a href={project.repositoryUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center font-bold text-conference-blue underline underline-offset-4">{labels.repository}<span aria-hidden="true" class="ml-2">↗</span></a>}
          {project.setupUrl && <a href={project.setupUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center font-bold text-conference-blue underline underline-offset-4">{labels.setup}<span aria-hidden="true" class="ml-2">↗</span></a>}
        </div>
      </article>)}
    </section>}
  </>}

  {(mode === 'qa' || mode === 'preview') && <>
    {mode === 'preview' && <h2 class="text-xl font-bold text-conference-ink">{copy.titles.qa}</h2>}
    {content.qa.map(item => <article id={item.id} data-sprint-question class="rounded-xl border-2 border-conference-outline p-5"><h2 class="font-bold">{item.question}</h2><p class="mt-4 whitespace-pre-line">{item.answer}</p></article>)}
  </>}

  {deadlineLabel && <p><span class="font-bold">{labels.deadline}: </span><time datetime={content.proposalDeadline}>{deadlineLabel}</time> · {labels.time}</p>}
  <nav aria-label={copy.titles.sprint} class="flex flex-col items-start gap-4 border-t border-conference-outline/25 pt-6">
    {content.registrationUrl && <a data-sprint-registration href={content.registrationUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center rounded-full border-2 border-conference-outline bg-[#d71920] px-5 py-3 font-bold text-white">{copy.register}</a>}
    {content.proposalUrl && <a data-sprint-proposal href={content.proposalUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center font-bold text-conference-blue underline underline-offset-4">{copy.proposeSprint}</a>}
    {mode === 'sprint' && <a data-sprint-qa-link href={`/2026/${locale}/sprint/qna/`} class="inline-flex min-h-11 items-center gap-3 rounded-xl border-2 border-conference-blue px-5 py-3 font-bold text-conference-blue underline underline-offset-4">{copy.titles.qa}<span aria-hidden="true">→</span></a>}
    {mode === 'qa' && <a href={`/2026/${locale}/sprint/`} class="inline-flex min-h-11 items-center gap-2 font-bold text-conference-blue underline underline-offset-4"><span aria-hidden="true">←</span>{copy.titles.sprint}</a>}
  </nav>
</div>
