---
// Adapt the intersecting red checkerboard and blue threads in the 2026
// Key Visual into small vector corners, leaving partner artwork unobstructed.
// Reference: https://drive.google.com/file/d/1uIscGvNI5NC6AxKZ8eLourh2XaFF45u5/view
const cells = Array.from({ length: 24 }, (_, index) => index * 4);
const square = (x: number, y: number) => `M${x},${y}h4v4h-4Z`;
const redThread = cells.map((offset, index) => [
  square(offset, index % 2 ? 20 : 16),
  square(offset, index % 2 ? 28 : 24),
  square(index % 2 ? 20 : 16, offset),
  square(index % 2 ? 28 : 24, offset),
].join('')).join('');
const blueThread = cells.map((offset, index) => [
  square(index % 2 ? 40 : 36, offset),
  square(index % 2 ? 52 : 48, offset),
].join('')).join('');
---
{['left-0 top-0', 'bottom-0 right-0 rotate-180'].map((position) => (
  <svg viewBox="0 0 96 96" class:list={['pointer-events-none absolute h-20 w-20 text-[#d71920]', position]} fill="currentColor" aria-hidden="true" focusable="false">
    <path d={redThread} />
    <path d={blueThread} fill="#2f559a" />
  </svg>
))}
