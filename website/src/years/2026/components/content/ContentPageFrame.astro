---
import ConferenceLayout from '@/years/2026/layouts/ConferenceLayout.astro';
import type { CfpLocale } from '@/years/2026/locales';

interface Props { locale: CfpLocale; title: string; description?: string; lang?: string; }
const { locale, title, description = `${title} | PyCon HK 2026`, lang } = Astro.props;
---

<ConferenceLayout title={`${title} | PyCon HK 2026`} description={description} locale={locale}>
  <section lang={lang} class="bg-[#FAF7F0] px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <div class="mx-auto max-w-5xl rounded-3xl border-3 border-[#172033] bg-white p-6 shadow-[8px_8px_0_#172033] sm:p-10 lg:p-12">
      <h1 class="mb-8 text-center text-3xl font-black leading-tight text-[#172033] sm:text-4xl md:text-5xl">{title}</h1>
      <div class="space-y-6 text-base leading-relaxed text-slate-700"><slot /></div>
    </div>
  </section>
</ConferenceLayout>
