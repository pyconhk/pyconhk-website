---
import type { CfpLocale } from '@/years/2026/locales';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const copy = {
  en: {
    heading: 'Sprint Day extra ticket challenge',
    eligibility: 'Still need a Sprint Day ticket? The first 30 eligible applications receive a free ticket. If approved, you’ll receive your ticket by email from Eventbrite.',
    deadline: 'Submit your pull request by',
    deadlineDate: 'Saturday, 14 November 2026, 23:59 HKT (UTC+8)',
    instructions: 'Fix the Python report locally, then open a GitHub pull request containing only the generated encrypted proof file. Keep your contact details out of the pull request and its comments.',
    link: 'View the challenge on GitHub',
  },
  'zh-hk': {
    heading: 'Sprint Day 加開門票挑戰',
    eligibility: '仲未有 Sprint Day 門票？首 30 份符合資格嘅申請可獲免費門票。申請獲批後，Eventbrite 會用電郵寄出門票。',
    deadline: '提交 Pull Request 截止時間',
    deadlineDate: '2026 年 11 月 14 日（星期六）23:59 香港時間（UTC+8）',
    instructions: '喺自己部機修正 Python 報告，再開 GitHub Pull Request，只提交程式產生嘅加密證明檔案。請勿喺 Pull Request 內容或留言貼出聯絡資料。',
    link: '去 GitHub 睇挑戰詳情',
  },
  'zh-hant': {
    heading: 'Sprint Day 加開門票挑戰',
    eligibility: '還沒有 Sprint Day 門票嗎？前 30 份符合資格的申請可獲得免費門票。申請獲准後，Eventbrite 將透過電子郵件寄送門票。',
    deadline: '提交 Pull Request 截止時間',
    deadlineDate: '2026 年 11 月 14 日（星期六）23:59 香港時間（UTC+8）',
    instructions: '在本機修正 Python 報告，接著開啟 GitHub Pull Request，只提交程式產生的加密證明檔案。請勿在 Pull Request 內容或留言中公開聯絡資料。',
    link: '前往 GitHub 查看挑戰詳情',
  },
  'zh-hans': {
    heading: 'Sprint Day 加开门票挑战',
    eligibility: '还没有 Sprint Day 门票吗？前 30 份符合资格的申请可获得免费门票。申请获批后，Eventbrite 将通过电子邮件发送门票。',
    deadline: '提交 Pull Request 截止时间',
    deadlineDate: '2026 年 11 月 14 日（星期六）23:59 香港时间（UTC+8）',
    instructions: '在本地修正 Python 报告，然后发起 GitHub Pull Request，仅提交程序生成的加密证明文件。请勿在 Pull Request 正文或评论中公开联系方式。',
    link: '在 GitHub 查看挑战详情',
  },
  ja: {
    heading: 'Sprint Day 追加チケットチャレンジ',
    eligibility: 'Sprint Day のチケットをお持ちでない方へ。応募条件を満たした先着 30 件に無料チケットを提供します。応募が承認されると、Eventbrite からチケットがメールで届きます。',
    deadline: 'プルリクエストの提出期限',
    deadlineDate: '2026 年 11 月 14 日（土）23:59 香港時間（UTC+8）',
    instructions: '手元の環境で Python のレポートを修正し、生成された暗号化済みの証明ファイルだけを GitHub のプルリクエストで提出してください。プルリクエストの本文やコメントに連絡先を記載しないでください。',
    link: 'GitHub でチャレンジの詳細を見る',
  },
  ko: {
    heading: 'Sprint Day 추가 티켓 챌린지',
    eligibility: 'Sprint Day 티켓이 아직 없으신가요? 자격 요건을 충족한 선착순 30건에 무료 티켓을 발급합니다. 신청이 승인되면 Eventbrite에서 이메일로 티켓을 보내 드립니다.',
    deadline: '풀 리퀘스트 제출 마감',
    deadlineDate: '2026년 11월 14일(토) 23:59 홍콩 시간(UTC+8)',
    instructions: '로컬에서 Python 보고서를 수정한 뒤, 생성된 암호화 증명 파일만 담아 GitHub 풀 리퀘스트를 열어 주세요. 풀 리퀘스트 본문이나 댓글에 연락처를 공개하지 마세요.',
    link: 'GitHub에서 챌린지 자세히 보기',
  },
}[locale];
---

<section id="sprint-ticket-challenge" aria-labelledby="sprint-ticket-challenge-heading"
  class="scroll-mt-32 space-y-4 rounded-2xl border border-conference-blue/30 bg-conference-blue/5 p-5 sm:p-6">
  <h2 id="sprint-ticket-challenge-heading" class="text-xl font-bold text-conference-ink">{copy.heading}</h2>
  <p class="leading-relaxed">{copy.eligibility}</p>
  <p class="font-bold">{copy.deadline} · <time datetime="2026-11-14T23:59:00+08:00">{copy.deadlineDate}</time></p>
  <p class="leading-relaxed">{copy.instructions}</p>
  <a href="https://github.com/pyconhk/pyconhk-2026-sprint-challenge" target="_blank" rel="noopener noreferrer"
    class="inline-flex min-h-11 items-center gap-2 font-bold text-conference-blue underline underline-offset-4 focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-conference-blue">
    {copy.link}<span aria-hidden="true">↗</span>
  </a>
</section>
