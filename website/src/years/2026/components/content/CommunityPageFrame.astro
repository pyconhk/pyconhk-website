---
import ConferenceLayout from '@/years/2026/layouts/ConferenceLayout.astro';
import type { CfpLocale } from '@/years/2026/locales';

interface Props { locale: CfpLocale; title: string; subtitle: string; intro: string; }
const { locale, title, subtitle, intro } = Astro.props;
---

<ConferenceLayout title={`${title} | PyCon HK 2026`} description={intro} locale={locale}>
  <main class="bg-[#FAF7F0] px-4 py-10 sm:px-6 sm:py-16 lg:px-8">
    <div class="mx-auto max-w-5xl space-y-12 rounded-3xl border-3 border-[#172033] bg-white p-5 shadow-[6px_6px_0_#172033] sm:space-y-16 sm:p-10 sm:shadow-[8px_8px_0_#172033] md:p-14">
      <header class="mx-auto max-w-3xl space-y-4 text-center">
        <div class="inline-flex max-w-full items-center gap-2 rounded-full border-2 border-[#172033] bg-[#FAF7F0] px-3.5 py-1 text-xs font-black uppercase text-[#172033] shadow-[2px_2px_0_#172033]">
          <span class="h-2 w-2 shrink-0 rounded-full bg-[#d71920]" aria-hidden="true" />
          <span>{subtitle}</span>
        </div>
        <h1 class="font-operetta-32 text-3xl font-black uppercase leading-tight tracking-tight text-[#172033] sm:text-4xl md:text-5xl lg:text-6xl">{title}</h1>
        <p class="mx-auto max-w-2xl text-sm font-medium leading-relaxed text-slate-700 sm:text-base">{intro}</p>
      </header>
      <slot />
    </div>
  </main>
</ConferenceLayout>
