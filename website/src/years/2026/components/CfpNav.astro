---
import { preferredLocaleCookie } from '@/config/site';
import {
  type CfpLocale,
  contentByLocale,
  localeMetadata,
  sponsorshipUrl,
  submitProposalUrl,
  supportedLocales,
} from '@/years/2026/data/cfp';
import { privacyPolicyPath } from '@/years/2026/site';

interface Props {
  locale: CfpLocale;
  section?: 'home' | 'privacy';
}

const { locale, section = 'home' } = Astro.props;
const copy = contentByLocale[locale];

const pagePadding = 'px-5 sm:px-8 lg:px-14 xl:px-16';
const contentWidth = 'mx-auto max-w-7xl';
const navButtonBase =
  'inline-flex min-h-11 min-w-0 items-center justify-center rounded-full border-2 border-conference-outline px-2 py-2 text-center font-mono text-[0.8125rem] leading-tight font-black whitespace-nowrap text-conference-ink transition sm:px-4 sm:text-sm';

const compactHeaderLabels: Record<CfpLocale, { proposal: string; sponsor: string }> = {
  en: { proposal: 'Proposal', sponsor: 'Sponsor' },
  'zh-hk': { proposal: '提案', sponsor: '贊助' },
  'zh-hant': { proposal: '提案', sponsor: '贊助' },
  'zh-hans': { proposal: '提案', sponsor: '赞助' },
  ko: { proposal: '제안', sponsor: '후원' },
  ja: { proposal: 'プロポーザル', sponsor: 'スポンサー' },
};

function landingHref(item: CfpLocale) {
  return `/2026/${item}`;
}

function localeHref(item: CfpLocale) {
  if (section === 'privacy') {
    return privacyPolicyPath(item);
  }

  return `/2026/${item}`;
}

const compactLabels = compactHeaderLabels[locale];
---

<div class:list={['sticky top-0 z-[90] pt-3 pb-2 sm:pt-4 sm:pb-3', pagePadding]}>
  <nav
    class:list={[
      contentWidth,
      'flex flex-col gap-4 overflow-visible rounded-[1.75rem] border-2 border-conference-outline bg-conference-surface/90 p-4 shadow-conference-panel backdrop-blur sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8',
    ]}
  >
    <a
      href={landingHref(locale)}
      class="block min-w-0 space-y-1 rounded-2xl px-2 py-1 transition hover:bg-[#bfe8ff33] focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-conference-ink lg:max-w-[25rem] xl:max-w-[32rem]"
    >
      <p class="break-words font-mono text-base font-black text-conference-blue sm:text-lg xl:text-xl">
        {copy.nav.brand}
      </p>
      <p class="hidden break-words text-base leading-tight font-semibold text-conference-muted sm:block sm:text-lg lg:text-base xl:text-lg">
        {copy.nav.tagline}
      </p>
    </a>

    <div class="flex w-full flex-wrap items-center gap-2 lg:w-auto lg:shrink-0 lg:justify-end lg:gap-3">
      <div class="hidden items-center gap-1 rounded-full border-2 border-conference-outline bg-conference-sky px-3 py-2 font-mono text-xs font-black lg:flex">
        {
          supportedLocales.map((item) => (
            <a
              href={localeHref(item)}
              data-astro-reload
              aria-current={item === locale ? 'page' : undefined}
              class:list={[
                'rounded-full px-2 py-1 transition hover:bg-conference-surface/60',
                item === locale ? 'bg-conference-surface' : '',
              ]}
            >
              {localeMetadata[item].shortLabel}
            </a>
          ))
        }
      </div>

      <details class="relative z-[60] shrink-0 lg:hidden">
        <summary class="relative z-[70] cursor-pointer list-none rounded-full border-2 border-conference-outline bg-conference-sky px-3 py-2 font-mono text-sm font-black whitespace-nowrap [&::-webkit-details-marker]:hidden">
          {copy.localeMeta.shortLabel} +
        </summary>
        <div class="absolute left-0 z-[80] mt-2 grid w-44 gap-1 rounded-2xl border-2 border-conference-outline bg-conference-surface p-2 font-mono text-sm font-black shadow-conference-panel">
          {
            supportedLocales.map((item) => (
              <a
                href={localeHref(item)}
                data-astro-reload
                aria-current={item === locale ? 'page' : undefined}
                class:list={[
                  'rounded-xl px-3 py-2 transition hover:bg-conference-sky',
                  item === locale ? 'bg-conference-sky' : '',
                ]}
              >
                {localeMetadata[item].shortLabel}
              </a>
            ))
          }
        </div>
      </details>

      <a
        href={submitProposalUrl}
        target="_blank"
        rel="noreferrer"
        aria-label={copy.cta.submit}
        class:list={[navButtonBase, 'bg-conference-yellow']}
      >
        <span class="sm:hidden">{compactLabels.proposal}</span>
        <span class="hidden sm:inline">{copy.cta.submit}</span>
      </a>
      <a
        href={sponsorshipUrl}
        aria-label={copy.cta.sponsorship}
        class:list={[navButtonBase, 'bg-conference-surface']}
      >
        <span class="sm:hidden">{compactLabels.sponsor}</span>
        <span class="hidden sm:inline">{copy.cta.sponsorship}</span>
      </a>
    </div>
  </nav>
</div>

<script
  is:inline
  data-astro-rerun
  define:vars={{ cookieName: preferredLocaleCookie, currentLocale: locale }}
>
  document.cookie = `${cookieName}=${encodeURIComponent(currentLocale)}; path=/; max-age=31536000; SameSite=Lax`;
</script>
