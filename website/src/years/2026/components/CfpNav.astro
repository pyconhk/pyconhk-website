---
import {
  type CfpLocale,
  contentByLocale,
  localeMetadata,
  sponsorshipUrl,
  submitProposalUrl,
  supportedLocales,
} from '@/years/2026/data/cfp';

interface Props {
  locale: CfpLocale;
  section?: 'home' | 'privacy';
}

const { locale, section = 'home' } = Astro.props;
const copy = contentByLocale[locale];

const pagePadding = 'px-5 sm:px-8 lg:px-14 xl:px-16';
const contentWidth = 'mx-auto max-w-7xl';
const navButtonBase =
  'inline-flex min-h-11 min-w-0 items-center justify-center rounded-full border-2 border-[#172033] px-2 py-2 text-center font-mono text-[0.8125rem] leading-tight font-black whitespace-nowrap text-[#172033] transition hover:-translate-y-0.5 sm:px-4 sm:text-sm';

const compactHeaderLabels: Record<CfpLocale, { proposal: string; sponsor: string }> = {
  en: { proposal: 'Proposal', sponsor: 'Sponsor' },
  'zh-hk': { proposal: '提案', sponsor: '贊助' },
  'zh-hant': { proposal: '提案', sponsor: '贊助' },
  'zh-hans': { proposal: '提案', sponsor: '赞助' },
  ko: { proposal: '제안', sponsor: '후원' },
  ja: { proposal: 'プロポーザル', sponsor: 'スポンサー' },
};

function localeHref(item: CfpLocale) {
  if (section === 'privacy') {
    if (item === 'en') {
      return '/privacy-policy';
    }

    return `/${item === 'zh-hans' ? 'zh-cn' : item}/privacy-policy`;
  }

  return `/${item}`;
}

const compactLabels = compactHeaderLabels[locale];
---

<div class:list={['sticky top-0 z-[90] pt-3 pb-2 sm:pt-4 sm:pb-3', pagePadding]}>
  <nav
    class:list={[
      contentWidth,
      'flex flex-col gap-4 overflow-visible rounded-[1.75rem] border-2 border-[#172033] bg-white/90 p-4 shadow-[6px_8px_0_#17203314] backdrop-blur sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8',
    ]}
  >
    <div class="min-w-0 space-y-1 lg:max-w-[25rem] xl:max-w-[32rem]">
      <p class="break-words font-mono text-base font-black text-[#2b5b84] sm:text-lg xl:text-xl">
        {copy.nav.brand}
      </p>
      <p class="hidden break-words text-base leading-tight font-semibold text-[#586174] sm:block sm:text-lg lg:text-base xl:text-lg">
        {copy.nav.tagline}
      </p>
    </div>

    <div class="grid w-full grid-cols-[auto_minmax(0,1fr)_minmax(0,1fr)] items-center gap-2 lg:flex lg:w-auto lg:shrink-0 lg:justify-end lg:gap-3">
      <div class="hidden items-center gap-1 rounded-full border-2 border-[#172033] bg-[#bfe8ff] px-3 py-2 font-mono text-xs font-black lg:flex">
        {
          supportedLocales.map((item) => (
            <a
              href={localeHref(item)}
              aria-current={item === locale ? 'page' : undefined}
              class:list={[
                'rounded-full px-2 py-1 transition hover:bg-white/60',
                item === locale ? 'bg-white' : '',
              ]}
            >
              {localeMetadata[item].shortLabel}
            </a>
          ))
        }
      </div>

      <details class="relative z-[60] shrink-0 lg:hidden">
        <summary class="relative z-[70] cursor-pointer list-none rounded-full border-2 border-[#172033] bg-[#bfe8ff] px-3 py-2 font-mono text-sm font-black whitespace-nowrap [&::-webkit-details-marker]:hidden">
          {copy.localeMeta.shortLabel} +
        </summary>
        <div class="absolute left-0 z-[80] mt-2 grid w-44 gap-1 rounded-2xl border-2 border-[#172033] bg-white p-2 font-mono text-sm font-black shadow-[5px_6px_0_#17203322]">
          {
            supportedLocales.map((item) => (
              <a
                href={localeHref(item)}
                aria-current={item === locale ? 'page' : undefined}
                class:list={[
                  'rounded-xl px-3 py-2 transition hover:bg-[#bfe8ff]',
                  item === locale ? 'bg-[#bfe8ff]' : '',
                ]}
              >
                {localeMetadata[item].shortLabel}
              </a>
            ))
          }
        </div>
      </details>

      <a
        href={submitProposalUrl}
        target="_blank"
        rel="noreferrer"
        aria-label={copy.cta.submit}
        class:list={[navButtonBase, 'bg-[#ffd343]']}
      >
        <span class="sm:hidden">{compactLabels.proposal}</span>
        <span class="hidden sm:inline">{copy.cta.submit}</span>
      </a>
      <a
        href={sponsorshipUrl}
        aria-label={copy.cta.sponsorship}
        class:list={[navButtonBase, 'bg-white']}
      >
        <span class="sm:hidden">{compactLabels.sponsor}</span>
        <span class="hidden sm:inline">{copy.cta.sponsorship}</span>
      </a>
    </div>
  </nav>
</div>
