---
import { Image } from 'astro:assets';
import type { ScheduleItem } from '../../data/schedule';
import { scheduleCopy } from '../../data/schedule-copy';
import { sessionProfiles, speakerPath } from '../../data/speakers';
import type { CfpLocale } from '../../locales';
import { renderProgrammeMarkdown } from './programme-content.ts';

interface Props { session: ScheduleItem; locale: CfpLocale }
const { session, locale } = Astro.props;
const copy = scheduleCopy[locale];
const paragraphs = [session.abstract, session.description].filter((value, index, values) => value && values.indexOf(value) === index);
const description = await renderProgrammeMarkdown(paragraphs.join('\n\n'));
const profiles = await Promise.all(sessionProfiles(session)
  .map(async (person) => ({ ...person, bioHtml: await renderProgrammeMarkdown(person.biography) })));
---
<div class="space-y-6">
  {description && <section data-session-description>
    <h3 class="mb-4 text-xs font-black uppercase tracking-widest text-[#d71920]">{copy.description}</h3>
    <div class="programme-richtext prose prose-sm max-w-none text-slate-700" set:html={description} />
  </section>}
  {profiles.length > 0 && <section data-speaker-profiles>
    <h3 class="ideal-heading mb-4 text-xl font-black text-[#172033]">{copy.speakers}</h3>
    <div class="space-y-4">
      {profiles.map((person) => <article data-speaker-profile class="min-w-0 rounded-2xl border-2 border-[#172033] bg-[#FAF7F0] p-4 shadow-[4px_4px_0_#172033] sm:p-5">
        <div class="flex items-center gap-4">
          {person.avatar && <Image data-speaker-avatar src={person.avatar} alt={person.name} width={400} height={400} format="webp" loading="lazy" decoding="async" class="h-20 w-20 shrink-0 rounded-2xl border-2 border-[#172033] object-cover shadow-[3px_3px_0_#2f559a]" />}
          <h4 class="min-w-0 text-base font-black">
            <a data-speaker-link href={speakerPath(person, locale)} class="inline-flex min-h-11 items-center gap-2 underline underline-offset-4">{person.name}<span aria-hidden="true" class="text-[#d71920]">→</span></a>
          </h4>
        </div>
        {person.bioHtml && <div data-speaker-biography class="programme-richtext prose prose-sm mt-4 max-w-none text-slate-700" set:html={person.bioHtml} />}
      </article>)}
    </div>
  </section>}
</div>
<style>
  .programme-richtext { overflow-wrap: anywhere; }
  .programme-richtext :global(pre) { max-width: 100%; overflow-x: auto; }
  .programme-richtext :global(img) { max-width: 100%; height: auto; }
</style>
