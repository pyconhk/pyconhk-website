---
import { scheduleCopy } from '../../data/schedule-copy';
import type { CfpLocale } from '../../locales';

interface Props { locale: CfpLocale }
const copy = scheduleCopy[Astro.props.locale];
---
<dialog id="session-modal" aria-labelledby="modal-session-title" class="m-auto w-[calc(100%_-_2rem)] max-w-2xl max-h-[85vh] rounded-3xl border-2 border-[#172033] bg-white p-0 text-[#172033] shadow-[8px_8px_0_#172033] backdrop:bg-slate-900/60">
  <div class="modal-heading flex items-start justify-between gap-4 border-b-2 border-[#172033]/15 bg-[#FAF7F0] p-5">
    <p class="font-black">{copy.details}</p>
    <form method="dialog"><button type="submit" class="rounded-xl border-2 border-[#172033] bg-white px-3 py-2 text-sm font-bold" aria-label={copy.close}>{copy.close}</button></form>
  </div>
  <div class="space-y-5 p-5">
    <h2 id="modal-session-title" class="text-xl font-black"></h2>
    <dl class="grid gap-3 text-sm sm:grid-cols-2">
      <div><dt class="font-bold text-slate-500">{copy.time}</dt><dd id="modal-time"></dd></div>
      <div><dt class="font-bold text-slate-500">{copy.room}</dt><dd id="modal-room"></dd></div>
      <div data-modal-speakers><dt class="font-bold text-slate-500">{copy.speakers}</dt><dd id="modal-speakers"></dd></div>
    </dl>
    <section><h3 class="mb-2 font-bold">{copy.description}</h3><p id="modal-description" class="whitespace-pre-wrap break-words text-sm leading-relaxed text-slate-700"></p></section>
    <div class="flex flex-wrap gap-3 border-t border-slate-200 pt-4">
      <button type="button" data-modal-save class="rounded-xl border-2 border-[#172033] bg-[#FAF7F0] px-4 py-2 text-sm font-bold" aria-pressed="false">{copy.save}</button>
      <a href="https://calendar.google.com/calendar/" data-modal-calendar class="rounded-xl border-2 border-[#172033] bg-[#2f559a] px-4 py-2 text-sm font-bold text-white" target="_blank" rel="noopener noreferrer">{copy.calendar}</a>
      <a href="https://pretalx.com/" data-modal-source class="px-2 py-2 text-sm font-bold underline" target="_blank" rel="noopener noreferrer">{copy.source}</a>
    </div>
  </div>
</dialog>

<style>
  dialog { max-height: calc(100dvh - 2rem); overflow-wrap: anywhere; }
  dialog[open] { display: flex; flex-direction: column; }
  .modal-heading { flex: 0 0 auto; max-height: 40dvh; min-height: 0; overflow-y: auto; }
  .modal-heading p { min-width: 0; }
  .modal-heading form { position: sticky; top: 0; flex-shrink: 0; }
  .modal-heading + div { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; }
  button, a { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; }
  @media (max-width: 639px), (max-height: 500px) {
    .modal-heading, .modal-heading + div { padding: 1rem; }
  }
</style>
