---
interface Props {
  heightClass?: string;
  className?: string;
}

const { heightClass = 'h-3 sm:h-3.5', className = '' } = Astro.props;
---

<div class:list={['w-full overflow-hidden shrink-0 select-none', heightClass, className]} aria-hidden="true">
  <svg class="w-full h-full" preserveAspectRatio="none" viewBox="0 0 240 14" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <title>Woven ribbon decorative border</title>
    <defs>
      <pattern id="rwb-ribbon-unit" width="24" height="14" patternUnits="userSpaceOnUse">
        <rect x="0" y="0" width="3" height="14" fill="#2f559a" />
        <rect x="1" y="0" width="1" height="14" fill="#ffffff" />
        <rect x="3" y="0" width="2" height="14" fill="#ffffff" />
        <rect x="5" y="0" width="14" height="14" fill="#d71920" />
        <rect x="5" y="2" width="14" height="2" fill="#ffffff" />
        <rect x="5" y="6" width="14" height="2" fill="#ffffff" />
        <rect x="5" y="10" width="14" height="2" fill="#ffffff" />
        <rect x="19" y="0" width="2" height="14" fill="#ffffff" />
        <rect x="21" y="0" width="3" height="14" fill="#2f559a" />
        <rect x="22" y="0" width="1" height="14" fill="#ffffff" />
      </pattern>
    </defs>
    <rect width="240" height="14" fill="url(#rwb-ribbon-unit)" />
  </svg>
</div>
