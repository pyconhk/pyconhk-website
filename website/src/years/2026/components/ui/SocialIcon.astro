---
import { Icon } from 'astro-icon/components';

interface Props { name: string; }
const { name } = Astro.props;
const iconClass = 'h-7 w-7 shrink-0 text-conference-ink';
---
{name === 'substack' ? (
  // Substack artwork from Simple Icons; the installed Font Awesome set has no Substack icon.
  <svg viewBox="0 0 24 24" class={iconClass} fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z" />
  </svg>
) : (
  <Icon name={name} class={iconClass} aria-hidden="true" focusable="false" />
)}
