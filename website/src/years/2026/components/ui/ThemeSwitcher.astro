---
import type { CfpLocale } from '../../locales';

interface Props { locale: CfpLocale }
const copy = {
  en: { label: 'Appearance', system: 'System', light: 'Light', dark: 'Dark', next: 'Switch to' },
  'zh-hk': { label: '顯示模式', system: '跟系統', light: '淺色', dark: '深色', next: '切換至' },
  'zh-hant': { label: '顯示模式', system: '跟隨系統', light: '淺色', dark: '深色', next: '切換至' },
  'zh-hans': { label: '显示模式', system: '跟随系统', light: '浅色', dark: '深色', next: '切换至' },
  ja: { label: '表示モード', system: 'システム', light: 'ライト', dark: 'ダーク', next: '切り替え先' },
  ko: { label: '화면 모드', system: '시스템', light: '라이트', dark: '다크', next: '다음 모드' },
}[Astro.props.locale];
const label = `${copy.label}: ${copy.system}. ${copy.next}: ${copy.light}`;
---
<button
  type="button"
  data-theme-toggle
  data-theme-mode="system"
  data-theme-label={copy.label}
  data-theme-system={copy.system}
  data-theme-light={copy.light}
  data-theme-dark={copy.dark}
  data-theme-next-label={copy.next}
  aria-label={label}
  title={label}
  class="relative flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-full border-2 border-conference-outline bg-conference-surface text-conference-ink shadow-conference-control hover:bg-conference-soft"
>
  <svg data-theme-icon="system" class="h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="4" width="18" height="13" rx="2" />
    <path d="M8 21h8m-4-4v4" />
  </svg>
  <svg data-theme-icon="light" class="h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
  </svg>
  <svg data-theme-icon="dark" class="h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" />
  </svg>
</button>
<style>
  button:focus-visible { outline: 3px solid var(--conference-blue); outline-offset: 4px; }
  [data-theme-icon] { display: none; }
  [data-theme-mode='system'] [data-theme-icon='system'],
  [data-theme-mode='light'] [data-theme-icon='light'],
  [data-theme-mode='dark'] [data-theme-icon='dark'] { display: block; }
</style>
