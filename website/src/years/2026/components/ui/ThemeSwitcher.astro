---
import type { CfpLocale } from '../../locales';

interface Props { locale: CfpLocale }
const copy = {
  en: { label: 'Appearance', system: 'System', light: 'Light', dark: 'Dark' },
  'zh-hk': { label: '顯示模式', system: '跟系統', light: '淺色', dark: '深色' },
  'zh-hant': { label: '顯示模式', system: '跟隨系統', light: '淺色', dark: '深色' },
  'zh-hans': { label: '显示模式', system: '跟随系统', light: '浅色', dark: '深色' },
  ja: { label: '表示モード', system: 'システム', light: 'ライト', dark: 'ダーク' },
  ko: { label: '화면 모드', system: '시스템', light: '라이트', dark: '다크' },
}[Astro.props.locale];
---
<label class="relative flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-2 border-conference-outline bg-conference-surface text-conference-ink shadow-[2px_2px_0_var(--conference-shadow)] hover:bg-conference-soft" title={copy.label}>
  <span class="sr-only">{copy.label}</span>
  <svg class="h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="9" />
    <path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor" stroke="none" />
  </svg>
  <select data-theme-select aria-label={copy.label} class="absolute inset-0 h-full w-full cursor-pointer opacity-0">
    <option value="system">{copy.system}</option>
    <option value="light">{copy.light}</option>
    <option value="dark">{copy.dark}</option>
  </select>
</label>
<style>
  label:has(select:focus-visible) { outline: 3px solid var(--conference-blue); outline-offset: 4px; }
  option { background: var(--conference-surface); color: var(--conference-ink); }
</style>
