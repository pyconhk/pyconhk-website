---
import { explorationCopy } from '@/years/2026/data/exploration';
import type { CfpLocale } from '@/years/2026/locales';

interface Props { locale: CfpLocale; }
const { locale } = Astro.props;
const copy = explorationCopy[locale];
---

<a data-home-quick-links href={`/2026/${locale}/exploration/`} class="inline-flex min-h-11 items-center justify-center rounded-full border-2 border-conference-outline bg-conference-surface px-5 py-3 font-bold text-conference-ink transition-colors hover:bg-conference-soft focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-conference-blue">{copy.title}</a>
