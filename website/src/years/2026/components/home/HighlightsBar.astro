---
import { getTranslations } from '@/years/2026/i18n';
import type { CfpLocale } from '@/years/2026/locales';

interface Props {
  locale: CfpLocale;
}
const { locale } = Astro.props;
const t = getTranslations(locale);
---
<section class="w-full bg-[#111827] py-8 sm:py-10 text-white border-y-2 border-[#172033]" id="about">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 lg:gap-12">
      {t.highlights.map((item) => (
        <div class="flex items-start gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/10 text-[#ffd343] border border-white/15">
            {item.icon === 'mic' && (
              <svg class="h-5 w-5 text-[#ff8080]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <title>Microphone icon</title>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
            )}
            {item.icon === 'calendar' && (
              <svg class="h-5 w-5 text-[#ffd343]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <title>Calendar icon</title>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            )}
            {item.icon === 'pin' && (
              <svg class="h-5 w-5 text-[#85b6ff]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <title>Location pin icon</title>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            )}
          </div>
          <div class="space-y-1">
            <h3 class="font-bold text-base sm:text-lg text-white">
              {item.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-normal">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
