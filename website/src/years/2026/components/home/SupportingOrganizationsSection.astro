---
import { getConferenceContent } from '@/lib/conference-content';
import OrganizationLogo from '@/years/2026/components/content/OrganizationLogo.astro';
import { contentUi } from '@/years/2026/data/content-ui';
import { pageCopyByLocale } from '@/years/2026/data/supporting-organizations';
import type { CfpLocale } from '@/years/2026/locales';

interface Props { locale: CfpLocale; }
const { locale } = Astro.props;
const { organizations } = getConferenceContent(locale);
const items = organizations.items.filter((item) => item.kind === 'supporter');
const copy = pageCopyByLocale[locale];
const detailsHref = `/2026/${locale}/supporting-organizations/`;
// Preserve the supplied artwork's original colours and the plates used on the full page.
const logoBackgrounds: Record<string, string> = {
  '/2026/supporting-organizations/hku-csa.png': '#000000',
  '/2026/supporting-organizations/codeaholics.webp': '#000000',
  '/2026/supporting-organizations/DimSumLab.webp': '#e11f30',
  '/2026/supporting-organizations/pyladies_tokyo.webp': 'linear-gradient(#f8c8ca, #ffd5d4)',
};
---

{organizations.status === 'published' && items.length > 0 && (
  <section id="supporting-organizations" data-home-supporters aria-labelledby="home-supporters-title" class="scroll-mt-32 bg-conference-paper px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <div class="mx-auto max-w-6xl text-center">
      <h2 id="home-supporters-title" class="text-3xl font-black text-conference-ink sm:text-4xl">{copy.title}</h2>
      <div aria-hidden="true" class="mx-auto mt-5 flex h-1 w-24"><span class="flex-1 bg-[#d71920]" /><span class="flex-1 bg-white" /><span class="flex-1 bg-[#2f559a]" /></div>
      <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-5 lg:gap-5">
        {items.map((item) => {
          const Tag = item.url ? 'a' : 'div';
          return <li class="min-w-0">
            <Tag href={item.url || undefined} target={item.url ? '_blank' : undefined} rel={item.url ? 'noopener noreferrer' : undefined} aria-label={item.url ? `${copy.visitWebsite}: ${item.name}` : undefined} style={logoBackgrounds[item.logo] ? `--organization-logo-background: ${logoBackgrounds[item.logo]}` : undefined} data-home-supporter={item.id} class="home-logo-plate flex h-44 w-full items-center justify-center overflow-hidden rounded-xl border border-conference-outline/25 p-3 shadow-conference-card motion-safe:transition-transform motion-safe:duration-150 motion-safe:hover:-translate-y-0.5 focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-conference-blue">
              {item.logo && <OrganizationLogo src={item.logo} alt={item.url ? '' : item.name} />}
            </Tag>
          </li>;
        })}
      </ul>
      <a href={detailsHref} class="mt-8 inline-flex min-h-11 items-center gap-2 py-2 text-base font-bold text-conference-blue underline-offset-4 hover:underline focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-conference-blue">
        {contentUi[locale].titles.supporters}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
)}

<style>
  .home-logo-plate { background: var(--organization-logo-background, var(--conference-logo-plate)); color-scheme: light; }
</style>
