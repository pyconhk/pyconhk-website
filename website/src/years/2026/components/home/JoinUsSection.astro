---
import { contentUi } from '@/years/2026/data/content-ui';
import { getTranslations } from '@/years/2026/i18n';
import type { CfpLocale } from '@/years/2026/locales';

interface Props { locale: CfpLocale; }
const { locale } = Astro.props;
const t = getTranslations(locale);
const copy = contentUi[locale];
---

<section id="participate" class="bg-conference-paper px-4 py-12 sm:px-6 sm:py-16 lg:px-8" aria-labelledby="participate-title">
  <div class="mx-auto max-w-6xl">
    <h2 id="participate-title" class="text-center text-3xl font-black text-conference-ink sm:text-4xl">{t.joinUs.eyebrow}</h2>
    <div class="mx-auto mt-5 flex h-1 w-24" aria-hidden="true"><span class="flex-1 bg-[#d71920]"></span><span class="flex-1 bg-white"></span><span class="flex-1 bg-[#2f559a]"></span></div>
    <p class="mx-auto mt-6 max-w-2xl text-center text-base leading-relaxed text-conference-body sm:text-lg">{t.joinUs.description}</p>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <a data-astro-prefetch="viewport" aria-labelledby="join-sprint-title" href={`/2026/${locale}/sprint/`} class="group flex flex-col gap-4 rounded-2xl border border-conference-outline/40 border-t-4 border-t-[#2f559a] bg-conference-surface p-6 sm:p-8 shadow-conference-card hover:bg-conference-soft focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-conference-blue">
        <h3 id="join-sprint-title" class="flex items-center justify-between gap-6 text-xl font-bold text-conference-ink group-hover:underline underline-offset-4">{copy.titles.sprint}<span aria-hidden="true">→</span></h3>
        <p class="text-base leading-relaxed text-conference-body">{t.joinUs.sprintDescription}</p>
      </a>
      <a data-astro-prefetch="viewport" aria-labelledby="join-sponsor-title" href={`/2026/${locale}/sponsorships/opportunities/`} class="group flex flex-col gap-4 rounded-2xl border border-conference-outline/40 border-t-4 border-t-[#d71920] bg-conference-surface p-6 sm:p-8 shadow-conference-card hover:bg-conference-soft focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-conference-blue">
        <h3 id="join-sponsor-title" class="flex items-center justify-between gap-6 text-xl font-bold text-conference-ink group-hover:underline underline-offset-4">{t.sponsors.prospectusCta}<span aria-hidden="true">→</span></h3>
        <p class="text-base leading-relaxed text-conference-body">{t.joinUs.sponsorDescription}</p>
      </a>
    </div>
  </div>
</section>
