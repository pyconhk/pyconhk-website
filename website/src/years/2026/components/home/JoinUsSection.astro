---
import { contentUi } from '@/years/2026/data/content-ui';
import { getTranslations } from '@/years/2026/i18n';
import type { CfpLocale } from '@/years/2026/locales';

interface Props { locale: CfpLocale; }
const { locale } = Astro.props;
const t = getTranslations(locale);
const copy = contentUi[locale];
---

<section id="participate" class="bg-conference-paper px-4 py-12 sm:px-6 sm:py-16 lg:px-8" aria-labelledby="participate-title">
  <div class="mx-auto max-w-6xl">
    <h2 id="participate-title" class="text-center text-3xl font-black text-conference-ink sm:text-4xl">{t.joinUs.eyebrow}</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <a href={`/2026/${locale}/sprint/`} class="flex min-h-24 items-center justify-between gap-6 rounded-2xl border border-conference-outline/40 border-t-4 border-t-[#2f559a] bg-conference-surface p-6 text-xl font-bold text-conference-ink shadow-conference-card hover:bg-conference-soft">
        <span>{copy.titles.sprint}</span><span aria-hidden="true">→</span>
      </a>
      <a href={`/2026/${locale}/sponsorships/opportunities/`} class="flex min-h-24 items-center justify-between gap-6 rounded-2xl border border-conference-outline/40 border-t-4 border-t-[#d71920] bg-conference-surface p-6 text-xl font-bold text-conference-ink shadow-conference-card hover:bg-conference-soft">
        <span>{t.sponsors.prospectusCta}</span><span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
