---
import { getTranslations } from '@/years/2026/i18n';
import type { CfpLocale } from '@/years/2026/locales';
import { registrationUrl } from '@/years/2026/site';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section class="py-16 sm:py-24 bg-[#FAF7F0]">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="overflow-hidden rounded-3xl border-3 border-[#172033] bg-white shadow-[10px_10px_0_#172033] grid grid-cols-1 md:grid-cols-12">
      <!-- Left Side (White) -->
      <div class="md:col-span-7 p-8 sm:p-12 lg:p-14 flex flex-col justify-between space-y-8">
        <div class="space-y-4">
          <p class="text-xs font-black uppercase tracking-widest text-[#d71920]">
            {t.joinUs.eyebrow}
          </p>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-[#172033] tracking-tight leading-tight">
            {t.joinUs.title}
          </h2>
          <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-medium">
            {t.joinUs.description}
          </p>
        </div>

        <div>
          <a
            href={registrationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex h-12 w-12 items-center justify-center rounded-full bg-[#1D4486] text-white border-2 border-[#172033] shadow-[3px_3px_0_#172033] transition-all hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-none hover:bg-[#16325C]"
            aria-label={t.joinUs.ctaAria}
          >
            <svg class="h-5 w-5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 20 20" fill="currentColor">
              <title>Arrow Up Right</title>
              <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Side (Vibrant Red) -->
      <div class="md:col-span-5 bg-[#d71920] p-8 sm:p-12 text-white border-t-2 md:border-t-0 md:border-l-2 border-[#172033] flex flex-col justify-between space-y-6">
        <div>
          <h3 class="text-xs font-black uppercase tracking-widest text-white/90">
            {t.joinUs.atAGlanceTitle}
          </h3>

          <div class="mt-6 space-y-6">
            <div>
              <p class="text-xs font-black uppercase tracking-wider text-white/70">
                {t.joinUs.datesLabel}
              </p>
              <p class="mt-1 text-lg sm:text-xl font-black text-white">
                {t.joinUs.datesValue}
              </p>
            </div>

            <div>
              <p class="text-xs font-black uppercase tracking-wider text-white/70">
                {t.joinUs.locationLabel}
              </p>
              <p class="mt-1 text-lg sm:text-xl font-black text-white">
                {t.joinUs.locationValue}
              </p>
            </div>

            <div class="pt-2 border-t border-white/20">
              <p class="text-xs font-black uppercase tracking-wider text-[#ffd343]">
                {t.joinUs.stayTunedLabel}
              </p>
              <p class="mt-1 text-xs sm:text-sm text-white/90 leading-relaxed font-medium">
                {t.joinUs.stayTunedValue}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
