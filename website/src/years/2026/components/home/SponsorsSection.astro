---
import { getConferenceContent } from '@/lib/conference-content';
import { contentUi } from '@/years/2026/data/content-ui';
import { getTranslations } from '@/years/2026/i18n';
import type { CfpLocale } from '@/years/2026/locales';
import { sponsorshipEmail } from '@/years/2026/site';

interface Props { locale: CfpLocale; }
const { locale } = Astro.props;
const { sponsors } = getConferenceContent(locale);
const t = getTranslations(locale);
const copy = contentUi[locale];
---
<section class="border-t border-conference-outline/10 bg-conference-paper py-16 sm:py-24" id="sponsors">
  <div class="mx-auto max-w-6xl px-4 text-center sm:px-6 lg:px-8">
    <h2 class="text-3xl font-extrabold text-conference-ink sm:text-4xl">{copy.titles.sponsors}</h2>
    <p class="mx-auto mt-4 max-w-3xl leading-relaxed text-conference-body">{t.sponsors.description}</p>
    {sponsors.status === 'published' && sponsors.items.length > 0 && (
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-published-sponsors>
        {sponsors.items.map((sponsor) => <article class="space-y-4 rounded-2xl border-2 border-conference-outline bg-conference-surface p-6 shadow-[4px_4px_0_var(--conference-shadow)]"><p class="text-sm font-bold text-conference-red">{sponsor.tier}</p>{sponsor.logo && <img src={sponsor.logo} alt={sponsor.name} width="320" height="180" class="h-28 w-full object-contain" loading="lazy" />}<h3 class="font-bold">{sponsor.name}</h3>{sponsor.url && <a href={sponsor.url} target="_blank" rel="noopener noreferrer" class="text-conference-blue underline">{copy.visitWebsite}</a>}</article>)}
      </div>
    )}
    <a href={sponsorshipEmail} class="mt-10 inline-flex rounded-full border-2 border-conference-outline bg-conference-surface px-6 py-3 font-bold text-conference-ink shadow-[4px_4px_0_var(--conference-shadow)]">{copy.sponsorship}</a>
  </div>
</section>
