---
import { getConferenceContent } from '@/lib/conference-content';
import SponsorWall from '@/years/2026/components/content/SponsorWall.astro';
import { contentUi } from '@/years/2026/data/content-ui';
import type { CfpLocale } from '@/years/2026/locales';

interface Props { locale: CfpLocale; }
const { locale } = Astro.props;
const { sponsors } = getConferenceContent(locale);
const copy = contentUi[locale];
---
{sponsors.status === 'published' && sponsors.items.length > 0 && (
<section class="border-t border-conference-outline/10 bg-conference-paper py-16 sm:py-24" id="sponsors">
  <div class="mx-auto max-w-6xl px-4 text-center sm:px-6 lg:px-8">
    <h2 class="text-3xl font-extrabold text-conference-ink sm:text-4xl">{copy.titles.sponsors}</h2>
    <div aria-hidden="true" class="mx-auto mt-5 flex h-1 w-20 gap-1"><span class="flex-1 bg-[#e31923]" /><span class="flex-1 bg-[#345998]" /></div>
    <div class="mt-8 sm:mt-10" data-published-sponsors><SponsorWall items={sponsors.items} /></div>
  </div>
</section>
)}
