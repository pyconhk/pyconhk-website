---
import { Icon } from 'astro-icon/components';
import { getConferenceContent } from '@/lib/conference-content';
import RegistrationButton from '@/years/2026/components/ui/RegistrationButton.astro';
import { contentUi } from '@/years/2026/data/content-ui';
import { getTranslations } from '@/years/2026/i18n';
import type { CfpLocale } from '@/years/2026/locales';

interface Props { locale: CfpLocale; }
const { locale } = Astro.props;
const t = getTranslations(locale);
const { event } = getConferenceContent(locale);
---

<section id="home" class="home-hero relative isolate flex flex-col items-center justify-center overflow-hidden px-4 py-12 text-center sm:px-6 sm:py-16" aria-labelledby="home-title">
  <img src="/2026/logos/horse-mark.svg" alt="" width="608" height="200" class="relative h-auto w-full max-w-xl object-contain" fetchpriority="high" />
  <h1 id="home-title" class="relative mt-8 font-operetta-32 text-4xl font-black tracking-tight text-conference-ink sm:text-6xl lg:text-7xl">{event.status === 'published' ? event.title : t.nav.brand}</h1>
  <p class="relative mt-5 max-w-3xl bg-[#2f559a] px-6 py-2 text-xl font-bold text-white sm:text-2xl">{event.status === 'published' ? event.theme : t.hero.headline}</p>
  <p class="relative mt-5 text-base font-semibold text-conference-body sm:text-lg">{event.status === 'published' ? event.datesLabel : t.hero.whenValue}</p>
  <div class="relative mt-8 flex flex-col items-center gap-4 sm:gap-5">
    <RegistrationButton locale={locale} />
    <a href={`/2026/${locale}/schedule/`} class="inline-flex min-h-12 items-center justify-center rounded-full border-2 border-conference-outline bg-[#2f559a] px-7 py-3 font-bold text-white shadow-[3px_3px_0_var(--conference-shadow)] hover:bg-[#244578]">{t.schedule.heroTitle}</a>
  </div>
  <a href="#featured-speakers" class="relative mt-10 inline-flex min-h-11 items-center gap-2 rounded-full border border-conference-outline/30 bg-conference-surface px-5 py-2 text-sm font-semibold text-conference-blue hover:border-conference-blue">{contentUi[locale].speakers}<Icon name="heroicons-outline:chevron-down" class="h-4 w-4" aria-hidden="true" /></a>
</section>

<style>
  .home-hero {
    min-height: calc(100svh - 7rem);
    background: var(--conference-paper);
  }
  .home-hero::before {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 5rem;
    z-index: -1;
    border-top: 1px solid var(--conference-line);
    background: repeating-linear-gradient(90deg, transparent 0 64px, #2f559a 64px 66px, transparent 66px 70px, #2f559a 70px 72px, transparent 72px 144px), repeating-linear-gradient(0deg, transparent 0 8px, #d71920 8px 10px, transparent 10px 14px);
    opacity: .12;
  }
</style>
