---
import { getConferenceContent } from '@/lib/conference-content';
import RegistrationButton from '@/years/2026/components/ui/RegistrationButton.astro';
import { getTranslations } from '@/years/2026/i18n';
import type { CfpLocale } from '@/years/2026/locales';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const content = getConferenceContent(locale);
---

<section class="relative overflow-hidden pt-8 pb-16 sm:pt-12 sm:pb-24 lg:pt-16 lg:pb-28">
  <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
    <!-- 1. Top Pill Badge (Fade Entrance Step 1) -->
    <div class="hero-fade-1 inline-flex items-center gap-2 rounded-full border-2 border-[#172033] bg-white px-4 py-1.5 text-xs font-black uppercase tracking-wider text-[#172033] shadow-[3px_3px_0_#172033] mb-8">
      <span class="inline-block h-2 w-2 rounded-full bg-[#d71920]" />
      <span>{t.hero.badge}</span>
    </div>

    <!-- Center Elevated Hero Logo Card Wrapper with Static Background Streamers -->
    <div class="relative w-full max-w-2xl flex items-center justify-center">
      <!-- Dynamic Background Streamers (Always static & visible without animation) -->
      <div class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 -z-10 w-[1900px] h-[400px] overflow-hidden flex items-center justify-center" aria-hidden="true">
        <svg
          class="w-full h-full"
          viewBox="0 0 1900 400"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <title>Dynamic Background Streamers</title>
          <!-- Upper Red Sweeping Curves -->
          <path
            d="M-50,140 C380,10 820,310 1950,70"
            stroke="#d71920"
            stroke-width="18"
            stroke-linecap="round"
          />
          <path
            d="M-50,175 C420,45 870,345 1950,105"
            stroke="#d71920"
            stroke-width="6"
            stroke-linecap="round"
          />

          <!-- Lower Blue Sweeping Curves -->
          <path
            d="M-50,230 C450,370 1120,60 1950,220"
            stroke="#2f559a"
            stroke-width="20"
            stroke-linecap="round"
          />
          <path
            d="M-50,265 C490,405 1160,95 1950,255"
            stroke="#2f559a"
            stroke-width="7"
            stroke-linecap="round"
          />
        </svg>
      </div>

      <!-- 2. Center Elevated Hero Logo Card (Fade Entrance Step 2) -->
      <div class="hero-fade-2 w-full rounded-3xl border-3 border-[#172033] bg-white p-6 sm:p-10 shadow-[10px_10px_0_#2f559a] transition-transform hover:-translate-y-1 hover:shadow-[12px_12px_0_#2f559a]">
        <img
          src="/2026/logos/pyconlogo.svg"
          alt="PyCon HK 2026 Logo"
          width="608"
          height="276"
          class="mx-auto h-auto max-h-56 sm:max-h-64 w-full object-contain"
          loading="eager"
        />
      </div>
    </div>

    <!-- 3. Main Title & Subtitle (Fade Entrance Step 3) -->
    <div class="hero-fade-3 mt-10 sm:mt-12 max-w-4xl space-y-4">
      <h1 class="ideal-heading text-2xl sm:text-4xl md:text-5xl lg:text-[3.75rem] font-extrabold tracking-[-0.03em] leading-normal text-[#141718]">
        {content.event.status === 'published' ? content.event.theme : t.hero.headline}
      </h1>
      {t.hero.headlineAccent && (
        <p class="text-xl sm:text-2xl font-bold text-[#d71920]">
          {t.hero.headlineAccent}
        </p>
      )}
      <p class="text-base sm:text-lg lg:text-xl text-slate-700 font-medium max-w-2xl mx-auto leading-relaxed">
        {t.hero.subheadline}
      </p>
    </div>

    <!-- 4. Hero Action Buttons (Fade Entrance Step 4) -->
    <div class="hero-fade-4 mt-8 flex flex-wrap items-center justify-center gap-4">
      <RegistrationButton locale={locale} />

      <a
        href="https://calendar.google.com/calendar/render?action=TEMPLATE&amp;text=PyCon%20HK%202026&amp;dates=20261114/20261116&amp;ctz=Asia%2FHong_Kong"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex h-13 w-13 items-center justify-center rounded-full bg-white dark:bg-[#131b2e] text-[#172033] dark:text-white border-2 border-[#172033] dark:border-slate-700 transition-all hover:scale-105 hover:bg-slate-50 dark:hover:bg-slate-800"
        aria-label={t.hero.calendarCta}
        title={t.hero.calendarCta}
      >
        <svg class="h-6 w-6 transition-transform group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <title>Add to Calendar</title>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </a>
    </div>

    <!-- 5. At a Glance 3-Column Info Strip (Fade Entrance Step 5) -->
    <div class="hero-fade-5 mt-10 sm:mt-14 w-full max-w-3xl rounded-2xl border-2 border-[#172033] bg-white p-5 sm:p-6 shadow-[6px_6px_0_#172033]">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-0 divide-y sm:divide-y-0 sm:divide-x divide-[#172033]/15 text-left">
        <div class="sm:px-4 sm:first:pl-0">
          <p class="text-xs font-black uppercase tracking-wider text-[#2f559a]">{t.hero.whenLabel}</p>
          <p class="mt-1 text-sm sm:text-base font-bold text-[#172033]">{content.event.status === 'published' ? content.event.datesLabel : t.hero.whenValue}</p>
        </div>
        <div class="pt-3 sm:pt-0 sm:px-4">
          <p class="text-xs font-black uppercase tracking-wider text-[#2f559a]">{t.hero.whereLabel}</p>
          <p class="mt-1 text-sm sm:text-base font-bold text-[#172033]">{content.venue.status === 'published' ? content.venue.title : t.hero.whereValue}</p>
        </div>
        <div class="pt-3 sm:pt-0 sm:px-4 sm:last:pr-0">
          <p class="text-xs font-black uppercase tracking-wider text-[#2f559a]">{t.hero.forLabel}</p>
          <p class="mt-1 text-sm sm:text-base font-bold text-[#172033]">{t.hero.forValue}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes heroEntranceFade {
    0% {
      opacity: 0;
      transform: translateY(22px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-fade-1 {
    animation: heroEntranceFade 0.75s cubic-bezier(0.16, 1, 0.3, 1) both 0.04s;
  }
  .hero-fade-2 {
    animation: heroEntranceFade 0.8s cubic-bezier(0.16, 1, 0.3, 1) both 0.14s;
  }
  .hero-fade-3 {
    animation: heroEntranceFade 0.85s cubic-bezier(0.16, 1, 0.3, 1) both 0.26s;
  }
  .hero-fade-4 {
    animation: heroEntranceFade 0.85s cubic-bezier(0.16, 1, 0.3, 1) both 0.38s;
  }
  .hero-fade-5 {
    animation: heroEntranceFade 0.85s cubic-bezier(0.16, 1, 0.3, 1) both 0.50s;
  }
</style>
