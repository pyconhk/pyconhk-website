---
import { getTranslations } from '@/years/2026/i18n';
import type { CfpLocale } from '@/years/2026/locales';
import { registrationUrl } from '@/years/2026/site';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section class="relative overflow-hidden pt-8 pb-16 sm:pt-12 sm:pb-24 lg:pt-16 lg:pb-28">
  <!-- Dynamic Background Streamers / Swooshes (SVG Curves) -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <svg class="absolute -left-20 top-1/4 h-[420px] w-[140%] -rotate-3 opacity-90 sm:h-[520px]" viewBox="0 0 1440 400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <title>Dynamic Background Streamers</title>
      <!-- Upper Red Dynamic Sweep -->
      <path d="M-100,120 C300,-40 800,280 1500,40" stroke="#d71920" stroke-width="14" stroke-linecap="round" fill="none"/>
      <path d="M100,180 C400,20 900,320 1600,100" stroke="#d71920" stroke-width="4" stroke-linecap="round" fill="none" opacity="0.6"/>

      <!-- Lower Blue Dynamic Sweep -->
      <path d="M-120,280 C350,380 950,140 1550,220" stroke="#2f559a" stroke-width="18" stroke-linecap="round" fill="none"/>
      <path d="M-50,320 C420,420 1020,180 1620,260" stroke="#2f559a" stroke-width="5" stroke-linecap="round" fill="none" opacity="0.7"/>
    </svg>
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
    <!-- Top Pill Badge -->
    <div class="inline-flex items-center gap-2 rounded-full border-2 border-[#172033] bg-white px-4 py-1.5 text-xs font-black uppercase tracking-wider text-[#172033] shadow-[3px_3px_0_#172033] mb-8 animate-bounce-subtle">
      <span class="inline-block h-2 w-2 rounded-full bg-[#d71920]" />
      <span>{t.hero.badge}</span>
    </div>

    <!-- Center Elevated Hero Logo Card -->
    <div class="w-full max-w-2xl rounded-3xl border-3 border-[#172033] bg-white p-6 sm:p-10 shadow-[10px_10px_0_#2f559a] transition-transform hover:-translate-y-1 hover:shadow-[12px_12px_0_#2f559a]">
      <img
        src="/2026/logos/pyconlogo.svg"
        alt="PyCon HK 2026 Logo"
        width="608"
        height="276"
        class="mx-auto h-auto max-h-56 sm:max-h-64 w-full object-contain"
        loading="eager"
      />
    </div>

    <!-- Main Title & Subtitle -->
    <div class="mt-10 sm:mt-12 max-w-3xl space-y-4">
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-[#172033] leading-[1.1]">
        {t.hero.headline}
      </h1>
      {t.hero.headlineAccent && (
        <p class="text-xl sm:text-2xl font-bold text-[#d71920]">
          {t.hero.headlineAccent}
        </p>
      )}
      <p class="text-base sm:text-lg lg:text-xl text-slate-700 font-medium max-w-2xl mx-auto leading-relaxed">
        {t.hero.subheadline}
      </p>
    </div>

    <!-- Hero Action Buttons (Circle style matching Canva) -->
    <div class="mt-8 flex items-center justify-center gap-4">
      <a
        href={registrationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex h-13 w-13 items-center justify-center rounded-full bg-[#d71920] text-white border-2 border-[#172033] shadow-[4px_4px_0_#172033] transition-all hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-none hover:bg-[#c0151c]"
        aria-label={t.hero.registerCta}
        title={t.hero.registerCta}
      >
        <svg class="h-6 w-6 transition-transform group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <title>Register or Submit Proposal</title>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
        </svg>
      </a>

      <a
        href="#about"
        class="group flex h-13 w-13 items-center justify-center rounded-full bg-white text-[#172033] border-2 border-[#172033] shadow-[4px_4px_0_#172033] transition-all hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-none hover:bg-slate-50"
        aria-label={t.hero.calendarCta}
        title={t.hero.calendarCta}
      >
        <svg class="h-6 w-6 transition-transform group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <title>Add to Calendar</title>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </a>
    </div>

    <!-- At a Glance 3-Column Info Strip -->
    <div class="mt-10 sm:mt-14 w-full max-w-3xl rounded-2xl border-2 border-[#172033] bg-white p-5 sm:p-6 shadow-[6px_6px_0_#172033]">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-0 divide-y sm:divide-y-0 sm:divide-x divide-[#172033]/15 text-left">
        <div class="sm:px-4 sm:first:pl-0">
          <p class="text-xs font-black uppercase tracking-wider text-[#2f559a]">{t.hero.whenLabel}</p>
          <p class="mt-1 text-sm sm:text-base font-bold text-[#172033]">{t.hero.whenValue}</p>
        </div>
        <div class="pt-3 sm:pt-0 sm:px-4">
          <p class="text-xs font-black uppercase tracking-wider text-[#2f559a]">{t.hero.whereLabel}</p>
          <p class="mt-1 text-sm sm:text-base font-bold text-[#172033]">{t.hero.whereValue}</p>
        </div>
        <div class="pt-3 sm:pt-0 sm:px-4 sm:last:pr-0">
          <p class="text-xs font-black uppercase tracking-wider text-[#2f559a]">{t.hero.forLabel}</p>
          <p class="mt-1 text-sm sm:text-base font-bold text-[#172033]">{t.hero.forValue}</p>
        </div>
      </div>
    </div>
  </div>
</section>