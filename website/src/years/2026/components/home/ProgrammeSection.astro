---
import { getTranslations } from '@/years/2026/i18n';
import type { CfpLocale } from '@/years/2026/locales';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section class="py-16 sm:py-24 bg-conference-paper" id="programme">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl space-y-3">
      <p class="text-xs font-black uppercase tracking-widest text-conference-red">
        {t.programme.eyebrow}
      </p>
      <h2 class="ideal-heading text-2xl sm:text-4xl lg:text-5xl font-extrabold text-conference-ink tracking-[-0.03em] leading-normal">
        {t.programme.title}
      </h2>
      <p class="text-sm sm:text-base text-conference-body leading-relaxed max-w-2xl font-medium">
        {t.programme.description}
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {t.programme.tracks.map((track) => (
        <div class="flex flex-col justify-between rounded-2xl border-2 border-conference-outline bg-conference-surface p-6 sm:p-8 shadow-[6px_6px_0_var(--conference-shadow)] transition-all hover:-translate-y-1 hover:shadow-[8px_8px_0_var(--conference-shadow)]">
          <div>
            <div class="flex items-center justify-between">
              <div class:list={[
                'flex h-10 w-10 items-center justify-center rounded-full text-white font-bold border-2 border-conference-outline shadow-[2px_2px_0_var(--conference-shadow)]',
                track.number === '02' ? 'bg-[#2f559a]' : 'bg-[#d71920]'
              ]}>
                {track.icon === 'code' && (
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <title>Code icon</title>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                  </svg>
                )}
                {track.icon === 'ai' && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <title>Database icon</title>
                    <ellipse cx="12" cy="5" rx="9" ry="3" />
                    <path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5" />
                    <path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3" />
                  </svg>
                )}
                {track.icon === 'community' && (
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <title>People and Community icon</title>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                )}
              </div>
              <span class:list={[
                'font-black text-sm tracking-wider',
                track.number === '02' ? 'text-conference-blue' : 'text-conference-red'
              ]}>
                {track.number}
              </span>
            </div>

            <div class="mt-8 space-y-2.5">
              <h3 class="text-xl sm:text-2xl font-black text-conference-ink">
                {track.title}
              </h3>
              <p class="text-xs sm:text-sm text-conference-body leading-relaxed">
                {track.description}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
