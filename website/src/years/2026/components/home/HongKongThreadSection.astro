---
import { getTranslations } from '@/years/2026/i18n';
import type { CfpLocale } from '@/years/2026/locales';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section data-conference-inverse class="w-full bg-[#1D4486] py-16 sm:py-24 text-white overflow-hidden" id="venue">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Left Column Text -->
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-block rounded-full bg-conference-surface/15 px-3.5 py-1 text-xs font-black uppercase tracking-widest text-[#ffd343] border border-white/20">
          {t.hongKongThread.eyebrow}
        </div>

        <h2 class="ideal-heading text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-[-0.03em] text-white leading-normal">
          {t.hongKongThread.title}
        </h2>

        <p class="text-base sm:text-lg text-blue-100 leading-relaxed font-normal">
          {t.hongKongThread.description}
        </p>

        <div class="flex items-center gap-2.5 text-sm font-bold text-white/90 pt-2">
          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-conference-surface/20 text-[#ffd343]">
            <svg class="h-4 w-4 text-[#ffd343]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <title>Location Pin</title>
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </span>
          <span>{t.hongKongThread.location}</span>
        </div>
      </div>

      <!-- Right Column Framed Card -->
      <div class="lg:col-span-6 flex justify-center">
        <div class="relative w-full max-w-xl group">
          <!-- Background Offset Shadow Card in Red -->
          <div class="absolute inset-0 translate-x-3 translate-y-3 sm:translate-x-4 sm:translate-y-4 rounded-3xl bg-[#d71920] border-2 border-conference-outline" />
          
          <!-- Foreground Card -->
          <div class="brand-plate relative rounded-3xl border-2 border-conference-outline bg-conference-surface p-2.5 sm:p-4 shadow-xl transition-transform group-hover:-translate-x-1 group-hover:-translate-y-1">
            <img
              src="/2026/logos/pyconlogo.png"
              alt="Hong Kong Woven Weave PyCon HK 2026 Logo Frame"
              width="960"
              height="540"
              class="w-full h-auto rounded-2xl object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #venue .ideal-heading { color: white; }
</style>
