---
import WovenRibbon from '@/years/2026/components/ui/WovenRibbon.astro';
import { getTranslations } from '@/years/2026/i18n';
import type { CfpLocale } from '@/years/2026/locales';
import { registrationUrl, sponsorshipEmail } from '@/years/2026/site';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const privacyHref = `/2026/${locale}/privacy-policy`;
---

<footer class="w-full bg-[#111827] text-white">
  <!-- Top Decorative Woven Ribbon -->
  <WovenRibbon heightClass="h-3 sm:h-3.5" />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
      <!-- Left Brand & Community Statement -->
      <div class="lg:col-span-7 space-y-4">
        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-full bg-[#2f559a] text-white border-2 border-white/20">
            <svg class="h-5 w-5" viewBox="0 0 110 110" fill="none" xmlns="http://www.w3.org/2000/svg">
              <title>PyCon HK Crest</title>
              <path d="M54.5 9C37.8 9 29.5 16.5 29.5 24v11h25v3.8H18.8C10.7 38.8 4 45.9 4 58.7c0 13.5 7.1 20.3 19.3 20.3h7.2v-10.4c0-11.4 9.8-20.8 21.6-20.8h25c8.3 0 14.9-6.8 14.9-15.1v-8.2c0-11.9-9.5-20.5-27.5-20.5zM41 19.5c3.2 0 5.8 2.6 5.8 5.8s-2.6 5.8-5.8 5.8-5.8-2.6-5.8-5.8 2.6-5.8 5.8-5.8z" fill="#ffd343"/>
              <path d="M55.5 101c16.7 0 25-7.5 25-15V75H55.5v-3.8h35.7c8.1 0 14.8-7.1 14.8-19.9 0-13.5-7.1-20.3-19.3-20.3h-7.2v10.4c0 11.4-9.8 20.8-21.6 20.8h-25c-8.3 0-14.9 6.8-14.9 15.1v8.2c0 11.9 9.5 20.5 27.5 20.5zM69 90.5c-3.2 0-5.8-2.6-5.8-5.8s2.6-5.8 5.8-5.8 5.8 2.6 5.8 5.8-2.6 5.8-5.8 5.8z" fill="#ffffff"/>
            </svg>
          </div>
          <span class="font-black text-xl sm:text-2xl text-white tracking-tight">
            {t.footer.brand}
          </span>
        </div>
        <p class="max-w-xl text-sm sm:text-base leading-relaxed text-slate-300 font-medium">
          {t.footer.summary}
        </p>
      </div>

      <!-- Right Quick Links / Conference Guide -->
      <div class="lg:col-span-5 flex flex-col sm:flex-row lg:justify-end gap-8">
        <div>
          <h3 class="font-bold text-xs uppercase tracking-wider text-slate-400 mb-3">
            {t.footer.conferenceGuideTitle}
          </h3>
          <ul class="space-y-2.5 text-sm font-semibold">
            <li>
              <a href="#about" class="text-slate-200 hover:text-[#ffd343] transition-colors">
                {t.footer.aboutLink}
              </a>
            </li>
            <li>
              <a href={sponsorshipEmail} class="text-slate-200 hover:text-[#ffd343] transition-colors">
                {t.footer.sponsorLink}
              </a>
            </li>
            <li>
              <a href={registrationUrl} target="_blank" rel="noopener noreferrer" class="text-slate-200 hover:text-[#ffd343] transition-colors">
                {t.footer.registrationLink}
              </a>
            </li>
            <li>
              <a href={privacyHref} class="text-slate-200 hover:text-[#ffd343] transition-colors">
                {t.footer.privacyPolicyLink}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="my-8 h-px w-full bg-white/10" />

    <!-- Bottom Metadata & Tagline -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-medium text-slate-400">
      <div>{t.footer.copyright}</div>
      <div class="text-slate-300 font-bold tracking-wide">{t.footer.tagline}</div>
      <div class="flex items-center gap-4">
        <a href={privacyHref} class="hover:text-white transition-colors">{t.footer.privacyPolicy}</a>
      </div>
    </div>
  </div>
</footer>
