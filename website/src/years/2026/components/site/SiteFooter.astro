---
import WovenRibbon from '@/years/2026/components/ui/WovenRibbon.astro';
import type { CfpLocale } from '@/years/2026/locales';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const privacyHref = `/2026/${locale}/privacy-policy`;

const footerLabels = {
  en: { followUs: 'Follow Us', history: 'History' },
  'zh-hk': { followUs: '追蹤我哋', history: '歷屆大會' },
  'zh-hant': { followUs: '追蹤我們', history: '歷屆大會' },
  'zh-hans': { followUs: '关注我们', history: '历届大会' },
  ja: { followUs: 'フォローする', history: '過去の開催' },
  ko: { followUs: '팔로우', history: '지난 행사' },
};
const footerCopy = {
  ...footerLabels[locale],
  copyright: '© 2026 PyCon Hong Kong. All rights reserved.',
  privacyPolicy: 'Privacy Policy',
};

const socialLinks = [
  {
    name: 'X',
    href: 'https://x.com/pyconhk/',
    icon: 'x',
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/company/pyconhk/',
    icon: 'linkedin',
  },
  {
    name: 'YouTube',
    href: 'https://www.youtube.com/c/pyconhk',
    icon: 'youtube',
  },
  {
    name: 'Facebook',
    href: 'https://www.facebook.com/pyconhk/',
    icon: 'facebook',
  },
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/pyconhk',
    icon: 'instagram',
  },
  {
    name: 'Threads',
    href: 'https://www.threads.net/@pyconhk',
    icon: 'threads',
  },
];

const archiveLinks = [
  { label: '2026', href: `/2026/${locale}/` },
  { label: '2025', href: '/2025/' },
  { label: '2024', href: '/2024/' },
  { label: '2023', href: '/2023/' },
  { label: '2022', href: '/2022/' },
  { label: '2021', href: '/2021/' },
  { label: '2020 fall', href: '/2020-fall/' },
  { label: '2020 spring', href: '/2020-spring/' },
  { label: '2018', href: '/2018/' },
  { label: '2017', href: '/2017/' },
  { label: '2016', href: '/2016/' },
  { label: '2015', href: '/2015/' },
];
---

<!-- Decorative Authentic Red-White-Blue Woven Ribbon placed above the footer area -->
<WovenRibbon heightClass="h-5 sm:h-7" />

<footer data-conference-inverse class="w-full bg-[#293548] text-white">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12 pt-10 pb-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-8 items-start">
      <!-- Left Column: Follow Us -->
      <div class="md:col-span-4 space-y-4">
        <h3 class="text-base sm:text-lg font-bold text-white tracking-wide">
          {footerCopy.followUs}
        </h3>
        <div class="flex items-center flex-wrap gap-4 text-slate-200">
          {socialLinks.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-transform hover:scale-110 hover:text-white"
              aria-label={item.name}
            >
              {item.icon === 'x' && (
                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                  <title>X (Twitter)</title>
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              )}
              {item.icon === 'linkedin' && (
                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                  <title>LinkedIn</title>
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.25c-.9 0-1.63.73-1.63 1.63s.73 1.63 1.63 1.63 1.63-.73 1.63-1.63c-.01-.9-.74-1.63-1.63-1.63Z" />
                </svg>
              )}
              {item.icon === 'youtube' && (
                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                  <title>YouTube</title>
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                </svg>
              )}
              {item.icon === 'facebook' && (
                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                  <title>Facebook</title>
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                </svg>
              )}
              {item.icon === 'instagram' && (
                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                  <title>Instagram</title>
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                </svg>
              )}
              {item.icon === 'threads' && (
                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                  <title>Threads</title>
                  <path d="M12.186 24h-.007C5.454 24 0 18.546 0 11.814 0 5.087 5.454 0 12.186 0c6.726 0 12.18 5.087 12.18 11.814 0 .638-.052 1.275-.155 1.905l-.014.075h-4.303c.046-.229.071-.462.071-.699 0-4.308-3.479-7.787-7.779-7.787-4.3 0-7.779 3.479-7.779 7.787 0 4.308 3.479 7.787 7.779 7.787 2.012 0 3.844-.766 5.228-2.032l.061-.057 3.036 3.036-.057.054C18.665 23.003 15.548 24 12.186 24zm4.184-12.186c0-2.316-1.87-4.186-4.184-4.186-2.314 0-4.184 1.87-4.184 4.186 0 2.314 1.87 4.184 4.184 4.184 2.314 0 4.184-1.87 4.184-4.184z" />
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Right Column: History Archive -->
      <div class="md:col-span-8 space-y-3">
        <h3 class="text-base sm:text-lg font-bold text-white tracking-wide">
          {footerCopy.history}
        </h3>
        <div class="flex items-center flex-wrap gap-x-4 gap-y-2 text-xs sm:text-sm text-slate-300">
          {archiveLinks.map((link) => (
            <a
              href={link.href}
              class="transition-colors hover:text-[#ffd343]"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Centered Copyright & Privacy Policy -->
    <div class="mt-12 pt-6 border-t border-white/10 text-center space-y-2 text-xs text-conference-muted">
      <p>{footerCopy.copyright}</p>
      <p>
        <a href={privacyHref} class="hover:text-white transition-colors">
          {footerCopy.privacyPolicy}
        </a>
      </p>
    </div>
  </div>
</footer>
