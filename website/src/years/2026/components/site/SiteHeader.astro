---
import LanguageSwitcher from '@/years/2026/components/ui/LanguageSwitcher.astro';
import RegistrationButton from '@/years/2026/components/ui/RegistrationButton.astro';
import ThemeSwitcher from '@/years/2026/components/ui/ThemeSwitcher.astro';
import WovenRibbon from '@/years/2026/components/ui/WovenRibbon.astro';
import { headerNavigation } from '@/years/2026/data/navigation';
import { getTranslations } from '@/years/2026/i18n';
import type { CfpLocale } from '@/years/2026/locales';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const homeHref = `/2026/${locale}/`;
---

<header class="sticky top-0 z-50 w-full bg-conference-paper/95 backdrop-blur-md transition-all border-b border-conference-outline/10 overflow-x-clip" data-site-header>
  <!-- Top Authentic Red-White-Blue Woven Ribbon -->
  <WovenRibbon heightClass="h-5 sm:h-7" />

  <div class="mx-auto flex h-16 sm:h-20 max-w-[1700px] w-full items-center justify-between px-3 sm:px-4 lg:px-6">
    <!-- Brand Logo (Always shrink-0) -->
    <div class="flex items-center shrink-0 mr-2 sm:mr-3 min-[1400px]:mr-5">
      <a
        href={homeHref}
        class="group flex shrink-0 items-center gap-2 sm:gap-2.5 transition-transform hover:scale-[1.02]"
        aria-label="PYCON HK 2026"
      >
        <img
          src="/2026/logos/horse-mark.svg"
          alt="PyCon HK 2026 Logo"
          width="140"
          height="45"
          class="h-6 sm:h-7.5 min-[1500px]:h-8.5 w-auto max-w-[95px] sm:max-w-[125px] min-[1500px]:max-w-[150px] object-contain transition-transform group-hover:scale-105"
        />
        <span class="font-operetta-32 text-base sm:text-lg min-[1440px]:text-[1.2rem] text-conference-ink hidden min-[440px]:inline-block whitespace-nowrap leading-none font-black uppercase tracking-wider">
          PYCON HK 2026
        </span>
      </a>
    </div>

    <!-- Desktop Navigation Links (Responsive fluid gaps, 100% visible without overflowing) -->
    <nav class="hidden min-[1280px]:flex flex-1 items-center justify-center gap-1.5 min-[1340px]:gap-2 min-[1420px]:gap-3 min-[1560px]:gap-4.5 font-bold text-[0.74rem] min-[1340px]:text-[0.78rem] min-[1460px]:text-[0.82rem] min-[1600px]:text-[0.875rem] text-conference-ink px-1" aria-label="Main Navigation">
      {headerNavigation.map((item) => {
        if (item.kind === 'link') {
          return (
            <a
              href={item.href(locale)}
              target={item.isExternal ? '_blank' : undefined}
              rel={item.isExternal ? 'noopener noreferrer' : undefined}
              class="group relative shrink-0 py-2 px-1 transition-colors hover:text-conference-red whitespace-nowrap"
            >
              <span>{item.label[locale] ?? item.label.en}</span>
              <span class="absolute bottom-0 left-1 right-1 h-[2px] origin-left scale-x-0 bg-[#d71920] transition-transform duration-250 ease-out group-hover:scale-x-100" />
            </a>
          );
        }

        return (
          <div class="group relative shrink-0 py-2" data-nav-dropdown-group>
            <button
              type="button"
              class="group/btn relative flex items-center gap-0.5 py-1 px-1 text-left transition-colors hover:text-conference-red focus:outline-none whitespace-nowrap"
              aria-haspopup="true"
            >
              <span>{item.label[locale] ?? item.label.en}</span>
              <svg class="h-3 w-3 shrink-0 transition-transform duration-200 group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                <title>Expand dropdown</title>
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
              <span class="absolute bottom-0 left-1 right-1 h-[2px] origin-left scale-x-0 bg-[#d71920] transition-transform duration-250 ease-out group-hover:scale-x-100" />
            </button>

            {/* Dropdown Menu Box (Seamless hover bridge, continuous hit area) */}
            <div class="invisible absolute left-1/2 top-full z-50 pt-2 -translate-x-1/2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 pointer-events-none group-hover:pointer-events-auto group-focus-within:pointer-events-auto">
              <div class="w-60 rounded-2xl border-2 border-conference-outline bg-conference-surface p-2 shadow-[4px_4px_0_var(--conference-shadow)] relative before:absolute before:-top-3 before:left-0 before:right-0 before:h-4 before:content-['']">
                <div class="flex flex-col space-y-1">
                  {item.children.map((child) => (
                    <a
                      href={child.href(locale)}
                      target={child.isExternal ? '_blank' : undefined}
                      rel={child.isExternal ? 'noopener noreferrer' : undefined}
                      class="group/sub relative rounded-xl px-3 py-2 text-xs font-bold text-conference-ink transition-colors hover:bg-conference-soft hover:text-conference-red whitespace-nowrap"
                    >
                      <span>{child.label[locale] ?? child.label.en}</span>
                      <span class="absolute bottom-1 left-3 h-[1.5px] w-[calc(100%-1.5rem)] origin-left scale-x-0 bg-[#d71920] transition-transform duration-200 group-hover/sub:scale-x-100" />
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </nav>

    <div class="ml-auto mr-2 shrink-0"><ThemeSwitcher locale={locale} /></div>
    <!-- Desktop Actions & Switcher (Always shrink-0, perfectly positioned on right) -->
    <div class="hidden md:flex items-center gap-2 min-[1400px]:gap-3 shrink-0 ml-2">
      <LanguageSwitcher locale={locale} />
      
      <RegistrationButton locale={locale} className="inline-flex shrink-0 items-center justify-center rounded-full bg-[#d71920] px-3.5 min-[1440px]:px-5 py-2 text-xs min-[1440px]:text-sm font-bold text-white shadow-[2px_2px_0_var(--conference-shadow)] border-2 border-conference-outline transition-all hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-none hover:bg-[#c0151c] whitespace-nowrap" />
    </div>

    <!-- Mobile / Compact Viewport Menu Trigger (< 1280px) -->
    <div class="flex items-center gap-2 min-[1280px]:hidden">
      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-xl border-2 border-conference-outline bg-conference-surface text-conference-ink shadow-[2px_2px_0_var(--conference-shadow)] active:translate-x-0.5 active:translate-y-0.5"
        aria-label={t.nav.menuLabel}
        aria-expanded="false"
        data-mobile-nav-trigger
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <title>Open Menu</title>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="pointer-events-none fixed inset-0 z-[60] opacity-0 transition-opacity duration-200" data-mobile-nav-drawer>
    <button
      type="button"
      class="absolute inset-0 bg-slate-900/60  backdrop-blur-xs opacity-0 transition-opacity duration-200"
      aria-label={t.nav.closeMenu}
      data-mobile-nav-close
      data-mobile-nav-backdrop
    ></button>

    <div
      class="fixed right-0 top-0 flex h-dvh w-84 max-w-[88vw] translate-x-full flex-col overflow-y-auto bg-conference-paper  border-l-2 border-conference-outline  p-5 text-conference-ink  shadow-2xl transition-transform duration-200"
      data-mobile-nav-panel
    >
      <div class="flex items-center justify-between pb-4 border-b border-conference-outline/15 ">
        <span class="font-operetta text-lg text-conference-ink  leading-none font-black uppercase tracking-wider">PYCON HK 2026</span>
        <button
          type="button"
          class="flex h-9 w-9 items-center justify-center rounded-lg border-2 border-conference-outline  bg-conference-surface  text-conference-ink  shadow-[2px_2px_0_var(--conference-shadow)] "
          aria-label={t.nav.closeMenu}
          data-mobile-nav-close
        >
          <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <title>Close Menu</title>
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>

      <!-- Mobile Navigation List -->
      <nav class="flex flex-col gap-2 py-4 border-b border-conference-outline/15  text-sm font-bold">
        {headerNavigation.map((item) => {
          if (item.kind === 'link') {
            return (
              <a
                href={item.href(locale)}
                class="rounded-xl px-3 py-2.5 transition-colors hover:bg-conference-surface  hover:text-conference-red "
                data-mobile-nav-link
              >
                {item.label[locale] ?? item.label.en}
              </a>
            );
          }

          return (
            <details class="group/m rounded-xl border border-transparent transition-all open:border-conference-outline/10  open:bg-conference-surface/60 ">
              <summary class="flex cursor-pointer list-none items-center justify-between rounded-xl px-3 py-2.5 hover:bg-conference-surface  hover:text-conference-red  [&::-webkit-details-marker]:hidden">
                <span>{item.label[locale] ?? item.label.en}</span>
                <svg class="h-4 w-4 transition-transform duration-200 group-open/m:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                  <title>Toggle group</title>
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </summary>
              <div class="space-y-1 pb-2 pl-4 pr-2">
                {item.children.map((child) => (
                  <a
                    href={child.href(locale)}
                    class="block rounded-lg px-3 py-2 text-xs text-conference-body  hover:bg-conference-surface  hover:text-conference-red "
                    data-mobile-nav-link
                  >
                    {child.label[locale] ?? child.label.en}
                  </a>
                ))}
              </div>
            </details>
          );
        })}
      </nav>

      <div class="py-4 space-y-4">
        <RegistrationButton locale={locale} className="flex w-full items-center justify-center rounded-full bg-[#d71920] py-3 text-center text-sm font-bold text-white border-2 border-conference-outline  shadow-[3px_3px_0_var(--conference-shadow)] " />

        <div class="pt-2">
          <p class="mb-2 text-xs font-bold uppercase tracking-wider text-conference-muted ">Language / 語言</p>
          <LanguageSwitcher locale={locale} mobile={true} />
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline data-astro-rerun>
  for (const header of document.querySelectorAll('[data-site-header]')) {
    if (!(header instanceof HTMLElement) || header.dataset.mobileNavReady === 'true') {
      continue;
    }
    header.dataset.mobileNavReady = 'true';

    const trigger = header.querySelector('[data-mobile-nav-trigger]');
    const drawer = header.querySelector('[data-mobile-nav-drawer]');
    const backdrop = header.querySelector('[data-mobile-nav-backdrop]');
    const panel = header.querySelector('[data-mobile-nav-panel]');
    const closeButtons = header.querySelectorAll('[data-mobile-nav-close]');
    const links = header.querySelectorAll('[data-mobile-nav-link]');

    if (!(trigger instanceof HTMLButtonElement) || !(drawer instanceof HTMLElement) || !(panel instanceof HTMLElement)) {
      continue;
    }

    const setOpen = (isOpen) => {
      trigger.setAttribute('aria-expanded', String(isOpen));
      drawer.classList.toggle('pointer-events-none', !isOpen);
      drawer.classList.toggle('pointer-events-auto', isOpen);
      drawer.classList.toggle('opacity-0', !isOpen);
      drawer.classList.toggle('opacity-100', isOpen);
      panel.classList.toggle('translate-x-full', !isOpen);
      panel.classList.toggle('translate-x-0', isOpen);

      if (backdrop instanceof HTMLElement) {
        backdrop.classList.toggle('opacity-0', !isOpen);
        backdrop.classList.toggle('opacity-100', isOpen);
      }
      document.documentElement.classList.toggle('overflow-hidden', isOpen);
    };

    trigger.addEventListener('click', () => setOpen(true));
    for (const btn of closeButtons) btn.addEventListener('click', () => setOpen(false));
    for (const link of links) link.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>
