---
import { organizers, pageCopyByLocale } from '@/years/2026/data/organizers';
import ConferenceLayout from '@/years/2026/layouts/ConferenceLayout.astro';
import type { CfpLocale } from '@/years/2026/locales';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const pageCopy = pageCopyByLocale[locale] ?? pageCopyByLocale.en;
---

<ConferenceLayout
  title={`${pageCopy.title} | PyCon HK 2026`}
  description={pageCopy.intro}
  locale={locale}
>
  <main class="w-full bg-[#FAF7F0] py-10 sm:py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      
      <div class="rounded-3xl border-3 border-[#172033] bg-white p-6 sm:p-10 md:p-14 shadow-[8px_8px_0_#172033] space-y-16">
        
        <div class="text-center max-w-3xl mx-auto space-y-4">
          <div class="inline-flex items-center gap-2 rounded-full border-2 border-[#172033] bg-[#FAF7F0] px-3.5 py-1 text-xs font-black uppercase text-[#172033] shadow-[2px_2px_0_#172033]">
            <span class="h-2 w-2 rounded-full bg-[#d71920]"></span>
            <span>PyCon HK 2026 Organizers</span>
          </div>

          <h1 class="font-operetta-32 text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-[#172033] font-black uppercase tracking-tight">
            {pageCopy.title}
          </h1>

          <p class="text-sm sm:text-base text-slate-700 font-medium leading-relaxed">
            {pageCopy.intro}
          </p>
        </div>

        <div class="space-y-16 sm:space-y-20 pt-4">
          {organizers.map((organizer) => {
            const titleLines = organizer.titleLines[locale] ?? organizer.titleLines.en;
            const description = organizer.description[locale] ?? organizer.description.en;

            return (
              <section class="space-y-6 pt-10 first:pt-0 border-t-2 first:border-t-0 border-[#172033]/15">
                <div class="text-center space-y-2 max-w-3xl mx-auto">
                  <h2 class="text-2xl sm:text-3xl font-black text-[#172033] tracking-tight">
                    {titleLines.map((line, lineIndex) => (
                      <span>
                        {lineIndex > 0 && <br />}
                        {line}
                      </span>
                    ))}
                  </h2>
                </div>

                <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-medium max-w-3xl mx-auto text-left sm:text-justify">
                  {description}
                </p>

                <div class="pt-4 flex items-center justify-center">
                  <a
                    href={organizer.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-center justify-center rounded-2xl border-2 border-[#172033] bg-[#FAF7F0] p-6 sm:p-8 shadow-[4px_4px_0_#172033] transition-all hover:-translate-y-1 hover:shadow-[6px_6px_0_#d71920]"
                    aria-label={organizer.imageAlt}
                  >
                    <img
                      src={organizer.imageSrc}
                      alt={organizer.imageAlt}
                      width="300"
                      height="200"
                      class="max-w-[240px] sm:max-w-[300px] h-auto object-contain transition-transform group-hover:scale-105"
                      loading="lazy"
                    />
                  </a>
                </div>
              </section>
            );
          })}
        </div>

      </div>
    </div>
  </main>
</ConferenceLayout>
