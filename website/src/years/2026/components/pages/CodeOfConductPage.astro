---
import ConferenceLayout from '@/years/2026/layouts/ConferenceLayout.astro';
import type { CfpLocale } from '@/years/2026/locales';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;

const attendeeReportingHref = `/2026/${locale}/code-of-conduct/attendee-reporting/`;
const staffProceduresHref = `/2026/${locale}/code-of-conduct/staff-procedures/`;

const pageTitle =
  locale === 'zh-hk' || locale === 'zh-hant'
    ? '行為準則總覽 | PyCon HK 2026'
    : locale === 'zh-hans'
      ? '行为准则总览 | PyCon HK 2026'
      : locale === 'ja'
        ? '行動規範の概要 | PyCon HK 2026'
        : locale === 'ko'
          ? '행동 강령 개요 | PyCon HK 2026'
          : 'Code of Conduct Overview | PyCon HK 2026';

const pageDescription =
  locale === 'zh-hk' || locale === 'zh-hant'
    ? 'PyCon Hong Kong 2026 行為準則總覽與社群規範。'
    : locale === 'zh-hans'
      ? 'PyCon Hong Kong 2026 行为准则总览与社区规范。'
      : locale === 'ja'
        ? 'PyCon Hong Kong 2026 の行動規範概要です。'
        : locale === 'ko'
          ? 'PyCon Hong Kong 2026 행동 강령 개요 및 커뮤니티 가이드라인입니다.'
          : 'Code of Conduct Overview and community standards for PyCon Hong Kong 2026.';
---

<ConferenceLayout title={pageTitle} description={pageDescription} locale={locale}>
  <section class="py-12 sm:py-16 lg:py-20 bg-[#FAF7F0]">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-3xl border-3 border-[#172033] bg-white p-6 sm:p-10 lg:p-12 shadow-[8px_8px_0_#172033]">
        {
          locale === 'zh-hk' || locale === 'zh-hant' ? (
            <div>
              <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-[#172033] text-center tracking-tight mb-8">
                行為準則總覽
              </h1>
              <div class="space-y-6 text-slate-700 leading-relaxed font-medium">
                <p>PyCon Hong Kong 是一個以促進開發者社群交流與合作為目標的社群會議。</p>
                <p>
                  我們重視每一位 Python 社群成員的參與，並希望所有參加者都能擁有愉快而充實的體驗。因此，所有參加者都應在整個會議期間，以及所有與會議相關的活動中，對其他參加者保持尊重與禮貌，無論該活動是否由 PyCon Hong Kong 主辦單位正式贊助。
                </p>
                <p>
                  為了清楚說明我們對行為的期望，所有 PyCon 活動中的工作人員、參加者、講者、參展單位、主辦者及義工，都必須遵守以下行為準則。主辦單位將在整個活動期間執行本準則。
                </p>

                <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">我們的標準</h2>
                <p>
                  PyCon 致力為每一位參與者提供正面而安全的會議體驗，不論其年齡、性別認同與表達、性傾向、身心障礙、外表、體型、族裔、國籍、種族、宗教（或無宗教信仰）、教育背景或社會經濟地位。
                </p>
                <p>有助於建立正面環境的行為包括：</p>
                <ul class="list-disc ml-6 space-y-2">
                  <li>友善對待他人</li>
                  <li>以專業方式行事</li>
                  <li>使用歡迎且具包容性的語言</li>
                  <li>尊重不同觀點與經驗</li>
                  <li>以成熟態度接受建設性批評</li>
                  <li>專注於對社群最有益的事情</li>
                  <li>對其他社群成員展現同理心</li>
                </ul>

                <p class="pt-2">不可接受的行為包括：</p>
                <ul class="list-disc ml-6 space-y-2">
                  <li>以任何形式騷擾會議參加者</li>
                  <li>蓄意恐嚇、跟蹤或尾隨他人</li>
                  <li>對他人作出暴力威脅或使用威嚇性言語</li>
                  <li>在會場任何地方（包括演講內容）使用帶有性意味的語言或影像</li>
                  <li>侮辱、貶低或羞辱他人</li>
                  <li>性別歧視、種族歧視、恐同、恐跨、歧視殘障或排他性的笑話</li>
                  <li>過度粗言穢語</li>
                  <li>不受歡迎的性暗示或性挑逗</li>
                  <li>不受歡迎的身體接觸</li>
                  <li>持續打斷演講或其他活動</li>
                  <li>其他不適合多元專業觀眾場合的行為</li>
                </ul>
                <p>當參加者被要求停止任何不當行為時，應立即遵從。</p>
                <p>
                  如有參加者作出違反本行為準則的行為，主辦單位可視情況採取其認為合適的行動，包括口頭或書面警告，或在不退款的情況下取消其參與資格。
                </p>
                <p>感謝你一起協助建立一個友善、歡迎所有人的活動環境。</p>

                <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">武器政策</h2>
                <p>
                  會議場地內禁止攜帶任何武器，包括但不限於爆炸品（包括煙花）、槍械、大型刀具（例如狩獵刀或展示用刀）以及任何可能用作傷害他人的物品。任何被發現持有上述物品的人士將被要求立即離場，並只有在不攜帶武器的情況下方可返回。
                </p>
                <p>參加者亦須遵守所有適用的本地法律與規例。</p>

                <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">適用範圍</h2>
                <p>
                  所有 PyCon Hong Kong 參加者均受本行為準則約束，包括 PyCon Hong Kong 的工作人員及義工，以及教學課、工作坊、峰會、海報展示、交流酒會、正式會議、sprint、贊助活動或非官方聚會的參加者。
                </p>
                <p>
                  博覽區參展單位、贊助商或供應商攤位，以及其他類似活動，同樣受本行為準則約束。特別是，參展單位不應使用帶有性意味的圖像、活動或素材；攤位工作人員（包括義工）亦不應穿著帶有性暗示的服裝、制服或造型，或營造令人感到性化的不適環境。
                </p>

                <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">聯絡方式</h2>
                <p>
                  如果你認為有人在 PyCon 活動期間違反了行為準則，或你有其他相關疑慮，請立即聯絡現場工作人員。
                </p>
                <p>
                  PyCon Hong Kong<br />
                  Email: <a href="mailto:pycon@pycon.hk" class="font-bold text-[#d71920] underline">pycon@pycon.hk</a>
                </p>
                <p>如存在利益衝突，你亦可以個別聯絡大會主席。</p>
                <p>
                  大會工作人員會盡力協助參加者聯絡場地保安、酒店保安或本地執法部門，提供陪同支援，或以其他方式協助參加者在整個會議期間感到安全。我們十分重視你的參與。
                </p>

                <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">事件處理程序</h2>
                <p class="space-x-4">
                  <a href={attendeeReportingHref} class="font-bold text-[#d71920] underline">
                    事件舉報程序 →
                  </a>
                  <a href={staffProceduresHref} class="font-bold text-[#2f559a] underline">
                    執行程序 →
                  </a>
                </p>
                <p class="text-xs text-slate-500 pt-4">
                  本行為準則改編自 PyCon US，原始版本可參考 Python GitHub。PyCon 行為準則採用 Creative Commons Attribution 3.0 Unported License 授權。
                </p>
              </div>
            </div>
          ) : locale === 'zh-hans' ? (
            <div>
              <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-[#172033] text-center tracking-tight mb-8">
                行为准则总览
              </h1>
              <div class="space-y-6 text-slate-700 leading-relaxed font-medium">
                <p>PyCon Hong Kong 是一个以促进开发者社区交流与合作为目标的社区会议。</p>
                <p>
                  我们重视每一位 Python 社区成员的参与，并希望所有参加者都能拥有愉快而充实的体验。因此，所有参加者都应在整个会议期间，以及所有与会议相关的活动中，对其他参加者保持尊重与礼貌，无论该活动是否由 PyCon Hong Kong 主办单位正式赞助。
                </p>
                <p>
                  为了清楚说明我们对行为的期望，所有 PyCon 活动中的工作人员、参加者、讲者、参展单位、主办者及志愿者，都必须遵守以下行为准则。主办单位将在整个活动期间执行本准则。
                </p>

                <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">我们的标准</h2>
                <p>
                  PyCon 致力于为每一位参与者提供正面而安全的大会体验，不论其年龄、性别认同与表达、性取向、身心障碍、外表、体型、族裔、国籍、种族、宗教（或无宗教信仰）、教育背景或社会经济地位。
                </p>
                <p>有助于建立正面环境的行为包括：</p>
                <ul class="list-disc ml-6 space-y-2">
                  <li>友善对待他人</li>
                  <li>以专业方式行事</li>
                  <li>使用欢迎且具包容性的语言</li>
                  <li>尊重不同观点与经验</li>
                  <li>以成熟态度接受建设性批评</li>
                  <li>专注于对社区最有益的事情</li>
                  <li>对其他社区成员展现同理心</li>
                </ul>

                <p class="pt-2">不可接受的行为包括：</p>
                <ul class="list-disc ml-6 space-y-2">
                  <li>以任何形式骚扰大会参加者</li>
                  <li>蓄意恐吓、跟踪或尾随他人</li>
                  <li>对他人作出暴力威胁或使用威吓性言语</li>
                  <li>在会场任何地方（包括演讲内容）使用带有性意味的语言或图像</li>
                  <li>侮辱、贬低或羞辱他人</li>
                  <li>性别歧视、种族歧视、恐同、恐跨、歧视残障或排他性的笑话</li>
                  <li>过度粗言秽语</li>
                  <li>不受欢迎的性暗示或性挑逗</li>
                  <li>不受欢迎的身体接触</li>
                  <li>持续打断演讲或其他活动</li>
                  <li>其他不适合多元专业观众场合的行为</li>
                </ul>
                <p>当参加者被要求停止任何不当行为时，应立即遵从。</p>
                <p>
                  如有参加者作出违反本行为准则的行为，主办单位可视情况采取其认为合适的方法，包括口头或书面警告，或在不退款的情况下取消其参与资格。
                </p>
                <p>感谢你一起协助建立一个友善、欢迎所有人的活动环境。</p>

                <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">武器政策</h2>
                <p>
                  会议场地内禁止携带任何武器，包括但不限于爆炸品（包括烟花）、枪械、大型刀具以及任何可能用作伤害他人的物品。任何被发现持有上述物品的人士将被要求立即离场，并只有在不携带武器的情况下方可返回。
                </p>

                <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">适用范围</h2>
                <p>
                  所有 PyCon Hong Kong 参加者均受本行为准则约束，包括工作人员及志愿者，以及教学课、工作坊、峰会、正式会议、sprint、赞助活动或非官方聚会的参加者。
                </p>

                <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">联系方式</h2>
                <p>
                  如果你认为有人在 PyCon 活动期间违反了行为准则，请立即联系现场工作人员。<br />
                  Email: <a href="mailto:pycon@pycon.hk" class="font-bold text-[#d71920] underline">pycon@pycon.hk</a>
                </p>

                <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">事件处理程序</h2>
                <p class="space-x-4">
                  <a href={attendeeReportingHref} class="font-bold text-[#d71920] underline">
                    事件举报程序 →
                  </a>
                  <a href={staffProceduresHref} class="font-bold text-[#2f559a] underline">
                    执行程序 →
                  </a>
                </p>
              </div>
            </div>
          ) : locale === 'ja' ? (
            <div>
              <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-[#172033] text-center tracking-tight mb-8">
                行動規範の概要
              </h1>
              <div class="space-y-6 text-slate-700 leading-relaxed font-medium">
                <p>
                  PyCon Hong Kong は、開発者コミュニティの交流と協力のためのコミュニティカンファレンスです。
                </p>
                <p>
                  私たちは、Python コミュニティのすべての参加者を大切にし、誰もが安心して充実した体験を得られる場であることを目指しています。
                </p>
                <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">私たちの基準</h2>
                <ul class="list-disc ml-6 space-y-2">
                  <li>他者に親切であること</li>
                  <li>プロフェッショナルに行動すること</li>
                  <li>歓迎的で包摂的な言葉を使うこと</li>
                  <li>異なる視点や経験を尊重すること</li>
                  <li>建設的な批判を冷静に受け止めること</li>
                </ul>

                <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">連絡先および手順</h2>
                <p>
                  Email: <a href="mailto:pycon@pycon.hk" class="font-bold text-[#d71920] underline">pycon@pycon.hk</a>
                </p>
                <p class="space-x-4">
                  <a href={attendeeReportingHref} class="font-bold text-[#d71920] underline">
                    事案報告手順 →
                  </a>
                  <a href={staffProceduresHref} class="font-bold text-[#2f559a] underline">
                    対応手順 →
                  </a>
                </p>
              </div>
            </div>
          ) : (
            <div>
              <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-[#172033] text-center tracking-tight mb-8">
                Code of Conduct Overview
              </h1>
              <div class="space-y-6 text-slate-700 leading-relaxed font-medium">
                <p>
                  PyCon Hong Kong is a community conference intended for networking and collaboration in the developer community.
                </p>
                <p>
                  We value the participation of each member of the Python community and want all attendees to have an enjoyable and fulfilling experience. Accordingly, all attendees are expected to show respect and courtesy to other attendees throughout the conference and at all conference events, whether officially sponsored by the PyCon Hong Kong organisers or not.
                </p>
                <p>
                  To make clear what is expected, all staff, attendees, speakers, exhibitors, organizers, and volunteers at any PyCon event are required to conform to the following Code of Conduct. Organizers will enforce this code throughout the event.
                </p>

                <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">Our Standards</h2>
                <p>
                  PyCon is dedicated to providing a positive conference experience for everyone, regardless of age, gender identity and expression, sexual orientation, disability, physical appearance, body size, ethnicity, nationality, race, or religion (or lack thereof), education, or socio-economic status.
                </p>
                <p>Examples of behavior that contributes to creating a positive environment include:</p>
                <ul class="list-disc ml-6 space-y-2">
                  <li>Being kind to others</li>
                  <li>Behaving professionally</li>
                  <li>Using welcoming and inclusive language</li>
                  <li>Being respectful of differing viewpoints and experiences</li>
                  <li>Gracefully accepting constructive criticism</li>
                  <li>Focusing on what is best for the community</li>
                  <li>Showing empathy towards other community members</li>
                </ul>

                <p class="pt-2">Examples of unacceptable behavior by participants include:</p>
                <ul class="list-disc ml-6 space-y-2">
                  <li>Harassment of conference participants in any form</li>
                  <li>Deliberate intimidation, stalking, or following</li>
                  <li>Violent threats or language directed against another person</li>
                  <li>Sexual language and imagery in any conference venue, including talks</li>
                  <li>Insults or put downs</li>
                  <li>Sexist, racist, homophobic, transphobic, ableist, or exclusionary jokes</li>
                  <li>Excessive swearing</li>
                  <li>Unwelcome sexual attention or advances</li>
                  <li>Unwelcome physical contact</li>
                  <li>Sustained disruption of talks or other events</li>
                  <li>Other conduct that is inappropriate for a professional audience including people of many different backgrounds</li>
                </ul>
                <p>Participants asked to stop any inappropriate behavior are expected to comply immediately.</p>
                <p>
                  If a participant engages in behavior that violates this code of conduct, the conference organizers may take any action they deem appropriate, including warning the offender or expulsion from the conference with no refund.
                </p>
                <p>Thank you for helping make this a welcoming, friendly event for all.</p>

                <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">Weapons Policy</h2>
                <p>
                  No weapons are allowed at conference venues, including but not limited to explosives (including fireworks), guns, and large knives such as those used for hunting or display, as well as any other item used for the purpose of causing injury or harm to others. Anyone seen in possession of one of these items will be asked to leave immediately, and will only be allowed to return without the weapon.
                </p>

                <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">Scope</h2>
                <p>
                  All PyCon Hong Kong attendees are subject to the Code of Conduct. This includes PyCon Hong Kong staff and volunteers, as well as attendees of the tutorials, workshops, summits, poster sessions, receptions, conference, sprints, and sponsored or unofficial events.
                </p>

                <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">Contact Information</h2>
                <p>
                  If you believe that someone is violating the code of conduct during a PyCon event, or have any other concerns, please contact a member of the event staff immediately.
                </p>
                <p>
                  PyCon Hong Kong<br />
                  Email: <a href="mailto:pycon@pycon.hk" class="font-bold text-[#d71920] underline">pycon@pycon.hk</a>
                </p>

                <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">Procedure for Handling Incidents</h2>
                <p class="space-x-4">
                  <a href={attendeeReportingHref} class="font-bold text-[#d71920] underline">
                    Procedures for Reporting Incidents →
                  </a>
                  <a href={staffProceduresHref} class="font-bold text-[#2f559a] underline">
                    Enforcement Procedures →
                  </a>
                </p>
                <p class="text-xs text-slate-500 pt-4">
                  This Code of Conduct was forked from PyCon US from the Python GitHub. The PyCon Code of Conduct is licensed under a Creative Commons Attribution 3.0 Unported License.
                </p>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>
</ConferenceLayout>
