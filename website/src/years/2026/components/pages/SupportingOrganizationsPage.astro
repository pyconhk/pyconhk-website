---
import { Icon } from 'astro-icon/components';
import { getConferenceContent } from '@/lib/conference-content';
import CommunityPageFrame from '@/years/2026/components/content/CommunityPageFrame.astro';
import OrganizationLogo from '@/years/2026/components/content/OrganizationLogo.astro';
import WovenCardCorners from '@/years/2026/components/content/WovenCardCorners.astro';
import { contentUi } from '@/years/2026/data/content-ui';
import { pageCopyByLocale } from '@/years/2026/data/supporting-organizations';
import type { CfpLocale } from '@/years/2026/locales';

interface Props { locale: CfpLocale; }
const { locale } = Astro.props;
const { organizations } = getConferenceContent(locale);
const items = organizations.items.filter((item) => item.kind === 'supporter');
const copy = pageCopyByLocale[locale];
---
<CommunityPageFrame locale={locale} title={copy.title} subtitle={copy.subtitle} intro={copy.intro} wide framed={false}>
  {organizations.status !== 'published' || items.length === 0 ? <p data-content-pending>{contentUi[locale].comingSoon}</p> : (
    <div data-conference-content="supporters" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {items.map((item) => {
        const Tag = item.url ? 'a' : 'div';
        return <article class="group relative isolate flex min-w-0 flex-col overflow-hidden rounded-2xl border border-conference-outline/40 bg-conference-surface shadow-[3px_3px_0_var(--conference-shadow)] transition-shadow hover:shadow-[5px_5px_0_#2f559a] motion-reduce:transition-none">
          <WovenCardCorners />
          <div class="px-7 pt-10 sm:px-8">
            <Tag href={item.url || undefined} target={item.url ? '_blank' : undefined} rel={item.url ? 'noopener noreferrer' : undefined} aria-label={item.url ? `${copy.visitWebsite}: ${item.name}` : undefined} class="organization-logo-plate relative flex h-48 w-full items-center justify-center rounded-lg p-5 focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-conference-blue">
              {item.logo && <OrganizationLogo src={item.logo} alt={item.name} />}
            </Tag>
          </div>
          <div class="relative flex flex-1 flex-col px-7 pb-10 pt-6 sm:px-8">
            <h2 class="text-lg font-black leading-snug text-conference-ink">{item.name}</h2>
            <p class="mt-3 whitespace-pre-line text-sm font-medium leading-relaxed text-conference-body">{item.description}</p>
            {item.url && <div class="mt-auto pt-6"><a href={item.url} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 text-sm font-bold text-conference-blue underline decoration-conference-blue/30 underline-offset-4 hover:decoration-current focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-conference-blue">{copy.visitWebsite}<Icon name="heroicons-outline:arrow-right" class="h-4 w-4 -rotate-45" aria-hidden="true" /></a></div>}
          </div>
        </article>;
      })}
    </div>
  )}
</CommunityPageFrame>

<style>
  .organization-logo-plate { background: var(--conference-logo-plate); color-scheme: light; }
</style>
