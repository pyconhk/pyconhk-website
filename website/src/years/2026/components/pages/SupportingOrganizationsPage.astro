---
import { getConferenceContent } from '@/lib/conference-content';
import CommunityPageFrame from '@/years/2026/components/content/CommunityPageFrame.astro';
import OrganizationLogo from '@/years/2026/components/content/OrganizationLogo.astro';
import { contentUi } from '@/years/2026/data/content-ui';
import { pageCopyByLocale } from '@/years/2026/data/supporting-organizations';
import type { CfpLocale } from '@/years/2026/locales';

interface Props { locale: CfpLocale; }
const { locale } = Astro.props;
const { organizations } = getConferenceContent(locale);
const items = organizations.items.filter((item) => item.kind === 'supporter');
const copy = pageCopyByLocale[locale];
---
<CommunityPageFrame locale={locale} title={copy.title} subtitle={copy.subtitle} intro={copy.intro} wide>
  {organizations.status !== 'published' || items.length === 0 ? <p data-content-pending>{contentUi[locale].comingSoon}</p> : (
    <div data-conference-content="supporters" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => {
        const Tag = item.url ? 'a' : 'div';
        return <article class="group flex min-w-0 flex-col justify-between rounded-2xl border-2 border-conference-outline bg-conference-paper p-5 shadow-[4px_4px_0_var(--conference-shadow)] hover:shadow-[6px_6px_0_#d71920] sm:p-6">
          <div>
            <Tag href={item.url || undefined} target={item.url ? '_blank' : undefined} rel={item.url ? 'noopener noreferrer' : undefined} aria-label={item.url ? `${copy.visitWebsite}: ${item.name}` : undefined} class="organization-logo-plate flex h-48 w-full items-center justify-center rounded-xl border-2 border-conference-outline bg-conference-surface p-4 shadow-[2px_2px_0_var(--conference-shadow)]">
              {item.logo && <OrganizationLogo src={item.logo} alt={item.name} />}
            </Tag>
            <h2 class="mt-5 text-center text-base font-black leading-snug text-conference-ink sm:text-lg">{item.name}</h2>
            <p class="mt-3 whitespace-pre-line text-center text-sm font-medium leading-relaxed text-conference-body">{item.description}</p>
          </div>
          {item.url && <div class="mt-5 border-t border-conference-outline/10 pt-4 text-center"><a href={item.url} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-10 items-center gap-2 rounded-full border-2 border-conference-outline bg-conference-surface px-4 py-2 text-xs font-black text-conference-ink shadow-[2px_2px_0_var(--conference-shadow)] hover:bg-[#d71920] hover:text-white">{copy.visitWebsite}<span aria-hidden="true">↗</span></a></div>}
        </article>;
      })}
    </div>
  )}
</CommunityPageFrame>

<style>
  .organization-logo-plate { background: var(--conference-logo-plate); color-scheme: light; }
</style>
