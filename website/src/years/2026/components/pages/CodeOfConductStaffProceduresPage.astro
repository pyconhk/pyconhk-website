---
import ConferenceLayout from '@/years/2026/layouts/ConferenceLayout.astro';
import type { CfpLocale } from '@/years/2026/locales';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const cocHref = `/2026/${locale}/code-of-conduct/`;
const attendeeReportingHref = `/2026/${locale}/code-of-conduct/attendee-reporting/`;

const pageTitle = 'Enforcement Procedures | PyCon HK 2026';
const pageDescription = 'Procedures used by PyCon HK staff to enforce the Code of Conduct.';
---

<ConferenceLayout title={pageTitle} description={pageDescription} locale={locale}>
  <section lang="en" data-policy-body class="py-12 sm:py-16 lg:py-20 bg-[#FAF7F0]">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mb-6">
        <a href={cocHref} class="inline-flex items-center gap-1 text-xs font-bold text-[#2f559a] hover:text-[#d71920]">
          ← Back to Code of Conduct Overview
        </a>
      </div>

      <div class="rounded-3xl border-3 border-[#172033] bg-white p-6 sm:p-10 lg:p-12 shadow-[8px_8px_0_#172033]">
        <h1 class="font-operetta-32 text-3xl sm:text-4xl md:text-5xl text-[#172033] font-black uppercase text-center tracking-tight mb-8">
          Enforcement Procedures
        </h1>

        <div class="space-y-6 text-slate-700 leading-relaxed font-medium">
          <p>
            This document outlines the procedures used by PyCon HK staff when enforcing the Code of Conduct.
          </p>

          <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">
            Process Summary
          </h2>
          <p>
            When a report is received, the team will:
          </p>
          <ul class="list-disc ml-6 space-y-2">
            <li>Acknowledge receipt of the report.</li>
            <li>Evaluate conflicts of interest.</li>
            <li>Convene non-conflicted responders.</li>
            <li>Evaluate the incident and its impact.</li>
            <li>Propose corrective actions and consequences.</li>
            <li>Follow up with involved parties.</li>
          </ul>

          <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">
            Conflicts of Interest
          </h2>
          <p>
            Any committee member with a conflict of interest will recuse themselves from deliberations.
          </p>

          <div class="pt-6 border-t border-slate-200 flex flex-wrap gap-4">
            <a href={cocHref} class="font-bold text-[#2f559a] underline">
              Code of Conduct Overview
            </a>
            <a href={attendeeReportingHref} class="font-bold text-[#d71920] underline">
              Incident Reporting Procedures
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</ConferenceLayout>
