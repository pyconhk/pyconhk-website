---
import { Icon } from 'astro-icon/components';
import { getConferenceContent } from '@/lib/conference-content';
import CommunityPageFrame from '@/years/2026/components/content/CommunityPageFrame.astro';
import { contentUi } from '@/years/2026/data/content-ui';
import { pageCopyByLocale, sponsorBenefits, sponsorshipPlans } from '@/years/2026/data/sponsorships';
import type { CfpLocale } from '@/years/2026/locales';
import { sponsorshipEmail } from '@/years/2026/site';

interface Props { locale: CfpLocale; }
const { locale } = Astro.props;
const copy = contentUi[locale];
const pageCopy = pageCopyByLocale[locale];
const { sponsorship } = getConferenceContent(locale);
const availability = {
  en: ['Included', 'Not included'],
  'zh-hk': ['包括', '不包括'],
  'zh-hant': ['包括', '不包括'],
  'zh-hans': ['包括', '不包括'],
  ja: ['含まれます', '含まれません'],
  ko: ['포함', '미포함'],
}[locale];
// Feature IDs are positions within each plan, not shared benefit identifiers.
const featureLabels = [...new Set(sponsorship.plans.flatMap((plan) => plan.features.map((feature) => feature.label)))];
const slotLabels = { en: 'Available packages', 'zh-hk': '贊助名額', 'zh-hant': '贊助名額', 'zh-hans': '赞助名额', ja: '募集枠数', ko: '모집 구좌' };
const unlimitedLabels = { en: 'Unlimited', 'zh-hk': '不限', 'zh-hant': '不限', 'zh-hans': '不限', ja: '制限なし', ko: '제한 없음' };
const navigation = { en: ['Previous sponsorship plan', 'Next sponsorship plan'], 'zh-hk': ['上一個贊助方案', '下一個贊助方案'], 'zh-hant': ['上一個贊助方案', '下一個贊助方案'], 'zh-hans': ['上一个赞助方案', '下一个赞助方案'], ja: ['前のスポンサー枠', '次のスポンサー枠'], ko: ['이전 후원 패키지', '다음 후원 패키지'] }[locale];
---
<CommunityPageFrame locale={locale} title={pageCopy.title} subtitle={pageCopy.subtitle} wide>
  {sponsorship.status !== 'published' ? <p data-content-pending>{copy.comingSoon}</p> : (
    <div class="space-y-12 sm:space-y-16" data-published-sponsorship>
      <div class="mx-auto max-w-3xl space-y-4 text-sm font-medium leading-relaxed text-conference-body sm:text-base">{sponsorship.intro.map((paragraph) => <p class="whitespace-pre-line">{paragraph}</p>)}</div>
      <section class="space-y-8 border-t-2 border-conference-outline/15 pt-8">
        <h2 class="section-title font-sans">{pageCopy.whySponsorTitle}</h2>
        <div class="grid gap-6 md:grid-cols-3">
          {sponsorship.benefits.map((benefit, index) => <article class="flex flex-col items-center gap-4 rounded-2xl border-2 border-conference-outline bg-conference-paper p-6 text-center shadow-conference-card">
            <span aria-hidden="true" class="flex h-14 w-14 items-center justify-center rounded-2xl border-2 border-conference-outline bg-conference-surface text-conference-blue shadow-conference-control"><Icon name={`heroicons-outline:${sponsorBenefits[index]?.icon || 'heart'}`} class="h-7 w-7" /></span>
            <h3 class="text-lg font-black text-conference-ink">{benefit.title}</h3><p class="text-sm font-medium leading-relaxed text-conference-body">{benefit.description}</p>
          </article>)}
        </div>
      </section>
      <section class="space-y-8 border-t-2 border-conference-outline/15 pt-8">
        <header class="space-y-3 text-center"><h2 class="section-title font-sans">{pageCopy.plansTitle}</h2><p class="text-sm font-medium text-conference-body">{pageCopy.plansDescription}</p></header>
        <div data-sponsorship-carousel>
          <section data-sponsorship-track tabindex="0" aria-label={pageCopy.plansTitle} class="plan-track">
            {sponsorship.plans.map((plan) => {
              const appearance = sponsorshipPlans.find((original) => original.tier === plan.tier);
              return <article data-plan-card class="plan-card flex min-w-0 flex-col overflow-hidden rounded-2xl border-2 border-conference-outline bg-conference-paper shadow-conference-card">
                <header class:list={['space-y-1 border-b-2 border-conference-outline px-4 py-3', appearance?.headerBg || 'bg-[#2f559a]', appearance?.headerText || 'text-white']}>
                  <h3 class="text-xl font-black">{plan.name}</h3><p class="text-sm font-bold">{pageCopy.sponsorshipFeeLabel}: <span class="font-black">{plan.fee}</span></p>
                </header>
                <div class="space-y-2 px-4 py-3">
                  {plan.maxSlots && <p class="inline-block rounded-lg border-2 border-conference-outline bg-conference-surface px-3 py-1 text-xs font-black text-conference-ink shadow-conference-control">{slotLabels[locale]}: {plan.maxSlots === 'unlimited' ? unlimitedLabels[locale] : plan.maxSlots}</p>}
                  <dl class="text-sm leading-5">{featureLabels.map((label) => {
                    const value = plan.features.find((feature) => feature.label === label)?.value;
                    const included = value === availability[0];
                    const excluded = value === undefined || value === availability[1];
                    return <div class="plan-feature border-b border-conference-outline/10 last:border-0">
                      <dt class="min-w-0 break-words text-conference-body">{label}</dt>
                      <dd class="min-w-0 break-words text-right font-bold text-conference-ink">
                        {included || excluded ? <span class="inline-flex align-middle" data-availability={included ? 'included' : 'excluded'}>
                          <Icon name={included ? 'heroicons-outline:check' : 'heroicons-outline:x-mark'} class="h-5 w-5" aria-hidden="true" />
                          <span class="sr-only">{availability[included ? 0 : 1]}</span>
                        </span> : value}
                      </dd>
                    </div>;
                  })}</dl>
                </div>
              </article>;
            })}
          </section>
          <div class="mt-2 flex items-center justify-center gap-3" data-sponsorship-controls hidden>
            <button type="button" data-sponsorship-scroll="prev" aria-label={navigation[0]} class="plan-control">←</button>
            <fieldset class="flex" aria-label={pageCopy.plansTitle}>
              {sponsorship.plans.map((plan) => <button type="button" data-sponsorship-dot aria-label={plan.name} class="plan-dot"><span aria-hidden="true" /></button>)}
            </fieldset>
            <output data-sponsorship-position aria-live="polite" class="sr-only" />
            <button type="button" data-sponsorship-scroll="next" aria-label={navigation[1]} class="plan-control">→</button>
          </div>
        </div>
      </section>
    </div>
  )}
  <section class="space-y-4 rounded-3xl border-3 border-conference-outline bg-conference-yellow p-6 text-center shadow-conference-panel sm:p-10">
    <h2 class="section-title font-sans">{pageCopy.ctaTitle}</h2><p class="mx-auto max-w-xl text-sm font-bold text-conference-ink sm:text-base">{pageCopy.ctaDescription}</p>
    <a href={sponsorshipEmail} class="inline-flex rounded-full border-2 border-conference-outline bg-[#d71920] px-7 py-3 font-black text-white shadow-conference-card hover:bg-[#c0151c]">{pageCopy.ctaButtonLabel}</a>
  </section>
</CommunityPageFrame>

<style>
  .section-title { font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 900; text-align: center; text-transform: uppercase; color: var(--conference-ink); }
  .plan-track { display: flex; align-items: flex-start; position: relative; gap: 1.5rem; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; padding: 2px 6px 8px 2px; }
  .plan-card { flex: 0 0 100%; scroll-snap-align: start; }
  .plan-feature { display: grid; grid-template-columns: minmax(0, 1fr) fit-content(60%); align-items: center; gap: .5rem; padding-block: .375rem; }
  @media (min-width: 640px) { .plan-card { flex-basis: calc((100% - 1.5rem) / 2); } }
  @media (min-width: 1024px) { .plan-card { flex-basis: calc((100% - 3rem) / 3); } }
  .plan-control { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 2px solid var(--conference-outline); border-radius: .75rem; background: var(--conference-surface); box-shadow: var(--conference-shadow-control); color: var(--conference-ink); font-weight: 900; }
  .plan-control:hover:not(:disabled) { background: #d71920; color: white; }
  .plan-control:disabled { opacity: .4; box-shadow: none; }
  .plan-dot { display: flex; align-items: center; justify-content: center; width: 24px; height: 44px; cursor: pointer; }
  .plan-dot[hidden] { display: none; }
  .plan-dot span { width: 8px; height: 8px; border: 2px solid var(--conference-outline); border-radius: 50%; }
  .plan-dot[aria-current="true"] span { background: var(--conference-ink); }
  .plan-track:focus-visible, .plan-control:focus-visible, .plan-dot:focus-visible { outline: 3px solid #2f559a; outline-offset: 4px; }
</style>

<script>
  function initializeCarousels() {
    for (const carousel of document.querySelectorAll<HTMLElement>('[data-sponsorship-carousel]')) {
      if (carousel.dataset.ready) continue;
      carousel.dataset.ready = 'true';
      const track = carousel.querySelector<HTMLElement>('[data-sponsorship-track]');
      const previous = carousel.querySelector<HTMLButtonElement>('[data-sponsorship-scroll="prev"]');
      const next = carousel.querySelector<HTMLButtonElement>('[data-sponsorship-scroll="next"]');
      const position = carousel.querySelector<HTMLOutputElement>('[data-sponsorship-position]');
      const controls = carousel.querySelector<HTMLElement>('[data-sponsorship-controls]');
      if (!track || !previous || !next || !position || !controls) continue;
      const cards = [...track.querySelectorAll<HTMLElement>('[data-plan-card]')];
      const dots = [...carousel.querySelectorAll<HTMLButtonElement>('[data-sponsorship-dot]')];
      const step = () => (cards[1]?.offsetLeft ?? track.clientWidth) - (cards[0]?.offsetLeft ?? 0);
      const behavior = () => matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth';
      const update = () => {
        previous.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
        const visible = cards.map((card, index) => ({ card, index })).filter(({card}) => card.offsetLeft + card.offsetWidth > track.scrollLeft + 4 && card.offsetLeft < track.scrollLeft + track.clientWidth - 4);
        position.value = visible.map(({ index }) => dots[index].getAttribute('aria-label')).join(' · ');
        const lastPosition = Math.round((track.scrollWidth - track.clientWidth) / step());
        const currentPosition = Math.min(lastPosition, Math.round(track.scrollLeft / step()));
        dots.forEach((dot, index) => {
          dot.hidden = index > lastPosition;
          if (index === currentPosition) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
        controls.hidden = track.scrollWidth <= track.clientWidth + 2;
      };
      const scroll = (direction: number) => track.scrollBy({ left: direction * step(), behavior: behavior() });
      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => track.scrollTo({ left: index * step(), behavior: behavior() }));
      });
      previous.addEventListener('click', () => scroll(-1));
      next.addEventListener('click', () => scroll(1));
      track.addEventListener('scroll', update, { passive: true });
      new ResizeObserver(update).observe(track);
      update();
    }
  }
  initializeCarousels();
  document.addEventListener('astro:page-load', initializeCarousels);
</script>
