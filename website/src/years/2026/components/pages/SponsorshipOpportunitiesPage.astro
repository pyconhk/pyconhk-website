---
import { getConferenceContent } from '@/lib/conference-content';
import ContentPageFrame from '@/years/2026/components/content/ContentPageFrame.astro';
import { contentUi } from '@/years/2026/data/content-ui';
import type { CfpLocale } from '@/years/2026/locales';
import { sponsorshipEmail } from '@/years/2026/site';

interface Props { locale: CfpLocale; }
const { locale } = Astro.props;
const copy = contentUi[locale];
const { sponsorship } = getConferenceContent(locale);
const slotLabels = { en: 'Available packages', 'zh-hk': '可供贊助名額', 'zh-hant': '可供贊助名額', 'zh-hans': '可供赞助名额', ja: '募集枠数', ko: '모집 구좌' };
---
<ContentPageFrame locale={locale} title={copy.sponsorship}>
  {sponsorship.status !== 'published' ? <p data-content-pending>{copy.comingSoon}</p> : (
    <div class="space-y-8" data-published-sponsorship>
      {sponsorship.intro.map((paragraph) => <p class="whitespace-pre-line">{paragraph}</p>)}
      <div class="grid gap-6 sm:grid-cols-2">
        {sponsorship.benefits.map((benefit) => <section class="space-y-3 rounded-2xl border-2 border-[#172033] p-6"><h2 class="text-xl font-bold text-[#2f559a]">{benefit.title}</h2><p>{benefit.description}</p></section>)}
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {sponsorship.plans.map((plan) => <section class="space-y-4 rounded-2xl border-2 border-[#172033] p-6"><h2 class="text-2xl font-bold text-[#2f559a]">{plan.name}</h2><p class="text-xl font-bold">{plan.fee}</p>{plan.maxSlots && <p>{slotLabels[locale]}: {plan.maxSlots}</p>}<dl class="space-y-3">{plan.features.map((feature) => <div><dt class="font-bold">{feature.label}</dt><dd>{feature.value}</dd></div>)}</dl></section>)}
      </div>
    </div>
  )}
  <a href={sponsorshipEmail} class="inline-flex rounded-full border-2 border-[#172033] bg-[#d71920] px-5 py-3 font-bold text-white">{copy.sponsorship}</a>
</ContentPageFrame>
