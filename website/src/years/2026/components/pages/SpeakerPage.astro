---
import { formatProgrammeDate, isSampleProgramme } from '../../data/schedule';
import { scheduleCopy } from '../../data/schedule-copy';
import type { ProgrammeSpeaker } from '../../data/speakers';
import type { CfpLocale } from '../../locales';
import ContentPageFrame from '../content/ContentPageFrame.astro';
import PersonCard from '../content/PersonCard.astro';
import DoodleButton from '../DoodleButton.astro';
import { renderProgrammeMarkdown } from '../schedule/programme-content.ts';
import WovenRibbon from '../ui/WovenRibbon.astro';

interface Props { locale: CfpLocale; speaker: ProgrammeSpeaker }
const { locale, speaker } = Astro.props;
const copy = scheduleCopy[locale];
const biography = await renderProgrammeMarkdown(speaker.biography);
---
<ContentPageFrame locale={locale} title={speaker.name} description={`${speaker.name} · ${copy.speakers} | PyCon HK 2026`}>
  <WovenRibbon />
  {isSampleProgramme && <p data-sample-notice class="rounded-xl border-2 border-[#172033] bg-[#ffd343]/25 p-4 text-sm font-bold">{copy.sample}</p>}
  <div data-speaker-page class="speaker-intro grid min-w-0 gap-8 py-4 sm:grid-cols-[11rem_minmax(0,1fr)]">
    {speaker.avatar ? <PersonCard name={speaker.name} imageSrc={speaker.avatar} /> : <div aria-hidden="true" class="mx-auto flex h-36 w-36 items-center justify-center rounded-2xl border-2 border-[#172033] bg-[#2f559a] text-5xl font-black text-white shadow-[4px_4px_0_#172033]">{Array.from(speaker.name)[0]}</div>}
    <section class="min-w-0">
      <h2 class="mb-4 text-xs font-black uppercase tracking-widest text-[#d71920]">{copy.aboutSpeaker}</h2>
      {biography && <div data-speaker-biography class="programme-richtext prose max-w-none text-slate-700" set:html={biography} />}
    </section>
  </div>
  <section class="border-t-2 border-dashed border-[#172033]/25 pt-8">
    <h2 class="ideal-heading mb-6 text-2xl font-black text-[#172033] sm:text-3xl">{copy.speakerSessions}</h2>
    <div class="grid gap-5">
      {speaker.sessions.map((session) => <article class="min-w-0 rounded-2xl border-2 border-[#172033] bg-[#FAF7F0] p-5 shadow-[4px_4px_0_#172033] sm:p-6">
        <p class="mb-3 text-xs font-black text-[#2f559a]">{formatProgrammeDate(session.date, locale)} · {session.startTime}–{session.endTime} (UTC+8)</p>
        <h3 class="text-lg font-black text-[#172033] sm:text-xl"><a data-speaker-session href={`/2026/${locale}/schedule/?session=${encodeURIComponent(session.id)}`} class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">{session.title}<span aria-hidden="true" class="ml-3 shrink-0 text-[#d71920]">↗</span></a></h3>
        <p class="mt-3 text-sm">{session.room}</p>
      </article>)}
    </div>
  </section>
  <div class="pt-4"><DoodleButton href={`/2026/${locale}/schedule/`} label={copy.backToSchedule} variant="secondary"><span aria-hidden="true" class="mr-2">←</span>{copy.backToSchedule}</DoodleButton></div>
</ContentPageFrame>
<style>
  .speaker-intro, article { overflow-wrap: anywhere; }
  .programme-richtext :global(pre) { max-width: 100%; overflow-x: auto; }
  .programme-richtext :global(img) { max-width: 100%; height: auto; }
</style>
