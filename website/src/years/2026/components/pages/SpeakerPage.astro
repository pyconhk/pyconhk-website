---
import { formatProgrammeDate, isSampleProgramme } from '../../data/schedule';
import { scheduleCopy } from '../../data/schedule-copy';
import type { ProgrammeSpeaker } from '../../data/speakers';
import type { CfpLocale } from '../../locales';
import ContentPageFrame from '../content/ContentPageFrame.astro';
import SpeakerAvatar from '../content/SpeakerAvatar.astro';
import DoodleButton from '../DoodleButton.astro';
import { renderProgrammeMarkdown } from '../schedule/programme-content.ts';
import WovenRibbon from '../ui/WovenRibbon.astro';

interface Props { locale: CfpLocale; speaker: ProgrammeSpeaker }
const { locale, speaker } = Astro.props;
const copy = scheduleCopy[locale];
const biography = await renderProgrammeMarkdown(speaker.biography);
---
<ContentPageFrame locale={locale} title={speaker.name} description={`${speaker.name} · ${copy.speakers} | PyCon HK 2026`}>
  <WovenRibbon />
  {isSampleProgramme && <p data-sample-notice class="rounded-xl border-2 border-conference-outline bg-conference-yellow/25 p-4 text-sm font-bold">{copy.sample}</p>}
  <div data-speaker-page class="speaker-intro grid min-w-0 gap-8 py-4 sm:grid-cols-[11rem_minmax(0,1fr)]">
    <div data-person-card class="group flex w-full min-w-0 max-w-44 flex-col items-center text-center">
      <SpeakerAvatar name={speaker.name} src={speaker.avatar} variant="page" />
      <div class="mt-3 flex flex-wrap items-center justify-center gap-1.5">
        <h4 class="w-full break-words text-sm sm:text-base font-bold text-conference-ink tracking-tight">{speaker.name}</h4>
      </div>
    </div>
    <section class="min-w-0">
      <h2 class="mb-4 text-xs font-black uppercase tracking-widest text-conference-red">{copy.aboutSpeaker}</h2>
      {biography && <div data-speaker-biography class="programme-richtext prose max-w-none text-conference-body" set:html={biography} />}
    </section>
  </div>
  <section class="border-t-2 border-dashed border-conference-outline/25 pt-8">
    <h2 class="font-sans mb-6 text-2xl font-black text-conference-ink sm:text-3xl">{copy.speakerSessions}</h2>
    <div class="grid gap-5">
      {speaker.sessions.map((session) => <article class="min-w-0 rounded-2xl border-2 border-conference-outline bg-conference-paper p-5 shadow-conference-card sm:p-6">
        <p class="mb-3 text-xs font-black text-conference-blue">{formatProgrammeDate(session.date, locale)} · {session.startTime}–{session.endTime} (UTC+8)</p>
        <h3 class="text-lg font-black text-conference-ink sm:text-xl"><a data-speaker-session href={`/2026/${locale}/schedule/?session=${encodeURIComponent(session.id)}`} class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">{session.title}<span aria-hidden="true" class="ml-3 shrink-0 text-conference-red">↗</span></a></h3>
        <p class="mt-3 text-sm">{session.room}</p>
      </article>)}
    </div>
  </section>
  <div class="pt-4"><DoodleButton href={`/2026/${locale}/schedule/`} label={copy.backToSchedule} variant="secondary"><span aria-hidden="true" class="mr-2">←</span>{copy.backToSchedule}</DoodleButton></div>
</ContentPageFrame>
<style>
  .speaker-intro, article { overflow-wrap: anywhere; }
  .programme-richtext :global(pre) { max-width: 100%; overflow-x: auto; }
  .programme-richtext :global(img) { max-width: 100%; height: auto; }
</style>
