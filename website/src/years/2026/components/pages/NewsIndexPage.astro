---
import { getPublishedPosts } from '@/lib/news';
import NewsCard from '@/years/2026/components/news/NewsCard.astro';
import { newsMessages } from '@/years/2026/i18n/news';
import ConferenceLayout from '@/years/2026/layouts/ConferenceLayout.astro';
import type { CfpLocale } from '@/years/2026/locales';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const articles = await getPublishedPosts(2026, locale);
const copy = newsMessages[locale];
---

<ConferenceLayout title={`${copy.title} | PyCon HK 2026`} description={copy.description} locale={locale}>
  <section class="w-full bg-[#FAF7F0] px-4 py-10 sm:px-6 sm:py-16 lg:px-8">
    <div class="mx-auto max-w-6xl rounded-3xl border-3 border-[#172033] bg-white p-6 shadow-[8px_8px_0_#172033] sm:p-10 md:p-14">
      <header class="mx-auto mb-10 max-w-2xl space-y-3 text-center sm:mb-12">
        <p class="inline-flex rounded-full border-2 border-[#172033] bg-[#FAF7F0] px-3.5 py-1 text-xs font-black uppercase text-[#172033] shadow-[2px_2px_0_#172033]">{copy.subtitle}</p>
        <h1 class="font-operetta-32 text-3xl font-black uppercase tracking-tight text-[#172033] sm:text-4xl md:text-5xl">{copy.title}</h1>
        <p class="text-sm font-medium text-slate-600 sm:text-base">{copy.description}</p>
      </header>
      {articles.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3">
          {articles.map(article => <NewsCard article={article} locale={locale} />)}
        </div>
      ) : (
        <p class="rounded-2xl border-2 border-[#172033]/15 bg-[#FAF7F0] p-8 text-center text-slate-600">{copy.empty}</p>
      )}
    </div>
  </section>
</ConferenceLayout>
