---
import PersonCard from '@/years/2026/components/content/PersonCard.astro';
import {
  conferenceChair,
  conferenceCoChairs,
  organizingCommitteeMembers,
  pageCopyByLocale,
} from '@/years/2026/data/volunteers';
import ConferenceLayout from '@/years/2026/layouts/ConferenceLayout.astro';
import type { CfpLocale } from '@/years/2026/locales';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const pageCopy = pageCopyByLocale[locale] ?? pageCopyByLocale.en;
---

<ConferenceLayout
  title={`${pageCopy.title} | PyCon HK 2026`}
  description={pageCopy.intro}
  locale={locale}
>
  <main class="w-full bg-[#FAF7F0] py-10 sm:py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      
      <!-- Elevated Container Box matching 2026 Design Language -->
      <div class="rounded-3xl border-3 border-[#172033] bg-white p-6 sm:p-10 md:p-14 shadow-[8px_8px_0_#172033] space-y-16">
        
        <!-- Header Section -->
        <div class="text-center max-w-3xl mx-auto space-y-4">
          <div class="inline-flex items-center gap-2 rounded-full border-2 border-[#172033] bg-[#FAF7F0] px-3.5 py-1 text-xs font-black uppercase text-[#172033] shadow-[2px_2px_0_#172033]">
            <span class="h-2 w-2 rounded-full bg-[#d71920]" />
            <span>{pageCopy.subtitle}</span>
          </div>

          <h1 class="font-operetta-32 text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-[#172033] font-black uppercase tracking-tight">
            {pageCopy.title}
          </h1>

          <p class="text-sm sm:text-base text-slate-700 font-medium leading-relaxed max-w-2xl mx-auto">
            {pageCopy.intro}
          </p>
        </div>

        <!-- Executive Committee Section -->
        <section class="space-y-12 pt-8 border-t-2 border-[#172033]/15">
          <div class="text-center space-y-2">
            <h2 class="font-operetta-32 text-2xl sm:text-3xl md:text-4xl text-[#172033] font-black uppercase tracking-tight">
              {pageCopy.committeeHeading}
            </h2>
          </div>

          <!-- Conference Chair -->
          <div class="space-y-6">
            <h3 class="text-center text-sm sm:text-base font-black uppercase tracking-wider text-[#2f559a]">
              {pageCopy.chairHeading}
            </h3>
            <div class="flex justify-center">
              <PersonCard {...conferenceChair} />
            </div>
          </div>

          <!-- Conference Co-Chairs -->
          <div class="space-y-6 pt-4">
            <h3 class="text-center text-sm sm:text-base font-black uppercase tracking-wider text-[#2f559a]">
              {pageCopy.coChairsHeading}
            </h3>
            <div class="flex flex-wrap justify-center gap-8 sm:gap-14">
              {conferenceCoChairs.map((chair) => (
                <PersonCard {...chair} />
              ))}
            </div>
          </div>
        </section>

        <!-- Organizing Committee Members Section -->
        <section class="space-y-10 pt-12 border-t-2 border-[#172033]/15">
          <div class="text-center space-y-2">
            <h2 class="font-operetta-32 text-2xl sm:text-3xl md:text-4xl text-[#172033] font-black uppercase tracking-tight">
              {pageCopy.membersHeading}
            </h2>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6 sm:gap-8 justify-items-center">
            {organizingCommitteeMembers.map((member) => (
              <PersonCard {...member} />
            ))}
          </div>
        </section>

      </div>
    </div>
  </main>
</ConferenceLayout>
