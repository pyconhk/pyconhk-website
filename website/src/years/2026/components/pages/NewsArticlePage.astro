---
import { getLocaleDefinition } from '@/config/site';
import { formatDate } from '@/lib/date';
import { getPostBySlug } from '@/lib/news';
import { newsMessages } from '@/years/2026/i18n/news';
import ConferenceLayout from '@/years/2026/layouts/ConferenceLayout.astro';
import type { CfpLocale } from '@/years/2026/locales';

interface Props {
  locale: CfpLocale;
  slug: string;
}

const { locale, slug } = Astro.props;
const article = await getPostBySlug(2026, slug, locale);

if (!article) {
  throw new Error(`Missing published news article for 2026/${locale}/${slug}`);
}

const copy = newsMessages[locale];
const backHref = `/2026/${locale}/news/`;
---

<ConferenceLayout title={`${article.title} | PyCon HK 2026`} description={article.excerpt} locale={locale} imagePath={article.coverImage}>
  <div class="w-full bg-[#FAF7F0] px-4 py-10 sm:px-6 sm:py-16 lg:px-8">
    <article class="mx-auto max-w-4xl overflow-hidden rounded-3xl border-3 border-[#172033] bg-white p-6 shadow-[8px_8px_0_#172033] sm:p-10 md:p-14" lang={getLocaleDefinition(article.sourceLocale).htmlLang}>
      <a href={backHref} class="mb-6 inline-flex gap-2 rounded-xl border-2 border-[#172033] px-4 py-2 text-sm font-bold text-[#172033] shadow-[2px_2px_0_#172033] hover:bg-slate-50">
        <span aria-hidden="true">←</span> {copy.backToNews}
      </a>
      <img src={article.coverImage} alt="" width="800" height="450" class="mb-8 aspect-[16/9] w-full rounded-2xl border-2 border-[#172033] bg-[#FAF7F0] object-contain p-6" />
      <header class="space-y-4 border-b-2 border-[#172033]/15 pb-8">
        {article.tags.length > 0 && <p class="text-xs font-black text-[#d71920]">{article.tags.join(' · ')}</p>}
        <h1 class="text-2xl font-black leading-snug text-[#172033] sm:text-3xl md:text-4xl">{article.title}</h1>
        <p class="text-sm font-bold text-slate-600">
          <span>{article.authorName}</span> · <time datetime={article.publishedAt}>{formatDate(article.publishedAt, locale)}</time>
        </p>
      </header>
      <div class="prose prose-slate max-w-none py-8 prose-a:text-[#d71920] prose-img:rounded-xl" set:html={article.html} />
      <a href={backHref} class="inline-flex gap-2 border-t-2 border-[#172033]/15 pt-6 text-sm font-bold text-[#172033] hover:text-[#d71920]">
        <span aria-hidden="true">←</span> {copy.backToNews}
      </a>
    </article>
  </div>
</ConferenceLayout>
