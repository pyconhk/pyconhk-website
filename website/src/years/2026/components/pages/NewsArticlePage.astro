---
import { getPostBySlug, getPublishedPostLocales } from '@/lib/news';
import NewsArticle from '@/years/2026/components/NewsArticle.astro';
import ConferenceLayout from '@/years/2026/layouts/ConferenceLayout.astro';
import type { CfpLocale } from '@/years/2026/locales';

interface Props {
  locale: CfpLocale;
  slug: string;
}

const { locale, slug } = Astro.props;
const article = await getPostBySlug(2026, slug, locale);
const availableLocales = await getPublishedPostLocales(2026, slug);

if (!article) {
  throw new Error(`Missing published news article for 2026/${locale}/${slug}`);
}
---

<ConferenceLayout title={`${article.title} | PyCon HK 2026`} description={article.excerpt} locale={locale} imagePath={article.coverImage} availableLocales={availableLocales}>
  <NewsArticle article={article} locale={locale} year={2026} />
</ConferenceLayout>
