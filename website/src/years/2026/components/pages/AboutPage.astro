---
import { pageCopyByLocale, socialLinks } from '@/years/2026/data/about';
import ConferenceLayout from '@/years/2026/layouts/ConferenceLayout.astro';
import type { CfpLocale } from '@/years/2026/locales';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const pageCopy = pageCopyByLocale[locale] ?? pageCopyByLocale.en;
---

<ConferenceLayout
  title={`${pageCopy.title} | PyCon HK 2026`}
  description={pageCopy.paragraphs[0]}
  locale={locale}
>
  <main class="w-full bg-[#FAF7F0] py-10 sm:py-16 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      
      <div class="rounded-3xl border-3 border-[#172033] bg-white p-6 sm:p-10 md:p-14 shadow-[8px_8px_0_#172033] space-y-12">
        
        <!-- Header -->
        <div class="text-center max-w-3xl mx-auto space-y-4">
          <div class="inline-flex items-center gap-2 rounded-full border-2 border-[#172033] bg-[#FAF7F0] px-3.5 py-1 text-xs font-black uppercase text-[#172033] shadow-[2px_2px_0_#172033]">
            <span class="h-2 w-2 rounded-full bg-[#d71920]"></span>
            <span>{pageCopy.subtitle}</span>
          </div>

          <h1 class="font-operetta-32 text-3xl sm:text-4xl md:text-5xl text-[#172033] font-black uppercase tracking-tight">
            {pageCopy.title}
          </h1>
        </div>

        <!-- Featured Event Photo -->
        <div class="relative overflow-hidden rounded-2xl border-3 border-[#172033] bg-[#FAF7F0] shadow-[6px_6px_0_#172033]">
          <img
            src="/2026/events/events.webp"
            alt={pageCopy.imageAlt}
            width="1200"
            height="675"
            class="w-full h-auto object-cover max-h-[560px]"
            loading="eager"
          />
        </div>

        <!-- Narrative Paragraphs -->
        <div class="space-y-6 text-[#172033] text-sm sm:text-base md:text-lg font-medium leading-relaxed">
          {pageCopy.paragraphs.map((paragraph) => (
            <p class="text-slate-800">
              {paragraph}
            </p>
          ))}
        </div>

        <!-- Follow Us / Social Links Section -->
        <div class="pt-8 border-t-2 border-[#172033]/15 space-y-6">
          <div class="flex items-center gap-3">
            <h2 class="font-operetta-32 text-2xl sm:text-3xl text-[#172033] font-black uppercase tracking-tight">
              {pageCopy.socialHeading}
            </h2>
            <div class="h-0.5 flex-1 bg-[#172033]/15"></div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {socialLinks.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between rounded-2xl border-2 border-[#172033] bg-[#FAF7F0] p-4 shadow-[3px_3px_0_#172033] transition-all hover:-translate-y-0.5 hover:shadow-[5px_5px_0_#d71920] hover:bg-white cursor-pointer"
              >
                <div class="min-w-0 pr-2">
                  <span class="block text-xs font-black uppercase tracking-wider text-slate-500 group-hover:text-[#d71920] transition-colors">
                    {item.label}
                  </span>
                  <span class="block text-xs sm:text-sm font-bold text-[#172033] truncate mt-0.5">
                    {item.display}
                  </span>
                </div>

                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl border-2 border-[#172033] bg-white text-[#172033] shadow-[1px_1px_0_#172033] transition-all group-hover:bg-[#d71920] group-hover:text-white">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </div>

      </div>
    </div>
  </main>
</ConferenceLayout>
