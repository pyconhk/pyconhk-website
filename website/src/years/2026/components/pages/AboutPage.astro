---
import { getConferenceContent } from '@/lib/conference-content';
import CommunityPageFrame from '@/years/2026/components/content/CommunityPageFrame.astro';
import { pageCopyByLocale, socialLinks } from '@/years/2026/data/about';
import { contentUi } from '@/years/2026/data/content-ui';
import type { CfpLocale } from '@/years/2026/locales';

interface Props { locale: CfpLocale; }
const { locale } = Astro.props;
const { about } = getConferenceContent(locale);
const copy = pageCopyByLocale[locale];
---
<CommunityPageFrame locale={locale} title={copy.title} subtitle={copy.subtitle}>
  {about.status !== 'published' ? <p data-content-pending>{contentUi[locale].comingSoon}</p> : (
    <div data-conference-content="about" class="space-y-10">
      <div class="overflow-hidden rounded-2xl border-3 border-[#172033] bg-[#FAF7F0] shadow-[6px_6px_0_#172033]">
        <img src="/2026/events/events.webp" alt={copy.imageAlt} width="1200" height="675" class="max-h-[560px] w-full object-cover" />
      </div>
      <div class="space-y-6 text-sm font-medium leading-relaxed text-slate-800 sm:text-base md:text-lg">
        {about.paragraphs.map((paragraph) => <p class="whitespace-pre-line">{paragraph}</p>)}
      </div>
      <section class="space-y-6 border-t-2 border-[#172033]/15 pt-8">
        <h2 class="font-operetta-32 text-2xl font-black uppercase text-[#172033] sm:text-3xl">{copy.socialHeading}</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {socialLinks.map((item) => <a href={item.href} target="_blank" rel="noopener noreferrer" class="group flex min-w-0 items-center justify-between gap-3 rounded-2xl border-2 border-[#172033] bg-[#FAF7F0] p-4 shadow-[3px_3px_0_#172033] hover:bg-white hover:shadow-[5px_5px_0_#d71920]">
            <span class="min-w-0"><span class="block text-xs font-black uppercase tracking-wider text-slate-500">{item.label}</span><span class="mt-1 block break-words text-sm font-bold text-[#172033]">{item.display}</span></span>
            <span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl border-2 border-[#172033] bg-white font-bold shadow-[1px_1px_0_#172033]">↗</span>
          </a>)}
        </div>
      </section>
    </div>
  )}
</CommunityPageFrame>
