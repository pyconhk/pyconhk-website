---
import { getConferenceContent } from '@/lib/conference-content';
import { getSprintContent } from '@/lib/sprint-content-source';
import ContentPageFrame from '@/years/2026/components/content/ContentPageFrame.astro';
import PatronContent from '@/years/2026/components/content/PatronContent.astro';
import SponsorWall from '@/years/2026/components/content/SponsorWall.astro';
import SprintContent from '@/years/2026/components/content/SprintContent.astro';
import VenueDirections from '@/years/2026/components/content/VenueDirections.astro';
import VenueFloorPlans from '@/years/2026/components/content/VenueFloorPlans.astro';
import { type ContentPageKind, contentUi } from '@/years/2026/data/content-ui';
import { floorPlanCopy } from '@/years/2026/data/floor-plans';
import { diningDestinations, visitorGuide } from '@/years/2026/data/visitor-guide';
import type { CfpLocale } from '@/years/2026/locales';

interface Props { locale: CfpLocale; kind: ContentPageKind; }
const { locale, kind } = Astro.props;
const content = getConferenceContent(locale);
const copy = contentUi[locale];
const sectionKey = kind === 'organizers' || kind === 'supporters' ? 'organizations' : kind;
const section = content[sectionKey];
const organizations = content.organizations.items.filter((item) => item.kind === (kind === 'organizers' ? 'organizer' : 'supporter'));
const published = section.status === 'published' && ((kind !== 'organizers' && kind !== 'supporters') || organizations.length > 0);
---

<ContentPageFrame locale={locale} title={copy.titles[kind]} open={kind === 'sponsors' || kind === 'patrons'}>
  {!published ? <p data-content-pending>{copy.comingSoon}</p> : (
    <div data-conference-content={kind} class="space-y-6">
      {kind === 'about' && content.about.paragraphs.map((paragraph) => <p class="whitespace-pre-line">{paragraph}</p>)}
      {kind === 'venue' && (
        <>
          {content.venue.title && <h2 class="text-2xl font-bold text-conference-blue">{content.venue.title}</h2>}
          {content.venue.address && <p class="font-bold">{content.venue.address}</p>}
          {content.venue.description && <p class="whitespace-pre-line">{content.venue.description}</p>}
          {content.venue.mapImage && <img src={content.venue.mapImage} alt={content.venue.title || copy.titles.venue} width="1200" height="800" class="h-auto w-full rounded-2xl" />}
          <div class="flex flex-wrap gap-x-6 gap-y-2">
            {content.venue.mapUrl && <a href={content.venue.mapUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center font-bold text-conference-blue underline underline-offset-4">{copy.viewMap}</a>}
            <a href="#floor-plans" class="inline-flex min-h-11 items-center font-bold text-conference-blue underline underline-offset-4">{floorPlanCopy[locale].jumpLink}</a>
          </div>
          {content.venue.directions && <VenueDirections locale={locale} directions={content.venue.directions} />}
          <VenueFloorPlans locale={locale} />
          {content.venue.wifi && <section><h2 class="mb-3 text-xl font-bold">{copy.wifi}</h2><p class="whitespace-pre-line">{content.venue.wifi}</p></section>}
        </>
      )}
      {kind === 'catering' && <>
        <p class="whitespace-pre-line">{content.catering.intro}</p>
        <section class="space-y-4" aria-labelledby="nearby-dining-heading">
          <h2 id="nearby-dining-heading" class="text-xl font-bold text-conference-ink">{visitorGuide[locale].diningTitle}</h2>
          <ul class="grid gap-4 sm:grid-cols-2">
            {diningDestinations.map((place) => <li><a data-dining-place={place.id} href={place.url} target="_blank" rel="noopener noreferrer" class="flex h-full min-h-16 items-center justify-between gap-4 rounded-xl border-2 border-conference-outline bg-conference-paper p-5 font-bold text-conference-blue underline underline-offset-4 hover:bg-conference-surface focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-conference-blue"><span>{visitorGuide[locale].diningLinks[place.id]}</span><span aria-hidden="true">↗</span></a></li>)}
          </ul>
        </section>
        {content.catering.items.length > 0 && <ul class="list-disc space-y-3 pl-6">{content.catering.items.map((item) => <li class="whitespace-pre-line">{item}</li>)}</ul>}
      </>}
      {(kind === 'sprint' || kind === 'qa') && <SprintContent locale={locale} content={getSprintContent(locale)} mode={kind} />}
      {kind === 'sponsors' && (
        <SponsorWall items={content.sponsors.items} locale={locale} headingLevel="h2" />
      )}
      {kind === 'patrons' && <PatronContent patrons={content.patrons} />}
      {(kind === 'organizers' || kind === 'supporters') && (
        <div class="grid gap-6 sm:grid-cols-2">
          {organizations.map((item) => <article class="space-y-4 rounded-2xl border-2 border-conference-outline p-6">{item.logo && <img src={item.logo} alt={item.name} width="320" height="180" class="h-36 w-full rounded-lg bg-white object-contain p-4" loading="lazy" />}<h2 class="text-xl font-bold">{item.name}</h2><p class="whitespace-pre-line">{item.description}</p>{item.url && <a href={item.url} target="_blank" rel="noopener noreferrer" class="font-bold text-conference-blue underline">{copy.visitWebsite}</a>}</article>)}
        </div>
      )}
      {kind === 'people' && (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {content.people.items.map((item) => <article class="space-y-4 rounded-2xl border-2 border-conference-outline p-6">{item.image && <img src={item.image} alt={item.name} width="320" height="320" class="mx-auto h-40 w-40 rounded-full object-cover" loading="lazy" />}<h2 class="text-xl font-bold">{item.name}</h2><p>{item.role}</p>{item.url && <a href={item.url} target="_blank" rel="noopener noreferrer" class="font-bold text-conference-blue underline">{copy.visitWebsite}</a>}</article>)}
        </div>
      )}
    </div>
  )}
</ContentPageFrame>
