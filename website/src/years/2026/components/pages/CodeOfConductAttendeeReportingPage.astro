---
import ConferenceLayout from '@/years/2026/layouts/ConferenceLayout.astro';
import type { CfpLocale } from '@/years/2026/locales';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const cocHref = `/2026/${locale}/code-of-conduct/`;
const staffProceduresHref = `/2026/${locale}/code-of-conduct/staff-procedures/`;

const pageTitle =
  locale === 'zh-hk' || locale === 'zh-hant'
    ? '事件舉報程序 | PyCon HK 2026'
    : locale === 'zh-hans'
      ? '事件举报程序 | PyCon HK 2026'
      : locale === 'ja'
        ? '事案報告手順 | PyCon HK 2026'
        : 'Procedures for Reporting Incidents | PyCon HK 2026';

const pageDescription =
  locale === 'zh-hk' || locale === 'zh-hant'
    ? 'PyCon HK 2026 事件舉報程序與保密原則。'
    : 'Procedures and guidelines for reporting Code of Conduct incidents at PyCon HK 2026.';
---

<ConferenceLayout title={pageTitle} description={pageDescription} locale={locale}>
  <section class="py-12 sm:py-16 lg:py-20 bg-[#FAF7F0]">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mb-6">
        <a href={cocHref} class="inline-flex items-center gap-1 text-xs font-bold text-[#2f559a] hover:text-[#d71920]">
          ← {locale === 'zh-hk' || locale === 'zh-hant' ? '返回行為準則總覽' : 'Back to Code of Conduct Overview'}
        </a>
      </div>

      <div class="rounded-3xl border-3 border-[#172033] bg-white p-6 sm:p-10 lg:p-12 shadow-[8px_8px_0_#172033]">
        <h1 class="ideal-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#141718] text-center tracking-[-0.03em] leading-normal mb-8">
          {locale === 'zh-hk' || locale === 'zh-hant' ? '事件舉報程序' : locale === 'zh-hans' ? '事件举报程序' : 'Procedures for Reporting Incidents'}
        </h1>

        <div class="space-y-6 text-slate-700 leading-relaxed font-medium">
          <p>
            {locale === 'zh-hk' || locale === 'zh-hant'
              ? '如果你相信有人正處於人身危險之中，最重要的是先讓對方獲得協助。請立即聯絡現場工作人員或適當的緊急熱線。'
              : 'If you believe someone is in physical danger, please contact event staff or emergency services immediately.'}
          </p>

          <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">
            {locale === 'zh-hk' || locale === 'zh-hant' ? '一般舉報方式' : 'How to Report'}
          </h2>
          <p>
            {locale === 'zh-hk' || locale === 'zh-hant'
              ? '聯絡 PyCon HK 行為準則活動工作人員的最佳方式，是電郵至：'
              : 'The best way to reach the PyCon HK response team is via email:'}
            <a href="mailto:pycon@pycon.hk" class="font-bold text-[#d71920] underline ml-1">pycon@pycon.hk</a>
          </p>

          <h2 class="text-xl sm:text-2xl font-black text-[#2f559a] pt-4">
            {locale === 'zh-hk' || locale === 'zh-hant' ? '保密原則' : 'Confidentiality'}
          </h2>
          <p>
            {locale === 'zh-hk' || locale === 'zh-hant'
              ? '所有報告都會保密處理。當我們與被舉報者討論事件時，會盡可能將細節匿名化，以保護舉報人的私隱與安全。'
              : 'All reports will be treated confidentially. Information will be anonymized to protect the reporter.'}
          </p>

          <div class="pt-6 border-t border-slate-200 flex flex-wrap gap-4">
            <a href={cocHref} class="font-bold text-[#2f559a] underline">
              {locale === 'zh-hk' || locale === 'zh-hant' ? '行為準則總覽' : 'Code of Conduct Overview'}
            </a>
            <a href={staffProceduresHref} class="font-bold text-[#d71920] underline">
              {locale === 'zh-hk' || locale === 'zh-hant' ? '執行程序' : 'Enforcement Procedures'}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</ConferenceLayout>
