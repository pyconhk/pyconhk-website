---
import ConferenceLayout from '@/years/2026/layouts/ConferenceLayout.astro';
import type { CfpLocale } from '@/years/2026/locales';

interface Props {
  locale: CfpLocale;
}

const { locale } = Astro.props;
const cocHref = `/2026/${locale}/code-of-conduct/`;
const staffProceduresHref = `/2026/${locale}/code-of-conduct/staff-procedures/`;

const pageTitle = 'Procedures for Reporting Incidents | PyCon HK 2026';
const pageDescription = 'Procedures and guidelines for reporting Code of Conduct incidents at PyCon HK 2026.';
---

<ConferenceLayout title={pageTitle} description={pageDescription} locale={locale}>
  <section lang="en" data-policy-body class="py-12 sm:py-16 lg:py-20 bg-conference-paper">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mb-6">
        <a href={cocHref} class="inline-flex items-center gap-1 text-xs font-bold text-conference-blue hover:text-conference-red">
          ← Back to Code of Conduct Overview
        </a>
      </div>

      <div class="rounded-3xl border-3 border-conference-outline bg-conference-surface p-6 sm:p-10 lg:p-12 shadow-[8px_8px_0_var(--conference-shadow)]">
        <h1 class="font-operetta-32 text-3xl sm:text-4xl md:text-5xl text-conference-ink font-black uppercase text-center tracking-tight mb-8">
          Procedures for Reporting Incidents
        </h1>

        <div class="space-y-6 text-conference-body leading-relaxed font-medium">
          <p>
            If you believe someone is in physical danger, please contact event staff or emergency services immediately.
          </p>

          <h2 class="text-xl sm:text-2xl font-black text-conference-blue pt-4">
            How to Report
          </h2>
          <p>
            The best way to reach the PyCon HK response team is via email:
            <a href="mailto:pycon@pycon.hk" class="font-bold text-conference-red underline ml-1">pycon@pycon.hk</a>
          </p>

          <h2 class="text-xl sm:text-2xl font-black text-conference-blue pt-4">
            Confidentiality
          </h2>
          <p>
            All reports will be treated confidentially. Information will be anonymized to protect the reporter.
          </p>

          <div class="pt-6 border-t border-conference-line flex flex-wrap gap-4">
            <a href={cocHref} class="font-bold text-conference-blue underline">
              Code of Conduct Overview
            </a>
            <a href={staffProceduresHref} class="font-bold text-conference-red underline">
              Enforcement Procedures
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</ConferenceLayout>
