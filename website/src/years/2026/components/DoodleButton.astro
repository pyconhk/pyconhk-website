---
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary';
}

const { href, label, variant = 'primary' } = Astro.props;
const isPrimary = variant === 'primary';
const opensNewTab = /^https?:\/\//.test(href);
---

<a
  href={href}
  aria-label={label}
  target={opensNewTab ? '_blank' : undefined}
  rel={opensNewTab ? 'noreferrer' : undefined}
  class:list={[
    'inline-flex min-h-12 w-full items-center justify-center rounded-xl border-2 border-conference-outline px-5 py-3 font-mono text-sm font-black text-conference-ink shadow-conference-card transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-conference-blue sm:w-auto md:text-base',
    isPrimary ? '-rotate-1 bg-conference-yellow' : 'rotate-1 bg-conference-surface [border-style:dashed]',
  ]}
>
  <slot />
</a>
