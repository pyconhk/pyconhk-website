---
import {
  legacy2015Brand,
  legacy2015NavGroups,
  legacy2015TicketHref,
} from '@/years/2015/data/navigation';

const legacyBootstrapDropdownHref = '#';
---

<nav class="legacy-2015-navbar navbar navbar-inverse navbar-fixed-top" aria-label="PyCon HK 2015 navigation">
  <div class="container">
    <input id="legacy-2015-nav-toggle" class="legacy-2015-nav-checkbox" type="checkbox" />
    <div class="navbar-header">
      <label
        class="navbar-toggle collapsed"
        for="legacy-2015-nav-toggle"
        data-toggle="collapse"
        data-target="#navbar"
        aria-controls="navbar"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </label>
      <a class="navbar-brand" href={legacy2015Brand.href}>{legacy2015Brand.label}</a>
    </div>
    <div id="navbar" class="navbar-collapse collapse">
      <ul class="nav navbar-nav">
        {
          legacy2015NavGroups.map((group) => (
            <li class="dropdown">
              <a href={legacyBootstrapDropdownHref} class="dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                {group.label} <span class="caret" />
              </a>
              <ul class="dropdown-menu">
                {group.items.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
      <ul class="nav navbar-nav navbar-right">
        <li class="nav-highlight">
          <a href={legacy2015TicketHref}>Get Ticket</a>
        </li>
      </ul>
    </div>
  </div>
</nav>
