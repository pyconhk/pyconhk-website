---
import { decodeCloudflareProtectedEmails } from '@/legacy/cloudflare-email';
import { repairLegacyWordPressHistoryLinks } from '@/legacy/conference-archive-links';
import { prepareLegacySearchableHtml } from '@/legacy/legacy-html';
import { resolveLegacy2020HtmlAssets } from '@/years/2020/data/assets';
import type { Legacy2021Page } from '@/years/2021/data/types';

interface Props {
  page: Legacy2021Page;
}

const { page } = Astro.props;

const legacy2021LayoutFixes = `<style id="legacy-2021-layout-fixes">
body.wp-theme-marketingly .entry-content a {
  overflow-wrap: anywhere;
  word-break: break-word;
}
</style>`;

function injectLegacy2021LayoutFixes(html: string): string {
  return html.replace('</head>', `${legacy2021LayoutFixes}</head>`);
}

const html = injectLegacy2021LayoutFixes(
  prepareLegacySearchableHtml(
    resolveLegacy2020HtmlAssets(
      decodeCloudflareProtectedEmails(repairLegacyWordPressHistoryLinks(page.fullHtml)),
      '2021'
    ),
    {
      route: page.route,
      title: page.title,
    }
  )
);
---

<Fragment set:html={html} />
