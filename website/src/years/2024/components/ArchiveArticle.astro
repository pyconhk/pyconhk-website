---
import type { Legacy2024Page } from '@/years/2024/data/pages';
import ArchiveLayout from './ArchiveLayout.astro';

interface Props {
  page: Legacy2024Page;
}

const { page } = Astro.props;
---

<ArchiveLayout title={`${page.title} | PyCon HK 2024`} description={page.description}>
  <article class="container mx-auto px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl rounded-lg bg-white px-5 py-8 shadow-sm ring-1 ring-slate-200 sm:px-8 md:py-10 lg:px-12">
      <a href="/2024/" class="text-sm font-semibold text-brand-blue-dark hover:text-brand-blue">
        Back to 2024 archive
      </a>
      <header class="mt-6 border-b border-slate-200 pb-6">
        <h1 class="font-display text-3xl font-bold leading-tight text-brand-black md:text-5xl">
          {page.title}
        </h1>
        {
          page.dateTime && page.dateLabel && (
            <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-muted">
              <time datetime={page.dateTime}>{page.dateLabel}</time>
            </p>
          )
        }
      </header>
      <div class="archive-content prose prose-slate mt-8 max-w-none" set:html={page.content} />
    </div>
  </article>
</ArchiveLayout>

<style>
  .archive-content :global(img) {
    height: auto;
    max-width: 100%;
    border-radius: 0.375rem;
  }

  .archive-content :global(a) {
    overflow-wrap: anywhere;
  }

  .archive-content :global(.wp-block-image.aligncenter),
  .archive-content :global(.has-text-align-center) {
    text-align: center;
  }

  .archive-content :global(.wp-block-image.aligncenter img) {
    margin-inline: auto;
  }

  .archive-content :global(.wp-block-columns) {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .archive-content :global(.wp-block-columns) {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
  }

  .archive-content :global(.wp-block-column) {
    min-width: 0;
  }

  .archive-content :global(.wp-block-buttons) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .archive-content :global(.wp-block-button__link) {
    display: inline-flex;
    border-radius: 0.375rem;
    background: var(--color-brand-blue);
    padding: 0.75rem 1rem;
    color: white;
    font-weight: 700;
    text-decoration: none;
  }

  .archive-content :global(.wp-block-separator) {
    margin-block: 2rem;
    border: 0;
    border-top: 1px solid rgb(203 213 225);
  }

  .archive-content :global(.scroll-container) {
    overflow-x: auto;
  }

  .archive-content :global(pretalx-schedule) {
    display: block;
    min-height: 42rem;
    min-width: 48rem;
  }
</style>
