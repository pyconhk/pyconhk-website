}

.wp-site-blocks > .wp-block-cover:first-child header .wp-block-navigation .has-child:hover > .wp-block-navigation__submenu-container,
.wp-site-blocks > .wp-block-cover:first-child header .wp-block-navigation .has-child:focus-within > .wp-block-navigation__submenu-container,
.wp-site-blocks > .wp-block-cover:first-child header .wp-block-navigation .has-child .wp-block-navigation-submenu__toggle[aria-expanded="true"] ~ .wp-block-navigation__submenu-container {
  height: auto !important;
  min-width: max-content !important;
  opacity: 1 !important;
  overflow: visible !important;
  visibility: visible !important;
