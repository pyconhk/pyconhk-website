    z-index: 100000;
  }

  .wp-site-blocks > .wp-block-cover:first-child header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__responsive-close,
  .wp-site-blocks > .wp-block-cover:first-child header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__responsive-dialog,
  .wp-site-blocks > .wp-block-cover:first-child header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__responsive-container-content {
    width: 100%;
