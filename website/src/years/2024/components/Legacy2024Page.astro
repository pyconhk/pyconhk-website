}

.wp-site-blocks > .wp-block-cover:first-child header .wp-block-navigation .wp-block-navigation__submenu-container .wp-block-navigation-item__content {
  color: #102421 !important;
  line-height: 1.25;
  padding: 12px 18px !important;
  text-shadow: none !important;
  white-space: nowrap;
}

.wp-site-blocks > .wp-block-cover:first-child header .wp-block-navigation .wp-block-navigation__submenu-container .wp-block-navigation-item__content:hover,
.wp-site-blocks > .wp-block-cover:first-child header .wp-block-navigation .wp-block-navigation__submenu-container .wp-block-navigation-item__content:focus-visible {
  background: #f2f8f3;
  color: #0b5d54 !important;
}

@media (max-width: 781px) {
