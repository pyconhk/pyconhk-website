---
import {
  decodeCloudflareProtectedEmails,
  stripLegacyScripts,
} from '@/legacy/cloudflare-email';
import {
  conferenceArchiveHistoryLinks,
  repairLegacyWordPressHistoryLinks,
} from '@/legacy/conference-archive-links';
import { prepareLegacySearchableHtml } from '@/legacy/legacy-html';

interface Props {
  page: {
    fullHtml: string;
    title?: string;
    url?: string;
  };
  search?: boolean;
}

const { page, search = false } = Astro.props;
const legacy2024NavFixCss = `<style id="pyconhk-legacy-2024-nav-fix">
@media (min-width: 782px) {
  .wp-site-blocks > .wp-block-cover:first-child header .wp-container-core-group-is-layout-9366075c {
    column-gap: clamp(48px, 5vw, 88px) !important;
  }

  .wp-site-blocks > .wp-block-cover:first-child header .wp-container-core-group-is-layout-fbcf6490 {
    align-items: center !important;
    column-gap: 14px !important;
    min-width: max-content;
  }

  .wp-site-blocks > .wp-block-cover:first-child header .wp-container-core-group-is-layout-bc8e6f51 {
    margin-left: clamp(36px, 4vw, 72px) !important;
  }

  .wp-site-blocks > .wp-block-cover:first-child header .wp-block-site-title {
    margin: 0 !important;
    white-space: nowrap;
  }

  .wp-site-blocks > .wp-block-cover:first-child header .wp-block-navigation__container {
    column-gap: clamp(16px, 1.35vw, 24px) !important;
  }
}

@media (max-width: 781px) {
  .wp-site-blocks > .wp-block-cover:first-child > .wp-block-cover__inner-container > .wp-block-group {
    box-sizing: border-box !important;
