---
import {
  decodeCloudflareProtectedEmails,
  stripLegacyScripts,
} from '@/legacy/cloudflare-email';
import {
  conferenceArchiveHistoryLinks,
  repairLegacyWordPressHistoryLinks,
} from '@/legacy/conference-archive-links';
import { prepareLegacySearchableHtml } from '@/legacy/legacy-html';

interface Props {
  page: {
    fullHtml: string;
    title?: string;
    url?: string;
  };
}

const { page } = Astro.props;
