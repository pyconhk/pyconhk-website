</style>`;

const legacy2024NavFixScript = `<script id="pyconhk-legacy-2024-nav-script">
(() => {
  const navigationSelector = '.wp-site-blocks header .wp-block-navigation';
  const ready = (callback) => {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', callback, { once: true });
      return;
    }

    callback();
  };

  ready(() => {
    document.querySelectorAll(navigationSelector).forEach((navigation) => {
      const openButton = navigation.querySelector('.wp-block-navigation__responsive-container-open');
      const closeButton = navigation.querySelector('.wp-block-navigation__responsive-container-close');
      const container = navigation.querySelector('.wp-block-navigation__responsive-container');

      if (!openButton || !closeButton || !container) {
        return;
      }

      const openMenu = () => {
        container.classList.add('is-menu-open', 'has-modal-open');
        container.removeAttribute('aria-hidden');
        container.setAttribute('aria-modal', 'true');
        container.setAttribute('role', 'dialog');
        openButton.setAttribute('aria-expanded', 'true');
        document.documentElement.classList.add('has-modal-open');
        document.body.classList.add('has-modal-open');

        const firstFocusable = container.querySelector('a[href], button:not(.wp-block-navigation__responsive-container-close)');
        if (firstFocusable) {
          firstFocusable.focus();
        }
      };

      const closeMenu = () => {
        container.classList.remove('is-menu-open', 'has-modal-open');
        container.setAttribute('aria-hidden', 'true');
        container.removeAttribute('aria-modal');
        container.removeAttribute('role');
        openButton.setAttribute('aria-expanded', 'false');
        document.documentElement.classList.remove('has-modal-open');
        document.body.classList.remove('has-modal-open');
        openButton.focus();
      };

      openButton.setAttribute('aria-expanded', 'false');
      openButton.addEventListener('click', (event) => {
        event.preventDefault();
        openMenu();
      });
      closeButton.addEventListener('click', (event) => {
        event.preventDefault();
        closeMenu();
      });
      container.addEventListener('click', (event) => {
        const target = event.target;

        if (target instanceof Element && target.closest('a[href]')) {
          closeMenu();
        }
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && container.classList.contains('is-menu-open')) {
          closeMenu();
        }
      });
    });
  });
})();
${'</scr' + 'ipt>'}`;

const legacy2024ScheduleScript = `<script id="pyconhk-legacy-2024-schedule-script" src="https://pretalx.com/democon/schedule/widget/v2.en.js"></${'scr' + 'ipt'}>`;

const legacy2024SearchHead = `<link rel="stylesheet" href="/pagefind/pagefind-ui.css">
<style id="pyconhk-legacy-2024-search-style">
.pyconhk-legacy-search {
  min-height: 36rem;
  padding-top: 12px;
}

.pyconhk-legacy-search h1 {
  font-size: 40px;
  margin: 0 0 28px;
}

#legacy-search {
  --pagefind-ui-primary: #000;
  --pagefind-ui-text: #000;
  --pagefind-ui-background: #fff;
  --pagefind-ui-border: #d8d8d8;
  --pagefind-ui-tag: #f5f5f5;
  --pagefind-ui-border-width: 1px;
  --pagefind-ui-border-radius: 0;
  --pagefind-ui-font: Montserrat, sans-serif;
  width: 100%;
}

#legacy-search .pagefind-ui__search-input {
  border-radius: 0;
  box-shadow: none;
}

#legacy-search .pagefind-ui__result-title {
  font-size: 21px;
  line-height: 1.35;
}

#legacy-search .pagefind-ui__result-link {
  color: #000;
}

#legacy-search .pagefind-ui__result-excerpt mark {
  background: #fff27a;
}

@media (max-width: 781px) {
  .pyconhk-legacy-search h1 {
    font-size: 32px;
  }
}
</style>`;

const legacy2024SearchScript = `<script src="/pagefind/pagefind-ui.js"></${'scr' + 'ipt'}>
<script id="pyconhk-legacy-2024-search-script">
(() => {
  const ready = (callback) => {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', callback, { once: true });
      return;
    }

    callback();
  };

  ready(() => {
    const searchRoot = document.querySelector('#legacy-search');

    if (!(searchRoot instanceof HTMLElement) || typeof PagefindUI !== 'function') {
      return;
    }

    const searchParams = new URLSearchParams(window.location.search);
    const initialTerm = searchParams.get('s') || searchParams.get('q') || '';
    const sidebarInput = document.querySelector('#wp-block-search__input-2');

    if (sidebarInput instanceof HTMLInputElement) {
      sidebarInput.value = initialTerm;
    }

    new PagefindUI({
      element: '#legacy-search',
      showImages: false,
      showSubResults: true,
      pageSize: 10,
      resetStyles: false,
      openFilters: ['year'],
      translations: {
        placeholder: 'Search PyCon HK archives',
        zero_results: 'No PyCon HK archive results for [SEARCH_TERM]',
      },
    });

    if (!initialTerm) {
      return;
    }

    const applyInitialTerm = (attemptsLeft = 20) => {
      const input = document.querySelector('#legacy-search .pagefind-ui__search-input');

      if (!(input instanceof HTMLInputElement)) {
        if (attemptsLeft > 0) {
          window.setTimeout(() => applyInitialTerm(attemptsLeft - 1), 50);
        }
        return;
      }

      input.value = initialTerm;
      input.dispatchEvent(new Event('input', { bubbles: true }));
    };

    applyInitialTerm();
  });
})();
${'</scr' + 'ipt>'}`;

const repairedHtml = repairLegacy2024Html(
  repairVoyagoHistoryLinks(
    stripLegacyScripts(
      decodeCloudflareProtectedEmails(
        repairLegacyWordPressHistoryLinks(
          search ? createLegacy2024SearchDocument(page.fullHtml) : page.fullHtml
        )
      )
    )
  )
);
const html = search
  ? repairedHtml.replace(/<body\b/iu, '<body data-pagefind-ignore="all"')
  : prepareLegacySearchableHtml(repairedHtml, {
      route: page.url ?? '/2024/',
      title: page.title,
    });

function repairLegacy2024Html(source: string): string {
  const repaired = source
    .replace(
      /<link\b(?=[^>]*\brel=["']alternate["'])(?=[^>]*\btype=["']application\/rss\+xml["'])[^>]*>\s*/giu,
      ''
    )
    .replace(/<link\b(?=[^>]*\brel=["']next["'])[^>]*>\s*/giu, '')
    .replace(
      /\bsrcset=(["'])([^"']+)\1/giu,
      (_match, quote: string, srcset: string) =>
        `srcset=${quote}${rewriteSrcset(srcset)}${quote}`
    )
    .replace(
      /\b(content|href|src|poster|action|value)=(["'])([^"']*)\2/giu,
      (match, attribute: string, quote: string, value: string) => {
        const rewritten = rewriteUrlValue(value);

        return rewritten === value
          ? match
          : `${attribute.toLowerCase()}=${quote}${rewritten}${quote}`;
      }
    )
    .replace(
      /url\((["']?)([^"')]+)\1\)/giu,
      (match, quote: string, value: string) => {
        const rewritten = rewriteUrlValue(value);

        return rewritten === value ? match : `url(${quote}${rewritten}${quote})`;
      }
    );

  return injectLegacy2024NavFixes(
    repairVoyagoNewsLinks(repairVoyagoArchiveControls(repaired))
  );
}

function repairVoyagoNewsLinks(source: string): string {
  return source.replace(
    /(<a\b[^>]*\bhref=)(["'])\/2024\/?\2([^>]*>\s*<span\b[^>]*>\s*News\s*<\/span>\s*<\/a>)/giu,
    '$1$2/2024/news/$2$3'
  );
}

function repairVoyagoArchiveControls(source: string): string {
  return source.replace(
    /(<form\b(?=[^>]*\brole=["']search["'])[^>]*\baction=)(["'])[^"']*\2/giu,
    '$1$2/2024/search/$2'
  );
}

function injectLegacy2024NavFixes(source: string): string {
  let html = source;

  if (!html.includes('id="pyconhk-legacy-2024-nav-fix"')) {
    html = html.replace(/<\/head>/iu, `${legacy2024NavFixCss}\n</head>`);
  }

  if (!html.includes('id="pyconhk-legacy-2024-nav-script"')) {
    html = html.replace(/<\/body>/iu, `${legacy2024NavFixScript}\n</body>`);
  }

  if (search && !html.includes('id="pyconhk-legacy-2024-search-style"')) {
    html = html.replace(/<\/head>/iu, `${legacy2024SearchHead}\n</head>`);
  }

  if (search && !html.includes('id="pyconhk-legacy-2024-search-script"')) {
    html = html.replace(/<\/body>/iu, `${legacy2024SearchScript}\n</body>`);
  }

  if (
    page.url === '/2024/schedule/' &&
    !html.includes('id="pyconhk-legacy-2024-schedule-script"')
  ) {
    html = html.replace(/<\/body>/iu, `${legacy2024ScheduleScript}\n</body>`);
  }

  return html;
}

function createLegacy2024SearchDocument(source: string): string {
  const columnStart = source.indexOf(
    '<div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow" style="padding-right:var(--wp--preset--spacing--60)">'
  );
  const contentStart = source.indexOf('>', columnStart) + 1;
  const sidebarStart = source.indexOf(
    '<div class="wp-block-column has-white-color has-custom-background-secondary-background-color',
    contentStart
  );
  const contentEnd = source.lastIndexOf('</div>', sidebarStart);

  if (columnStart < 0 || contentStart <= columnStart || sidebarStart < 0 || contentEnd < contentStart) {
    throw new Error('Could not locate the 2024 archive content column for search.');
  }

  const searchMarkup = `<section class="pyconhk-legacy-search" data-pagefind-ignore="all">
<h1>Search</h1>
<div id="legacy-search"></div>
</section>`;

  return `${source.slice(0, contentStart)}${searchMarkup}${source.slice(contentEnd)}`
    .replace(/<title>[\s\S]*?<\/title>/iu, '<title>Search - PyCon HK 2024</title>')
    .replace(
      /<meta\b(?=[^>]*\bname=["']robots["'])[^>]*>/iu,
      '<meta name="robots" content="noindex">'
    );
}

function repairVoyagoHistoryLinks(source: string): string {
  return source.replace(
    /(<h6\b[^>]*>\s*History\s*<\/h6>\s*)<p>[\s\S]*?<\/p>/u,
    (_match, prefix: string) => `${prefix}${historyParagraphHtml()}`
  );
}

function historyParagraphHtml(): string {
  return `<p>${conferenceArchiveHistoryLinks
    .map(({ href, label }, index) => {
      const breakBefore = index === 5 ? '<br />' : '';
      const separator = index === conferenceArchiveHistoryLinks.length - 1 ? '' : '&nbsp;&nbsp;';

      return `${breakBefore}<a href="${escapeHtml(href)}">${escapeHtml(label)}</a>${separator}`;
    })
    .join('')}</p>`;
}

function rewriteSrcset(srcset: string): string {
  return srcset
    .split(',')
    .map((candidate) => {
      const trimmed = candidate.trim();
      const [url, ...descriptors] = trimmed.split(/\s+/u);

      return [rewriteUrlValue(url), ...descriptors].join(' ');
    })
    .join(', ');
}

function rewriteUrlValue(value: string): string {
  if (!value || skippableUrl(value)) {
    return value;
  }

  let url: URL;

  try {
    url = new URL(value, 'https://pycon.hk');
  } catch {
    return value;
  }

  if (!['legacy.pycon.hk', 'pycon.hk', 'www.pycon.hk'].includes(url.hostname)) {
    return value;
  }

  const suffix = `${url.search}${url.hash}`;
  const pathname = url.pathname;

  if (pathname.startsWith('/legacy-wp/uploads/')) {
    return `/2024/assets/uploads/${pathname.slice('/legacy-wp/uploads/'.length)}${suffix}`;
  }

  if (pathname.startsWith('/wp-content/uploads/')) {
    return `/2024/assets/uploads/${pathname.slice('/wp-content/uploads/'.length)}${suffix}`;
  }

  if (pathname.startsWith('/wp-content/')) {
    return `/2024/assets/content/${pathname.slice('/wp-content/'.length)}${suffix}`;
  }

  if (pathname.startsWith('/wp-includes/')) {
    return `/2024/assets/includes/${pathname.slice('/wp-includes/'.length)}${suffix}`;
  }

  if (pathname === '/feed/' || pathname === '/comments/feed/') {
    return `/2024/${url.hash}`;
  }

  const alias = local2024Alias(pathname);
  if (alias) {
    return `${alias}${suffix}`;
  }

  if (pathname === '/' || pathname === '') {
    return `/2024/${url.hash}`;
  }

  if (localArchivePath(pathname)) {
    return `${normalizeLocalPath(pathname)}${suffix}`;
  }

  return value;
}

function skippableUrl(value: string): boolean {
  return /^(?:#|data:|mailto:|tel:|javascript:)/iu.test(value);
}

function local2024Alias(pathname: string): string | undefined {
  const normalized = pathname.endsWith('/') ? pathname : `${pathname}/`;
  const unprefixed = normalized.startsWith('/2024/')
    ? normalized.slice('/2024'.length)
    : normalized;
  const aliases: Record<string, string> = {
    '/access-guide-conference-day/': '/2024/2024-access-guide-conference-day/',
    '/access-guide-development-sprint-day/': '/2024/2024-access-guide-development-sprint-day/',
    '/about/': '/2024/2024-about/',
    '/booths/': '/2024/2024-booths/',
    '/category/2024/': '/2024/news/',
    '/category/2024/page/1/': '/2024/news/',
    '/code-of-conduct/': '/2024/2024-code-of-conduct/',
    '/code-of-conduct/attendee-reporting/': '/2024/2024-attendee-reporting/',
    '/code-of-conduct/staff-procedure/': '/2024/2024-staff-procedure/',
    '/communities/': '/2024/2024-supporting-organizations/',
    '/conference-highlights/pycon-hk-2024-photos/': '/2024/photos/',
    '/news/': '/2024/news/',
    '/organizers/': '/2024/2024-organizers/',
    '/post-2563/': '/2024/2024-agenda/',
    '/post-2582/': '/2024/2024-organizers/',
    '/post-2683/': '/2024/2024-supporting-organizations/',
    '/post-3232/': '/2024/2024-sprint/',
    '/post-3597/': '/2024/2024-patrons/',
    '/post-3601/': '/2024/2024-access-guide-conference-day/',
    '/post-3620/': '/2024/2024-access-guide-development-sprint-day/',
    '/schedule/': '/2024/schedule/',
    '/sponsors/': '/2024/2024-sponsors/',
    '/sprint/': '/2024/2024-sprint/',
    '/volunteers/': '/2024/2024-volunteers/',
  };

  return aliases[normalized] ?? aliases[unprefixed];
}

function localArchivePath(pathname: string): boolean {
  return /^\/(?:2015|2016|2017|2018|2020|2020-spring|2020-fall|2021|2022|2023|2024|2025|2026)(?:\/|$)/u.test(
    pathname
  );
}

function normalizeLocalPath(pathname: string): string {
  if (pathname.endsWith('/') || /\/[^/]+\.[^/]+$/u.test(pathname)) {
    return pathname;
  }

  return `${pathname}/`;
}

function escapeHtml(value: string): string {
  return value.replace(/[&<>"']/gu, (character) => {
    switch (character) {
      case '&':
        return '&amp;';
      case '<':
        return '&lt;';
      case '>':
        return '&gt;';
      case '"':
        return '&quot;';
      case "'":
        return '&#39;';
      default:
        return character;
    }
  });
}
---

<Fragment set:html={html} />
