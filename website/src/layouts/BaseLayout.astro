---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import YearFonts from '@/components/YearFonts.astro';
import {
  currentConferenceYear,
  defaultOpenGraphDescription,
  defaultOpenGraphTitle,
  defaultSeoDescription,
  defaultSeoTitle,
  type SiteYear,
  siteName,
  socialHandle,
} from '@/config/site';
import { buildSeoMetadata, toOpenGraphLocale } from '@/lib/seo';
import ImageLoading from './ImageLoading.astro';

interface Props {
  year?: SiteYear;
  title?: string;
  description?: string;
  htmlLang?: string;
  imagePath?: string;
  iconPath?: string;
  robots?: string;
  availableLocales?: readonly string[];
}

const {
  year = currentConferenceYear,
  title = defaultSeoTitle,
  description = defaultSeoDescription,
  htmlLang = 'en-HK',
  imagePath,
  iconPath = '/favicon.ico',
  robots,
  availableLocales,
} = Astro.props;
const seo = buildSeoMetadata({
  pathname: Astro.url.pathname,
  imagePath,
  availableLocales,
});
const openGraphTitle = title || defaultOpenGraphTitle;
const openGraphDescription = description || defaultOpenGraphDescription;
const googleAnalyticsId = process.env.PUBLIC_GA_ID || process.env.NEXT_PUBLIC_GA_ID;
const isTestEnvironment =
  process.env.PUBLIC_IS_TEST_ENV === 'true' ||
  process.env.NEXT_PUBLIC_IS_TEST_ENV === 'true';
const shouldLoadGoogleAnalytics = Boolean(googleAnalyticsId && !isTestEnvironment);
const shouldLoadCloudflareAnalytics =
  import.meta.env.PROD && !isTestEnvironment && Astro.url.pathname.startsWith('/2026/');
---

<!doctype html>
<html lang={htmlLang} data-site-year={year} transition:animate="none">
  <head>
    <ImageLoading />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <slot name="head" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <title>{title}</title>
    <link rel="canonical" href={seo.canonicalUrl} />
    {seo.alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={openGraphTitle} />
    <meta property="og:description" content={openGraphDescription} />
    <meta property="og:url" content={seo.canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={toOpenGraphLocale(htmlLang)} />
    {seo.alternates.filter((alternate) => alternate.hreflang !== 'x-default' && toOpenGraphLocale(alternate.hreflang) !== toOpenGraphLocale(htmlLang)).map((alternate) => (
      <meta property="og:locale:alternate" content={toOpenGraphLocale(alternate.hreflang)} />
    ))}
    <meta property="og:image" content={seo.imageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={openGraphTitle} />
    <meta name="twitter:description" content={openGraphDescription} />
    <meta name="twitter:creator" content={socialHandle} />
    <meta name="twitter:site" content={socialHandle} />
    <meta name="twitter:image" content={seo.imageUrl} />
    <link rel="icon" href={iconPath} />
    <ClientRouter fallback="swap" />
    <YearFonts year={year} />
    {
      shouldLoadGoogleAnalytics && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`} />
          <script is:inline define:vars={{ googleAnalyticsId }}>
            window.dataLayer = window.dataLayer || []
            function gtag(...args) {
              window.dataLayer.push(args)
            }
            gtag('js', new Date())
            gtag('config', googleAnalyticsId)
          </script>
        </>
      )
    }
  </head>
  <body class="min-h-screen overflow-x-clip bg-white font-sans text-slate-700 antialiased">
    <div class="min-h-screen overflow-x-clip">
      <slot />
    </div>
    {shouldLoadCloudflareAnalytics && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon='{"token":"d558306e55ce47d7910c7333fc4abf8c"}'
      />
    )}
  </body>
</html>
