---
import LegacyShell from '@/legacy/LegacyShell.astro';
import { cleanLegacyText } from '@/legacy/legacy-indexes';
import type { CanonicalLegacyHighlight } from '@/legacy/year-highlights';

type RelatedLink = {
  description: string;
  href: string;
  label: string;
};

interface Props {
  description: string;
  editionLabel: string;
  highlights: CanonicalLegacyHighlight[];
  relatedLinks?: RelatedLink[];
  title: string;
}

const { description, editionLabel, highlights, relatedLinks = [], title } = Astro.props;
const cleanDescription = cleanLegacyText(description);
const cleanHighlights = highlights.map((highlight) => ({
  ...highlight,
  page: {
    ...highlight.page,
    description: cleanLegacyText(highlight.page.description),
  },
}));
---

<LegacyShell title={title} description={cleanDescription} eyebrow={editionLabel}>
  <section class="mx-auto max-w-6xl px-5 py-10 lg:px-8 lg:py-14">
    <div class="max-w-3xl">
      <h2 class="text-sm font-bold uppercase tracking-wide text-teal-700">Year Archive</h2>
      <p class="mt-4 text-lg leading-8 text-slate-600">{cleanDescription}</p>
    </div>

    {cleanHighlights.length > 0 && (
      <div class="mt-10">
        <h2 class="text-2xl font-bold text-slate-950">Highlights</h2>
        <div class="mt-5 grid gap-5 md:grid-cols-2">
          {
            cleanHighlights.map((highlight) => (
              <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
                  {highlight.page.isoDate ? (
                    <time datetime={highlight.page.isoDate}>{highlight.page.date}</time>
                  ) : (
                    highlight.page.date
                  )}
                </p>
                <h3 class="mt-2 text-2xl font-bold leading-tight text-slate-950">
                  <a class="hover:text-teal-700" href={highlight.path}>
                    {highlight.page.title}
                  </a>
                </h3>
                <p class="mt-3 text-base leading-7 text-slate-600">
                  {highlight.page.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    )}

    {relatedLinks.length > 0 && (
      <div class="mt-10">
        <h2 class="text-2xl font-bold text-slate-950">Related Archives</h2>
        <div class="mt-5 grid gap-5 md:grid-cols-2">
          {
            relatedLinks.map((link) => (
              <a
                class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-teal-700 hover:shadow-md"
                href={link.href}
              >
                <h3 class="text-2xl font-bold leading-tight text-slate-950">{link.label}</h3>
                <p class="mt-3 text-base leading-7 text-slate-600">{link.description}</p>
              </a>
            ))
          }
        </div>
      </div>
    )}
  </section>
</LegacyShell>
