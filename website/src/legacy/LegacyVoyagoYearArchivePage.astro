---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { LegacyArchiveRecord } from '@/legacy/legacy-indexes';

interface Props {
  page: LegacyArchiveRecord;
  year: string;
}

const { page, year } = Astro.props;
const title = `${year} - PyCon HK`;
const description = page.description || `PyCon HK ${year} archive.`;
const navLinks = [
  { href: '/2024/', label: '2024' },
  { href: '/2024/schedule/', label: 'Schedule' },
  { href: '/2024/2024-sprint/', label: 'Sprint' },
  { href: '/2024/2024-sponsors/', label: 'Sponsors' },
  { href: '/2024/2024-patrons/', label: 'Patrons' },
  { href: '/2024/2024-supporting-organizations/', label: 'Communities' },
  { href: '/2024/2024-organizers/', label: 'Organizers' },
  { href: '/2024/2024-volunteers/', label: 'Volunteers' },
  { href: '/2024/', label: 'News' },
  { href: '/2024/2024-about/', label: 'About' },
  { href: '/2024/2024-code-of-conduct/', label: 'Code of Conduct' },
];
const archiveMonths = [
  ['2024/11', 'November 2024'],
  ['2024/10', 'October 2024'],
  ['2024/09', 'September 2024'],
  ['2024/07', 'July 2024'],
  ['2024/04', 'April 2024'],
  ['2023/12', 'December 2023'],
  ['2023/10', 'October 2023'],
  ['2023/09', 'September 2023'],
  ['2023/07', 'July 2023'],
  ['2023/04', 'April 2023'],
  ['2022/11', 'November 2022'],
  ['2022/10', 'October 2022'],
  ['2022/08', 'August 2022'],
  ['2021/10', 'October 2021'],
  ['2021/09', 'September 2021'],
  ['2021/05', 'May 2021'],
  ['2020/11', 'November 2020'],
  ['2020/10', 'October 2020'],
  ['2020/09', 'September 2020'],
  ['2020/05', 'May 2020'],
  ['2020/04', 'April 2020'],
  ['2018/11', 'November 2018'],
  ['2018/10', 'October 2018'],
  ['2018/09', 'September 2018'],
  ['2018/08', 'August 2018'],
  ['2017/11', 'November 2017'],
  ['2016/10', 'October 2016'],
  ['2015/11', 'November 2015'],
];
const socialLinks = [
  { href: 'https://www.instagram.com/pyconhk/', label: 'Instagram', short: 'ig', className: 'instagram' },
  { href: 'https://www.linkedin.com/company/pyconhk', label: 'LinkedIn', short: 'in', className: 'linkedin' },
  { href: 'https://www.facebook.com/pyconhk', label: 'Facebook', short: 'f', className: 'facebook' },
  { href: 'https://x.com/pyconhk', label: 'Twitter', short: 'x', className: 'twitter' },
  { href: 'https://www.youtube.com/c/pyconhk', label: 'YouTube', short: 'yt', className: 'youtube' },
  { href: 'https://github.com/pyconhk', label: 'GitHub', short: 'gh', className: 'github' },
  { href: '/feed/', label: 'RSS Feed', short: 'rss', className: 'feed' },
];
const historyLinks = [
  { href: '/2024/', label: '2024' },
  { href: '/2023/', label: '2023' },
  { href: '/2022/', label: '2022' },
  { href: '/2021/', label: '2021' },
  { href: '/2020-fall/', label: '2020-fall' },
  { href: '/2020-spring/', label: '2020-spring' },
  { href: '/2018/', label: '2018' },
  { href: 'https://pycon.hk/2017/', label: '2017' },
  { href: 'https://pycon.hk/2016/', label: '2016' },
  { href: 'https://2015.pycon.hk/', label: '2015' },
];
---

<BaseLayout title={title} description={description} htmlLang="en-US">
  <div class="voyago-archive archive date wp-embed-responsive wp-theme-voyago">
    <a id="wp-skip-link" class="skip-link screen-reader-text" href="#wp--skip-link--target">
      Skip to content
    </a>

    <header class="wp-block-template-part voyago-header">
      <div class="voyago-header-inner">
        <a class="voyago-brand-mark" href="/" aria-label="PyCon HK home">
          <img src="/legacy-wp/2024/wp-content/uploads/2024/09/logo_1200px-150x150.gif" alt="" width="60" height="60" />
        </a>
        <a class="voyago-brand" href="https://legacy.pycon.hk">PyCon HK</a>
        <nav class="voyago-nav" aria-label="PyCon HK 2024 navigation">
          {navLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="wp--skip-link--target" class="voyago-main">
      <div class="voyago-grid">
        <section class="voyago-post-column" aria-label={`PyCon HK ${year} posts`}>
          <ul class="wp-block-post-template voyago-post-list">
            {page.items.map((item) => (
              <li class="wp-block-post type-post status-publish format-standard hentry category-24">
                <h3 class="wp-block-post-title">
                  <a href={item.href}>{item.title}</a>
                </h3>
                {item.image && (
                  <figure class="alignwide wp-block-post-featured-image">
                    <a href={item.href}>
                      <img
                        src={item.image.src}
                        alt={item.image.alt}
                        width={item.image.width}
                        height={item.image.height}
                        loading="lazy"
                      />
                    </a>
                  </figure>
                )}
                <div class="wp-block-group is-nowrap voyago-date">
                  <time datetime={item.isoDate}>{item.date}</time>
                </div>
                <div class="wp-block-post-excerpt" set:html={item.excerptHtml} />
                <p class="wp-block-post-excerpt__more-text">
                  <a class="wp-block-post-excerpt__more-link" href={item.href}>
                    Read More &#8599;: {item.title}
                  </a>
                </p>
              </li>
            ))}
          </ul>

          {page.pagination.length > 0 && (
            <nav class="voyago-pagination" aria-label="Archive pagination">
              {page.pagination.map((item) => (
                item.href ? (
                  <a
                    class:list={[
                      'page-numbers',
                      item.rel === 'prev' && 'prev',
                      item.rel === 'next' && 'next',
                    ]}
                    href={item.href}
                    rel={item.rel}
                  >
                    {item.label}
                  </a>
                ) : (
                  <span
                    class:list={['page-numbers', item.current && 'current']}
                    aria-current={item.current ? 'page' : undefined}
                  >
                    {item.label}
                  </span>
                )
              ))}
            </nav>
          )}
        </section>

        <aside class="voyago-sidebar">
          <h4>Follow Us</h4>
          <ul class="voyago-social-links">
            {socialLinks.slice(0, 5).map((link) => (
              <li class={link.className}>
                <a href={link.href} aria-label={link.label}>{link.short}</a>
              </li>
            ))}
          </ul>

          <hr />

          <h4>Search</h4>
          <form method="get" class="voyago-search" action="/">
            <label class="screen-reader-text" for="voyago-search-input">Search</label>
            <input id="voyago-search-input" type="search" name="s" />
            <button type="submit">Search</button>
          </form>

          <hr />

          <h4>Archives</h4>
          <label class="screen-reader-text" for="voyago-archives">Archives</label>
          <select id="voyago-archives" name="archive-dropdown">
            <option value="">Select Month</option>
            {archiveMonths.map(([path, label]) => (
              <option value={`/${path}/`}>{label}</option>
            ))}
          </select>
        </aside>
      </div>
    </main>

    <footer class="voyago-footer">
      <div class="voyago-footer-primary">
        <div class="voyago-footer-inner">
          <div>
            <h4>Follow Us</h4>
            <ul class="voyago-social-links">
              {socialLinks.map((link) => (
                <li class={link.className}>
                  <a href={link.href} aria-label={link.label}>{link.short}</a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h4>History</h4>
            <p>
              {historyLinks.map((link, index) => (
                <>
                  <a href={link.href}>{link.label}</a>
                  {index === 4 && <br />}
                  {index !== historyLinks.length - 1 && '  '}
                </>
              ))}
            </p>
          </div>
        </div>
      </div>
      <div class="voyago-copyright">
        <div class="voyago-footer-inner">&copy;2024 PyCon Hong Kong</div>
      </div>
    </footer>
  </div>

  <script is:inline>
    const archives = document.getElementById('voyago-archives')
    archives?.addEventListener('change', (event) => {
      const target = event.target

      if (target instanceof HTMLSelectElement && target.value) {
        document.location.href = target.value
      }
    })
  </script>
</BaseLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap');

  .voyago-archive,
  .voyago-archive * {
    box-sizing: border-box;
  }

  .voyago-archive {
    min-height: 100vh;
    background: #fff;
    color: #000;
    font-family: Montserrat, sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.7;
  }

  .voyago-archive a {
    color: inherit;
    text-decoration: none;
  }

  .voyago-archive img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .voyago-archive .screen-reader-text {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(1px, 1px, 1px, 1px);
  }

  .voyago-header {
    padding: 24px 40px;
  }

  .voyago-header-inner {
    display: flex;
    width: 1180px;
    max-width: 100%;
    min-height: 60px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin: 0 auto;
  }

  .voyago-brand-mark {
    display: inline-flex;
    width: 60px;
    height: 60px;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .voyago-brand {
    color: #000;
    font-size: 16px;
    font-weight: 600;
    white-space: nowrap;
  }

  .voyago-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 22px;
    margin-left: auto;
    font-size: 16px;
  }

  .voyago-nav a {
    color: #000;
    line-height: 1.7;
  }

  .voyago-main {
    padding: 24px 40px 54px;
  }

  .voyago-grid {
    display: grid;
    grid-template-columns: minmax(0, 694px) minmax(320px, 426px);
    gap: 60px;
    width: 1180px;
    max-width: 100%;
    margin: 0 auto;
    align-items: stretch;
  }

  .voyago-post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .voyago-post-list > li {
    margin: 0;
    padding: 0;
  }

  .voyago-post-list .wp-block-post-title {
    margin: 30px 0;
    color: #000;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.3;
  }

  .voyago-post-list .wp-block-post-featured-image {
    width: 100%;
    margin: 0 0 16px;
  }

  .voyago-post-list .wp-block-post-featured-image img {
    width: 100%;
  }

  .voyago-date {
    display: flex;
    margin: 0;
    color: #000;
    font-size: 16px;
  }

  .voyago-post-list .wp-block-post-excerpt {
    margin: 24px 0;
    color: #000;
    font-size: 16px;
    line-height: 1.7;
  }

  .voyago-post-list .wp-block-post-excerpt p {
    margin: 0;
  }

  .voyago-post-excerpt__more-text,
  .voyago-post-list .wp-block-post-excerpt__more-text {
    margin: 0 0 30px;
    font-size: 16px;
  }

  .voyago-post-excerpt__more-link,
  .voyago-post-list .wp-block-post-excerpt__more-link {
    color: #000;
    font-weight: 400;
    text-decoration: none;
  }

  .voyago-pagination {
    display: flex;
    gap: 10px;
    margin: 36px 0 0;
  }

  .voyago-pagination .page-numbers {
    display: inline-flex;
    min-width: 36px;
    min-height: 36px;
    align-items: center;
    justify-content: center;
    border: 1px solid #ddd;
    color: #000;
    font-size: 14px;
  }

  .voyago-pagination .current {
    background: #002020;
    color: #fff;
  }

  .voyago-sidebar {
    min-height: 100%;
    padding: 36px;
    background: #002020;
    color: #fff;
  }

  .voyago-sidebar h4,
  .voyago-footer h4 {
    margin: 0;
    color: #fff;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.65;
  }

  .voyago-social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .voyago-social-links li {
    display: block;
    width: 36px;
    height: 36px;
    border-radius: 50%;
  }

  .voyago-social-links a {
    display: flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .voyago-social-links .instagram {
    background: #f00075;
  }

  .voyago-social-links .linkedin {
    background: #0d66c2;
  }

  .voyago-social-links .facebook {
    background: #0866ff;
  }

  .voyago-social-links .twitter {
    background: #1da1f2;
  }

  .voyago-social-links .youtube {
    background: #f00;
  }

  .voyago-social-links .github {
    background: #24292d;
  }

  .voyago-social-links .feed {
    background: #f0f0f0;
  }

  .voyago-social-links .feed a {
    color: #444;
  }

  .voyago-sidebar hr {
    height: 1px;
    margin: 24px 0 0;
    border: 0;
    background: rgba(165, 165, 165, 0.44);
  }

  .voyago-search {
    display: flex;
    width: 291px;
    max-width: 100%;
  }

  .voyago-search input {
    width: 179px;
    min-width: 0;
    padding: 8px;
    border: 0;
    background: #fff;
    color: #000;
  }

  .voyago-search button {
    margin-left: 10px;
    padding: 12px 23px;
    border: 0;
    background: #000;
    color: #fff;
    font: inherit;
  }

  .voyago-sidebar select {
    display: inline-block;
    width: auto;
    max-width: 100%;
    background: #fff;
    color: #000;
  }

  .voyago-sidebar h4 + .voyago-search,
  .voyago-sidebar h4 + select {
    margin-top: 24px;
  }

  .voyago-footer {
    color: #fff;
  }

  .voyago-footer-primary {
    padding: 80px 0;
    background: #000;
  }

  .voyago-footer-inner {
    display: flex;
    width: 1180px;
    max-width: calc(100% - 80px);
    justify-content: space-between;
    gap: 60px;
    margin: 0 auto;
  }

  .voyago-archive .voyago-footer p {
    margin: 24px 0 0;
    color: #fff;
  }

  .voyago-footer a {
    color: #fff;
  }

  .voyago-copyright {
    padding: 36px 40px;
    background: #002020;
  }

  .voyago-copyright .voyago-footer-inner {
    display: block;
    max-width: 1180px;
  }

  @media screen and (max-width: 1023px) {
    .voyago-header-inner,
    .voyago-grid,
    .voyago-footer-inner {
      width: auto;
      max-width: 100%;
    }

    .voyago-header-inner,
    .voyago-footer-inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .voyago-nav {
      justify-content: flex-start;
      margin-left: 0;
    }

    .voyago-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media screen and (max-width: 700px) {
    .voyago-header,
    .voyago-main,
    .voyago-copyright {
      padding-right: 20px;
      padding-left: 20px;
    }

    .voyago-post-list .wp-block-post-title {
      font-size: 24px;
    }

    .voyago-sidebar {
      padding: 28px;
    }
  }
</style>
