---
import LegacyShell from '@/legacy/LegacyShell.astro';
import { canonicalLegacyHref, cleanLegacyHtml } from '@/legacy/legacy-html';
import type { LegacyHighlight } from '@/legacy/legacy-indexes';

interface Props {
  page: LegacyHighlight;
}

const { page } = Astro.props;
const event = page.path.match(/^\/([^/]+)/u)?.[1] ?? '2024';
const newsHref = event === '2024' ? '/2024/news/' : '/2025/news/';
const featuredImageSrc = page.featuredImage
  ? canonicalLegacyHref(page.featuredImage.src, { event })
  : undefined;
const contentHtml = cleanLegacyHtml(page.contentHtml, { event });
---

<LegacyShell title={page.title} description={page.description} eyebrow="Conference Highlights" newsHref={newsHref}>
  <article class="mx-auto grid max-w-6xl gap-10 px-5 py-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:px-8 lg:py-14">
    <div class="min-w-0">
      {page.featuredImage && (
        <img
          class="mb-8 aspect-video w-full rounded-lg object-cover"
          src={featuredImageSrc}
          alt={page.featuredImage.alt}
          width={page.featuredImage.width}
          height={page.featuredImage.height}
        />
      )}
      <div class="legacy-content rounded-lg border border-slate-200 bg-white p-5 shadow-sm sm:p-8" set:html={contentHtml} />
    </div>

    <aside class="lg:pt-1">
      <dl class="rounded-lg border border-slate-200 bg-white p-5 text-sm shadow-sm">
        <div>
          <dt class="font-bold text-slate-950">Published</dt>
          <dd class="mt-1 text-slate-600">
            {page.isoDate ? <time datetime={page.isoDate}>{page.date}</time> : page.date}
          </dd>
        </div>
        <div class="mt-5 border-t border-slate-200 pt-5">
          <dt class="font-bold text-slate-950">Archive path</dt>
          <dd class="mt-1 break-all text-slate-600">{page.path}</dd>
        </div>
      </dl>
    </aside>
  </article>
</LegacyShell>
