{
  "name": "pyconhk-public-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "biome check package.json astro.config.mjs tsconfig.json biome.json src",
    "lint:fix": "biome check package.json astro.config.mjs tsconfig.json biome.json src --write",
    "format": "biome format package.json astro.config.mjs tsconfig.json biome.json src --write",
    "format:check": "biome format package.json astro.config.mjs tsconfig.json biome.json src",
    "check": "astro check && bun run lint"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.3.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.0.0",
    "astro": "^7.0.4",
    "gray-matter": "^4.0.3",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "sharp": "^0.34.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/heroicons-outline": "^1.2.1",
    "@iconify-json/mdi": "^1.2.3",
    "astro-icon": "^1.1.5"
  }
}
