{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "functions/**/*", "astro.config.ts"],
  "exclude": ["archived", "dist", "node_modules", "outstatic", "public"]
}
