{
  "name": "pyconhk-website-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "website",
    "cms"
  ],
  "scripts": {
    "install:apps": "mise //website:install && mise //cms:install",
    "dev": "mise //website:dev",
    "e2e": "mise //website:e2e",
    "build": "mise //...:build",
    "preview": "mise //website:preview",
    "check": "mise //...:check",
    "ci": "mise //:ci",
    "lint": "mise //...:lint",
    "lint:fix": "mise //website:lint-fix && mise //cms:format",
    "format": "mise //...:format",
    "website:dev": "mise //website:dev",
    "website:build": "mise //website:build",
    "website:preview": "mise //website:preview",
    "website:check": "mise //website:check",
    "website:e2e": "mise //website:e2e",
    "website:lint": "mise //website:lint",
    "website:lint:fix": "mise //website:lint-fix",
    "website:format": "mise //website:format",
    "cms:dev": "mise //cms:dev",
    "cms:build": "mise //cms:build",
    "cms:preview": "mise //cms:preview",
    "cms:check": "mise //cms:check",
    "cms:lint": "mise //cms:lint",
    "cms:format": "mise //cms:format",
    "cms:local-backend": "mise //cms:local-backend"
  }
}
