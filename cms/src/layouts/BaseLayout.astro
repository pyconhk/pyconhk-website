---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const {
  title,
  description = "Standalone PyCon HK CMS powered by Astro and Decap.",
  robots = "index,follow",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <slot name="afterBody" />
  </body>
</html>
