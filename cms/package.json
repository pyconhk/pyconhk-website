{
  "name": "pyconhk-website-cms",
  "private": true,
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && bun run test",
    "cms:local-backend": "decap-server",
    "lint": "biome check src package.json tsconfig.json astro.config.mjs biome.json vercel.json mise.toml",
    "format": "biome format --write src package.json tsconfig.json astro.config.mjs biome.json vercel.json mise.toml",
    "test": "bun test src/**/*.test.ts"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.4",
    "decap-cms-app": "^3.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.2",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^24.0.0",
    "decap-server": "^3.5.2",
    "typescript": "^5.8.3"
  }
}
