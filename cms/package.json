{
  "name": "pyconhk-website-cms",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "node ../.github/deploy/cms.ts",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run",
    "types": "wrangler types worker-configuration.d.ts",
    "check": "astro check",
    "lint": "biome check src package.json tsconfig.json astro.config.ts biome.json wrangler.jsonc mise.toml e2e playwright.config.ts",
    "format": "biome format --write src package.json tsconfig.json astro.config.ts biome.json wrangler.jsonc mise.toml e2e playwright.config.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.3",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.4",
    "decap-cms-app": "^3.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.2",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.112.0",
    "@playwright/test": "^1.61.1"
  }
}
