# Required for GitHub OAuth
CMS_GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_APP_CLIENT_ID
CMS_GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_APP_CLIENT_SECRET

# Required for the target content repository Decap will edit
CMS_GITHUB_REPO=pyconhk/pyconhk-website

# Optional
CMS_GITHUB_BRANCH=cms
CMS_GITHUB_OAUTH_SCOPE=repo
CMS_ACCESS_REPO=pyconhk/pyconhk-website
CMS_CONTENT_ROOT=website/outstatic/content
CMS_MEDIA_FOLDER=website/public/outstatic/images
CMS_PUBLIC_FOLDER=/outstatic/images
CMS_LOCALES=en,zh-hk,zh-hant,zh-hans,ja
CMS_DEFAULT_LOCALE=en

# Recommended for stable callback URLs on Vercel
CMS_PUBLIC_URL=http://localhost:4322
